@model LoginViewModel
@using static ASI.Basecode.Resources.Views.Screen
@section styles {
    <link rel="stylesheet" href="~/css/login.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
}
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "AlliEats - Login";
}
<div>
    @Html.AntiForgeryToken()
</div>
<div class="auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">
                <div class="card auth-card text-black">
                    <div class="row g-0">
                        <div class="col-lg-6">
                            <div class="auth-card-body">
                                <div class="text-center mb-4">
                                    <img src="~/img/allieats-logo.png"
                                         class="auth-logo"
                                         style="width: 220px; max-width: 100%;" 
                                         alt="AlliEats Logo">
                                    <h2 class="auth-title">Welcome Back</h2>
                                    <p class="auth-subtitle">Sign in to your account to start ordering delicious food</p>
                                </div>
                                <form method="post" action="/Account/Login" id="loginForm">
                                    <div class="form-group mb-4">
                                        <label class="form-label" for="form2Example11">Email Address</label>
                                        <input type="email" id="form2Example11" class="form-control"
                                               asp-for="UserId" placeholder="Enter your email address" />
                                        <span asp-validation-for="UserId" class="text-danger"></span>
                                    </div>
                                    <div class="form-group mb-4">
                                        <label class="form-label" for="form2Example22">Password</label>
                                        <input type="password" id="form2Example22" class="form-control"
                                               asp-for="Password" placeholder="Enter your password" />
                                        <span asp-validation-for="Password" class="text-danger"></span>
                                    </div>
                                    <div class="text-center pt-3 mb-4">
                                        <button class="btn btn-primary login-btn gradient-custom-2 mb-3" type="submit">
                                            Sign In
                                        </button>
                                        <div class="mb-3">
                                            <a asp-controller="Account" asp-action="ForgotPassword" class="auth-link">Forgot your password?</a>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-center pb-4">
                                        <p class="mb-0 me-2 mr-2" style="color: var(--text-charcoal);">Don't have an account?</p>
                                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Create Account</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="col-lg-6 auth-image-side">
                            <div class="auth-brand-content">
                                <div class="icon-circle">
                                    <span style="font-size: 56px;">🍽️</span>
                                </div>
                                <h1 class="auth-brand-text">AlliEats</h1>
                                <p class="auth-tagline">Order. Enjoy. Repeat.</p>
                                <div style="margin-top: 3rem; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 2rem; max-width: 300px; margin-left: auto; margin-right: auto;">
                                    <p style="font-size: 0.9rem; opacity: 0.85;">
                                        Your favorite food, delivered to your door.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Check for error message and display Toastr notification
        var errorMessage = '@TempData["ErrorMessage"]';
        if (errorMessage && errorMessage.trim() !== '') {
            toastr.error(errorMessage);
        }
        
        // Check for success message and display Toastr notification
        var successMessage = '@TempData["SuccessMessage"]';
        if (successMessage && successMessage.trim() !== '') {
            toastr.success(successMessage);
        }
    </script>
}