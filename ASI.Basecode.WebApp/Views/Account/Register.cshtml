@using ASI.Basecode.Services.ServiceModels
@model UserViewModel
@using static ASI.Basecode.Resources.Views.Screen
@section styles {
    <link rel="stylesheet" href="~/css/login.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
}
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "AlliEats - Register";
}
<div>
    @Html.AntiForgeryToken()
</div>
<div class="auth-container">
    <div class="container-fluid px-0">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-10">
                <div class="card auth-card">
                    <div class="row g-0">

                        <div class="col-lg-6">
                            <div class="auth-card-body">
                                <div class="mb-5">
                                    <img src="~/img/allieats-logo.png" alt="AlliEats" style="height: 40px; margin-bottom: 20px;">
                                    <h2 class="auth-title">Create Account</h2>
                                    <p class="auth-subtitle">Start your culinary journey with AlliEats today.</p>
                                </div>

                                <form method="post" action="/Account/Register" id="registerForm">

                                    <div class="form-group">
                                        <label class="form-label" for="userid">Email Address</label>
                                        <input type="email" id="userid" class="form-control"
                                               asp-for="UserId" placeholder="name@example.com" />
                                        <span asp-validation-for="UserId" class="text-danger"></span>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label" for="name">Full Name</label>
                                        <input type="text" id="name" class="form-control"
                                               asp-for="Name" placeholder="e.g. Juan dela Cruz" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>

                                    <div style="margin-top: 2rem; margin-bottom: 1rem;"></div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label" for="password">Password</label>
                                                <input type="password" id="password" class="form-control"
                                                       asp-for="Password" placeholder="••••••••" />
                                                <span asp-validation-for="Password" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label" for="confirmpassword">Confirm</label>
                                                <input type="password" id="confirmpassword" class="form-control"
                                                       asp-for="ConfirmPassword" placeholder="••••••••" />
                                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <button class="btn btn-primary login-btn gradient-custom-2" type="submit">
                                            Sign Up Now
                                        </button>
                                    </div>

                                    <div class="text-center mt-4">
                                        <a asp-controller="Account" asp-action="Login" class="back-link">
                                            Already have an account? <span style="color: var(--primary-maroon); font-weight: 700; margin-left: 5px;">Log In</span>
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="col-lg-6 auth-image-side">
                            <div class="auth-brand-content">
                                <div class="icon-circle">
                                    <span style="font-size: 56px;">🛵</span>
                                </div>
                                <h1 class="auth-brand-text">AlliEats</h1>
                                <p class="auth-tagline">Delivering happiness, one meal at a time.</p>

                                <div style="margin-top: 3rem; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 2rem; max-width: 320px; margin-left: auto; margin-right: auto;">
                                    <p style="font-size: 0.95rem; opacity: 0.85; line-height: 1.6;">
                                        Join us and enjoy tasty and so decilious food from AlliEats.
                                    </p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Existing script logic maintained
        var errorMessage = '@TempData["ErrorMessage"]';
        if (errorMessage && errorMessage.trim() !== '') {
            toastr.error(errorMessage);
        }

        $('#registerForm').on('submit', function(e) {
            var password = $('#password').val();
            var confirmPassword = $('#confirmpassword').val();

            if (password !== confirmPassword) {
                e.preventDefault();
                toastr.error('Password and Confirm Password must match.');
                return false;
            }
        });
    </script>
}