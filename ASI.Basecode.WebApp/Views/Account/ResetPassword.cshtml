@model ASI.Basecode.Services.ServiceModels.ResetPasswordViewModel
@section styles {
    <link rel="stylesheet" href="~/css/login.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
}
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "AlliEats - Reset Password";
}
<div>
    @Html.AntiForgeryToken()
</div>
<div class="auth-container">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="card auth-card text-black">
                    <div class="row g-0">
                        <div class="col-lg-6">
                            <div class="auth-card-body">
                                <div class="text-center mb-4">
                                    <img src="~/img/allieats-logo.png"
                                         class="auth-logo"
                                         style="width: 200px; max-width: 100%;"
                                         alt="AlliEats Logo">
                                    <h2 class="auth-title">Reset Password</h2>
                                    <p class="auth-subtitle">Enter the verification code sent to <strong>@Model.Email</strong> and your new password</p>
                                </div>
                                <form method="post" action="/Account/ResetPassword" id="resetPasswordForm">
                                    <input type="hidden" asp-for="Email" />
                                    <div class="form-group mb-3">
                                        <label class="form-label" for="otp">Verification Code</label>
                                        <input type="text" id="otp" class="form-control text-center"
                                               asp-for="Otp" placeholder="Enter 6-digit code"
                                               maxlength="6" style="font-size: 1.2rem; letter-spacing: 0.3rem;" />
                                        <span asp-validation-for="Otp" class="text-danger"></span>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="form-label" for="newPassword">New Password</label>
                                        <input type="password" id="newPassword" class="form-control"
                                               asp-for="NewPassword" placeholder="Enter your new password" />
                                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                                    </div>
                                    <div class="form-group mb-4">
                                        <label class="form-label" for="confirmNewPassword">Confirm New Password</label>
                                        <input type="password" id="confirmNewPassword" class="form-control"
                                               asp-for="ConfirmNewPassword" placeholder="Confirm your new password" />
                                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                                    </div>
                                    <div class="text-center pt-2 mb-4">
                                        <button class="btn btn-primary login-btn gradient-custom-2 mb-3" type="submit">
                                            Reset Password
                                        </button>
                                        <div class="mb-3">
                                            <button type="button" id="resendBtn" class="btn btn-link text-decoration-none">
                                                Didn't receive the code? Resend Code
                                            </button>
                                        </div>
                                        <div>
                                            <a asp-controller="Account" asp-action="ForgotPassword" class="back-link">
                                                ← Use Different Email
                                            </a>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="col-lg-6 auth-image-side">
                            <div class="text-center">
                                <h1 class="auth-brand-text">Almost Done!</h1>
                                <p class="auth-tagline">Create your new secure password</p>
                                <div class="mt-4">
                                    <div style="font-size: 64px; color: #FFD54F; opacity: 0.8;">🔑</div>
                                </div>
                                <div class="mt-4" style="color: #FFF3E0; font-size: 14px; opacity: 0.9; max-width: 280px; margin: 2rem auto;">
                                    Enter the verification code from your email and create a new secure password for your account.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        var errorMessage = '@TempData["ErrorMessage"]';
        if (errorMessage && errorMessage.trim() !== '') {
            toastr.error(errorMessage);
        }

        var successMessage = '@TempData["SuccessMessage"]';
        if (successMessage && successMessage.trim() !== '') {
            toastr.success(successMessage);
        }

        $('#otp').focus();

        $('#otp').on('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        $('#resetPasswordForm').on('submit', function(e) {
            var password = $('#newPassword').val();
            var confirmPassword = $('#confirmNewPassword').val();

            if (password !== confirmPassword) {
                e.preventDefault();
                toastr.error('New password and confirm password must match.');
                return false;
            }
        });

        $('#resendBtn').on('click', function() {
            var email = '@Model.Email';
            var button = $(this);

            button.prop('disabled', true).text('Sending...');

            $.ajax({
                url: '/Account/ResendPasswordResetOtp',
                type: 'POST',
                data: { email: email },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        toastr.success(response.message);
                        var countdown = 60;
                        var timer = setInterval(function() {
                            button.text('Resend Code in ' + countdown + 's');
                            countdown--;
                            if (countdown < 0) {
                                clearInterval(timer);
                                button.prop('disabled', false).text("Didn't receive the code? Resend Code");
                            }
                        }, 1000);
                    } else {
                        toastr.error(response.message);
                        button.prop('disabled', false).text("Didn't receive the code? Resend Code");
                    }
                },
                error: function() {
                    toastr.error('Failed to resend verification code. Please try again.');
                    button.prop('disabled', false).text("Didn't receive the code? Resend Code");
                }
            });
        });
    </script>
}