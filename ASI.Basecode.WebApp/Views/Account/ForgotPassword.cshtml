@model ASI.Basecode.Services.ServiceModels.ForgotPasswordViewModel
@section styles {
    <link rel="stylesheet" href="~/css/login.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
}
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "AlliEats - Forgot Password";
}
<div>
    @Html.AntiForgeryToken()
</div>
<div class="auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">
                <div class="card auth-card text-black">
                    <div class="row g-0">
                        <div class="col-lg-6">
                            <div class="auth-card-body">
                                <div class="text-center mb-4">
                                    <img src="~/img/allieats-logo.png"
                                         class="auth-logo"
                                         style="width: 200px; max-width: 100%;"
                                         alt="AlliEats Logo">
                                    <h2 class="auth-title">Forgot Password</h2>
                                    <p class="auth-subtitle">Enter your email address and we'll send you a verification code to reset your password</p>
                                </div>
                                <form method="post" action="/Account/ForgotPassword" id="forgotPasswordForm">
                                    <div class="form-group mb-4">
                                        <label class="form-label" for="email">Email Address</label>
                                        <input type="email" id="email" class="form-control"
                                               asp-for="Email" placeholder="Enter your email address" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                    <div class="text-center pt-2 mb-4">
                                        <button class="btn btn-primary login-btn gradient-custom-2 mb-3" type="submit">
                                            Send Reset Code
                                        </button>
                                        <div>
                                            <a asp-controller="Account" asp-action="Login" class="back-link">
                                                ← Back to Login
                                            </a>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="col-lg-6 auth-image-side">
                            <div class="text-center">
                                <h1 class="auth-brand-text">Reset Your Password</h1>
                                <p class="auth-tagline">Get back to enjoying your favorite food</p>
                                <div class="mt-4">
                                    <div style="font-size: 64px; color: #FFD54F; opacity: 0.8;">🔐</div>
                                </div>
                                <div class="mt-4" style="color: #FFF3E0; font-size: 14px; opacity: 0.9; max-width: 280px; margin: 2rem auto;">
                                    Enter your email address and we'll send you a secure verification code to reset your password.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        // Check for error message and display Toastr notification
        var errorMessage = '@TempData["ErrorMessage"]';
        if (errorMessage && errorMessage.trim() !== '') {
            toastr.error(errorMessage);
        }

        // Check for success message and display Toastr notification
        var successMessage = '@TempData["SuccessMessage"]';
        if (successMessage && successMessage.trim() !== '') {
            toastr.success(successMessage);
        }

        // Auto-focus email input
        $('#email').focus();
    </script>
}