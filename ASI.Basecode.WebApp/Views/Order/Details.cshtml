@model ASI.Basecode.Services.ServiceModels.OrderViewModel

@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="order-header text-center">
        <h1 class="display-5 fw-bold"><i class="fas fa-receipt me-3"></i>Order Details</h1>
        <p class="lead">Complete information about order @Model.OrderNumber</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Order Information & Items -->
        <div class="col-lg-8">
            <!-- Order Information Card -->
            <div class="card shadow-sm order-info-card mb-4">
                <div class="card-body">
                    <h4 class="card-title text-center mb-4">
                        <i class="fas fa-info-circle me-2"></i>Order Information
                        <span class="badge @Model.StatusBadgeClass ms-2">@Model.Status</span>
                    </h4>

                    <div class="order-info-grid">
                        <div class="order-info-item">
                            <span class="order-info-label">Order Number:</span>
                            <span class="order-info-value">@Model.OrderNumber</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">Order Date:</span>
                            <span class="order-info-value">@Model.CreatedTime.ToString("MMMM dd, yyyy h:mm tt")</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">Payment Method:</span>
                            <span class="order-info-value">@Model.PaymentMethod</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">Total Amount:</span>
                            <span class="order-info-value text-success fw-bold">@("P" + Model.TotalAmount.ToString("F2"))</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="order-info-item full-width">
                                <span class="order-info-label">Order Notes:</span>
                                <div class="order-notes">@Model.Notes</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Order Items Card -->
            <div class="card shadow-sm order-items-card">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="fas fa-list me-2"></i>Ordered Items (@Model.TotalItems items)
                    </h5>

                    <div>
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="order-item-card mb-3">
                                <div class="order-item-image">
                                    @if (!string.IsNullOrEmpty(item.MenuItemImagePath))
                                    {
                                        <img src="@item.MenuItemImagePath" alt="@item.MenuItemName"
                                             onerror="this.src='/images/placeholder-food.jpg'; this.onerror=null;">
                                    }
                                    else
                                    {
                                        <div class="placeholder-icon">
                                            <i class="fas fa-utensils"></i>
                                        </div>
                                    }
                                </div>
                                <div class="order-item-details">
                                    <h6 class="mb-1">@item.MenuItemName</h6>
                                </div>
                                <div class="text-center px-3" style="min-width: 100px;">
                                    <span class="item-price">@("P" + item.Price.ToString("F2"))</span>
                                </div>
                                <div class="text-center px-3" style="min-width: 80px;">
                                    <span class="quantity-badge">x @item.Quantity</span>
                                </div>
                                <div class="text-center px-3" style="min-width: 120px;">
                                    <span class="item-total">@("P" + item.TotalPrice.ToString("F2"))</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="order-summary-footer">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="mb-0">Total Items: @Model.TotalItems</h6>
                            </div>
                            <div class="col-md-4 text-end">
                                <h5 class="text-success mb-0">Total: @("P" + Model.TotalAmount.ToString("F2"))</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Status & Actions -->
        <div class="col-lg-4">
            <div class="sticky-sidebar">
                <div class="card shadow-sm order-status-card mb-4">
                    <div class="card-body">
                        <h5 class="card-title text-center mb-4">
                            <i class="fas fa-truck me-2"></i>Order Status
                        </h5>

                        <p class="text-center text-muted mb-4 small">Track your delicious meal in real-time.</p>

                        <!-- Status Timeline -->
                        <div class="status-timeline">
                            @{
                                var statusOrder = new[] { "Pending", "Confirmed", "Preparing", "Ready", "On the Way", "Received" };
                                var currentStatusIndex = Array.IndexOf(statusOrder, Model.Status);
                                var isCancelled = Model.Status == "Cancelled";
                            }

                            @for (int i = 0; i < statusOrder.Length; i++)
                            {
                                var status = statusOrder[i];
                                var isCompleted = !isCancelled && i <= currentStatusIndex;
                                var isActive = !isCancelled && i == currentStatusIndex;
                                var isCancelledAtThisStep = isCancelled && i <= currentStatusIndex;

                                <div class="timeline-step @(isCompleted ? "completed" : "") @(isActive ? "active" : "") @(isCancelledAtThisStep ? "cancelled" : "")">
                                    <div class="timeline-icon">
                                        @if (isCancelled && i <= currentStatusIndex)
                                        {
                                            <i class="fas fa-times"></i>
                                        }
                                        else if (isCompleted && !isActive)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                        else
                                        {
                                            switch (status)
                                            {
                                                case "Pending":
                                                    <i class="fas fa-hourglass-start"></i>
                                                    break;
                                                case "Confirmed":
                                                    <i class="fas fa-check-circle"></i>
                                                    break;
                                                case "Preparing":
                                                    <i class="fas fa-utensils"></i>
                                                    break;
                                                case "Ready":
                                                    <i class="fas fa-box"></i>
                                                    break;
                                                case "On the Way":
                                                    <i class="fas fa-shipping-fast"></i>
                                                    break;
                                                case "Received":
                                                    <i class="fas fa-smile"></i>
                                                    break;
                                            }
                                        }
                                    </div>
                                    <div class="timeline-content">
                                        <h6 class="timeline-title">
                                            @if (status == "On the Way")
                                            {
                                                <text>Delivery</text>
                                            }
                                            else
                                            {
                                                @status
                                            }
                                        </h6>
                                        <p class="timeline-description">
                                            @switch (status)
                                            {
                                                case "Pending":
                                                    <text>Your order has been placed and is awaiting confirmation from the restaurant.</text>
                                                    break;
                                                case "Confirmed":
                                                    <text>Order confirmed! The restaurant has received your order.</text>
                                                    break;
                                                case "Preparing":
                                                    <text>Our chefs are now preparing your delicious meal.</text>
                                                    break;
                                                case "Ready":
                                                    <text>Your order is ready. Come get it or wait for the delivery person!</text>
                                                    break;
                                                case "On the Way":
                                                    <text>Your order is on the way to your location.</text>
                                                    break;
                                                case "Received":
                                                    <text>Enjoy your meal! We hope you love it.</text>
                                                    break;
                                            }
                                        </p>
                                    </div>
                                    @if (i < statusOrder.Length - 1)
                                    {
                                        <div class="timeline-line @(isCompleted && i < currentStatusIndex ? "completed" : "") @(isCancelledAtThisStep && i < currentStatusIndex ? "cancelled" : "")"></div>
                                    }
                                </div>
                            }

                            @if (isCancelled)
                            {
                                <div class="timeline-step cancelled active">
                                    <div class="timeline-icon">
                                        <i class="fas fa-ban"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <h6 class="timeline-title">Cancelled</h6>
                                        <p class="timeline-description">This order has been cancelled.</p>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Confirm Receipt Button for "On the Way" status -->
                        @if (Model.Status == "On the Way")
                        {
                            <div class="mt-4">
                                <button type="button" class="btn btn-success btn-lg w-100 confirm-receipt-btn"
                                        data-order-id="@Model.Id"
                                        data-order-number="@Model.OrderNumber">
                                    <i class="fas fa-check-circle me-2"></i>Confirm Receipt
                                </button>
                            </div>
                        }

                        <!-- Cancel Order Button for "Pending" status -->
                        @if (Model.Status == "Pending")
                        {
                            <div class="mt-4">
                                <button type="button" class="btn btn-danger btn-lg w-100 cancel-order-btn"
                                        data-order-id="@Model.Id"
                                        data-order-number="@Model.OrderNumber">
                                    <i class="fas fa-times-circle me-2"></i>Cancel Order
                                </button>
                                <small class="text-muted d-block text-center mt-2">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Orders can only be cancelled while pending
                                </small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Action Buttons Card -->
                <div class="card shadow-sm action-buttons-card">
                    <div class="card-body">
                        <div class="d-grid gap-3">
                            <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-primary">
                                <i class="fas fa-history me-2"></i>Back to Order History
                            </a>

                            <!-- Review Button - Only show for delivered orders -->
                            @if (Model.Status == "Received")
                            {
                                <a href="@Url.Action("Create", "Review", new { orderId = Model.Id })" class="btn btn-warning">
                                    <i class="fas fa-star me-2"></i>Leave a Review
                                </a>
                            }

                            <a href="@Url.Action("Browse", "Menu")" class="btn btn-checkout">
                                <i class="fas fa-utensils me-2"></i>Order More Food
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Receipt Modal -->
<div class="modal fade" id="confirmReceiptModal" tabindex="-1" aria-labelledby="confirmReceiptModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="confirmReceiptModalLabel">
                    <i class="fas fa-check-circle me-2"></i>Confirm Order Receipt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-box-open fa-3x text-success mb-3"></i>
                    <h6>Have you received your order?</h6>
                    <p class="text-muted">Order Number: <span id="modalOrderNumber"></span></p>
                    <p class="small text-muted">By confirming receipt, you acknowledge that you have received your order in good condition.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Not Yet
                </button>
                <button type="button" class="btn btn-success" id="confirmReceiptSubmit">
                    <i class="fas fa-check me-2"></i>Yes, I Received It
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Order Modal -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="cancelOrderModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Cancel Order
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-times-circle fa-3x text-danger mb-3"></i>
                    <h6>Are you sure you want to cancel this order?</h6>
                    <p class="text-muted">Order Number: <span id="cancelModalOrderNumber"></span></p>
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <strong>Warning:</strong> This action cannot be undone. Once cancelled, you'll need to place a new order.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-arrow-left me-2"></i>Keep Order
                </button>
                <button type="button" class="btn btn-danger" id="cancelOrderSubmit">
                    <i class="fas fa-times me-2"></i>Yes, Cancel Order
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/order-details.js"></script>
    @Html.AntiForgeryToken()
}

@section Styles {
    <link rel="stylesheet" href="~/css/order-details.css" />
}