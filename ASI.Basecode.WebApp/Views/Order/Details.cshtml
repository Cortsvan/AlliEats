@model ASI.Basecode.Services.ServiceModels.OrderViewModel

@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="order-header text-center">
        <h1 class="display-5 fw-bold"><i class="fas fa-receipt me-3"></i>Order Details</h1>
        <p class="lead">Complete information about order @Model.OrderNumber</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Order Information & Items -->
        <div class="col-lg-8">
            <!-- Order Information Card -->
            <div class="card shadow-sm order-info-card mb-4">
                <div class="card-body">
                    <h4 class="card-title text-center mb-4">
                        <i class="fas fa-info-circle me-2"></i>Order Information
                        <span class="badge @Model.StatusBadgeClass ms-2">@Model.Status</span>
                    </h4>

                    <div class="order-info-grid">
                        <div class="order-info-item">
                            <span class="order-info-label">Order Number:</span>
                            <span class="order-info-value">@Model.OrderNumber</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">Order Date:</span>
                            <span class="order-info-value">@Model.CreatedTime.ToString("MMMM dd, yyyy h:mm tt")</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">Payment Method:</span>
                            <span class="order-info-value">@Model.PaymentMethod</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">Total Amount:</span>
                            <span class="order-info-value text-success fw-bold">@("P" + Model.TotalAmount.ToString("F2"))</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="order-info-item full-width">
                                <span class="order-info-label">Order Notes:</span>
                                <div class="order-notes">@Model.Notes</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Order Items Card -->
            <div class="card shadow-sm order-items-card">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="fas fa-list me-2"></i>Ordered Items (@Model.TotalItems items)
                    </h5>

                    <div>
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="order-item-card mb-3">
                                <div class="order-item-image">
                                    @if (!string.IsNullOrEmpty(item.MenuItemImagePath))
                                    {
                                        <img src="@item.MenuItemImagePath" alt="@item.MenuItemName"
                                             onerror="this.src='/images/placeholder-food.jpg'; this.onerror=null;">
                                    }
                                    else
                                    {
                                        <div class="placeholder-icon">
                                            <i class="fas fa-utensils"></i>
                                        </div>
                                    }
                                </div>
                                <div class="order-item-details">
                                    <h6 class="mb-1">@item.MenuItemName</h6>
                                </div>
                                <div class="text-center px-3" style="min-width: 100px;">
                                    <span class="item-price">@("P" + item.Price.ToString("F2"))</span>
                                </div>
                                <div class="text-center px-3" style="min-width: 80px;">
                                    <span class="quantity-badge">x @item.Quantity</span>
                                </div>
                                <div class="text-center px-3" style="min-width: 120px;">
                                    <span class="item-total">@("P" + item.TotalPrice.ToString("F2"))</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="order-summary-footer">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="mb-0">Total Items: @Model.TotalItems</h6>
                            </div>
                            <div class="col-md-4 text-end">
                                <h5 class="text-success mb-0">Total: @("P" + Model.TotalAmount.ToString("F2"))</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Status & Actions -->
        <div class="col-lg-4">
            <div class="card shadow-sm order-status-card mb-4">
                <div class="card-body text-center">
                    <h5 class="card-title mb-4">
                        <i class="fas fa-truck me-2"></i>Order Status
                    </h5>

                    <div class="status-icon mb-3">
                        <i class="fas fa-circle-check fa-3x @(Model.Status == "Delivered" ? "text-success" : "text-muted")"></i>
                    </div>

                    <h4 class="mb-3">
                        <span class="badge @Model.StatusBadgeClass status-badge">@Model.Status</span>
                    </h4>

                    <!-- Status Progress -->
                    <div class="progress mb-3 status-progress">
                        @{
                            var progressWidth = Model.Status switch
                            {
                                "Pending" => "20%",
                                "Confirmed" => "40%",
                                "Preparing" => "60%",
                                "Ready" => "80%",
                                "Delivered" => "100%",
                                "Cancelled" => "100%",
                                _ => "0%"
                            };
                            var progressColor = Model.Status == "Cancelled" ? "bg-danger" : "bg-success";
                        }
                        <div class="progress-bar @progressColor" style="width: @progressWidth"></div>
                    </div>

                    <div class="status-message">
                        @if (Model.Status == "Ready")
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-bell me-2"></i>Your order is ready for pickup!
                            </div>
                        }
                        else if (Model.Status == "Preparing")
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-clock me-2"></i>Your order is being prepared
                            </div>
                        }
                        else if (Model.Status == "Delivered")
                        {
                            <div class="alert alert-success">
                                <i class="fas fa-check me-2"></i>Order delivered successfully!
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Action Buttons Card -->
            <div class="card shadow-sm action-buttons-card">
                <div class="card-body">
                    <div class="d-grid gap-3">
                        <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-primary">
                            <i class="fas fa-history me-2"></i>Back to Order History
                        </a>
                        <a href="@Url.Action("Browse", "Menu")" class="btn btn-checkout">
                            <i class="fas fa-utensils me-2"></i>Order More Food
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/order-details.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/order-details.css" />
}