@model ASI.Basecode.Services.ServiceModels.OrderViewModel

@{
    ViewData["Title"] = "Track Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-warning border-0 shadow-sm">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <i class="fas fa-search fa-2x text-warning"></i>
                    </div>
                    <div>
                        <h4 class="alert-heading mb-1">Track Your Order</h4>
                        <p class="mb-0">Enter your order number to check the current status</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Track Order Form -->
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-search me-2"></i>Enter Order Details
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
                        </div>
                    }

                    <form method="post" action="@Url.Action("TrackOrder", "Order")">
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-md-8">
                                <label for="orderNumber" class="form-label">Order Number</label>
                                <input type="text" name="orderNumber" id="orderNumber"
                                       class="form-control form-control-lg"
                                       placeholder="Enter your order number (e.g., ORD-20241022-12345)"
                                       value="@(Model?.OrderNumber ?? "")"
                                       required>
                                <div class="form-text">
                                    <i class="fas fa-info-circle me-1"></i>
                                    You can find your order number in your confirmation email or receipt
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    <i class="fas fa-search me-2"></i>Track Order
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model != null)
            {
                <!-- Order Status Results -->
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-truck me-2"></i>Order Status - @Model.OrderNumber
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <!-- Order Basic Info -->
                                <div class="mb-3">
                                    <strong>Order Date:</strong> @Model.CreatedTime.ToString("MMMM dd, yyyy h:mm tt")
                                </div>
                                <div class="mb-3">
                                    <strong>Total Amount:</strong> <span class="text-success fw-bold">$@Model.TotalAmount.ToString("F2")</span>
                                </div>
                                <div class="mb-3">
                                    <strong>Payment Method:</strong> @Model.PaymentMethod
                                </div>
                                <div class="mb-3">
                                    <strong>Total Items:</strong> <span class="badge bg-info">@Model.TotalItems items</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <!-- Status Display -->
                                <div class="text-center">
                                    <div class="mb-3">
                                        @{
                                            var statusIcon = Model.Status switch
                                            {
                                                "Pending" => "fas fa-clock text-warning",
                                                "Confirmed" => "fas fa-check-circle text-info",
                                                "Preparing" => "fas fa-utensils text-primary",
                                                "Ready" => "fas fa-bell text-warning",
                                                "Delivered" => "fas fa-check-circle text-success",
                                                "Cancelled" => "fas fa-times-circle text-danger",
                                                _ => "fas fa-question-circle text-muted"
                                            };
                                        }
                                        <i class="@statusIcon fa-4x"></i>
                                    </div>
                                    <h4>
                                        <span class="badge @Model.StatusBadgeClass fs-6">@Model.Status</span>
                                    </h4>

                                    <!-- Status Message -->
                                    @{
                                        var statusMessage = Model.Status switch
                                        {
                                            "Pending" => "Your order has been received and is being reviewed.",
                                            "Confirmed" => "Your order has been confirmed and will start preparation soon.",
                                            "Preparing" => "Your order is currently being prepared by our kitchen staff.",
                                            "Ready" => "Your order is ready for pickup or delivery!",
                                            "Delivered" => "Your order has been successfully delivered. Enjoy your meal!",
                                            "Cancelled" => "Your order has been cancelled.",
                                            _ => "Status information is not available."
                                        };
                                    }
                                    <p class="text-muted mt-3">@statusMessage</p>
                                </div>

                                <!-- Progress Bar -->
                                <div class="progress mt-3" style="height: 12px;">
                                    @{
                                        var progressWidth = Model.Status switch
                                        {
                                            "Pending" => "20%",
                                            "Confirmed" => "40%",
                                            "Preparing" => "60%",
                                            "Ready" => "80%",
                                            "Delivered" => "100%",
                                            "Cancelled" => "100%",
                                            _ => "0%"
                                        };
                                        var progressColor = Model.Status == "Cancelled" ? "bg-danger" : "bg-success";
                                    }
                                    <div class="progress-bar @progressColor progress-bar-striped progress-bar-animated"
                                         style="width: @progressWidth">
                                    </div>
                                </div>

                                <!-- Status Steps -->
                                <div class="mt-3">
                                    <small class="text-muted">
                                        <div class="row text-center">
                                            <div class="col">Pending</div>
                                            <div class="col">Confirmed</div>
                                            <div class="col">Preparing</div>
                                            <div class="col">Ready</div>
                                            <div class="col">Delivered</div>
                                        </div>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Order Items Summary -->
                        <hr class="my-4">
                        <h6><i class="fas fa-list me-2"></i>Order Items:</h6>
                        <div class="row">
                            @foreach (var item in Model.OrderItems)
                            {
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex justify-content-between">
                                        <span>@item.MenuItemName</span>
                                        <span class="text-muted">@item.Quantity x $@item.Price.ToString("F2")</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Action Buttons -->
                        <div class="text-center mt-4">
                            <a href="@Url.Action("Details", "Order", new { id = Model.Id })" class="btn btn-outline-primary me-2">
                                <i class="fas fa-eye me-2"></i>View Full Details
                            </a>
                            <a href="@Url.Action("Browse", "Menu")" class="btn btn-success">
                                <i class="fas fa-utensils me-2"></i>Order More Food
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-focus on order number input
            $('#orderNumber').focus();

            // Format order number input (uppercase, remove spaces)
            $('#orderNumber').on('input', function() {
                let value = $(this).val().toUpperCase().replace(/\s/g, '');
                $(this).val(value);
            });
        });
    </script>
}