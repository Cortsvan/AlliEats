@model IEnumerable<ASI.Basecode.Services.ServiceModels.OrderViewModel>

@{
    ViewData["Title"] = "My Orders & Tracking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="orders-page-container">
    <!-- Modern Header Section -->
    <div class="orders-hero-header">
        <div class="hero-content-wrapper">
            <div class="hero-icon-circle">
                <i class="fas fa-receipt"></i>
            </div>
            <div class="hero-text">
                <h1 class="hero-title">My Orders & Tracking</h1>
                <p class="hero-subtitle">Track your orders in real-time and view your complete order history</p>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show modern-alert success-alert" role="alert">
            <div class="alert-icon-wrapper">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="alert-content">
                <strong>Success!</strong>
                <p>@TempData["SuccessMessage"]</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show modern-alert danger-alert" role="alert">
            <div class="alert-icon-wrapper">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="alert-content">
                <strong>Error!</strong>
                <p>@TempData["ErrorMessage"]</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <!-- Orders Header Bar -->
        <div class="orders-control-bar">
            <div class="orders-count-badge">
                <i class="fas fa-list-ul me-2"></i>
                <span class="count-number">@Model.Count()</span>
                <span class="count-label">Total Orders</span>
            </div>
            <a href="@Url.Action("Browse", "Menu")" class="btn-order-more">
                <i class="fas fa-plus-circle me-2"></i>
                Order More Food
            </a>
        </div>

        <!-- Orders List -->
        <div class="orders-list-container">
            @foreach (var order in Model)
            {
                <div class="order-card-modern">
                    <!-- Order Header -->
                    <div class="order-card-header-modern">
                        <div class="order-main-info">
                            <div class="order-id-section">
                                <div class="order-number-badge">
                                    <i class="fas fa-hashtag"></i>
                                    <span>@order.OrderNumber</span>
                                </div>
                                <div class="order-timestamp">
                                    <i class="far fa-clock me-1"></i>
                                    @order.CreatedTime.ToString("MMM dd, yyyy h:mm tt")
                                </div>
                            </div>
                        </div>
                        
                        <div class="order-status-section">
                            <span class="badge order-status-badge @order.StatusBadgeClass">
                                @order.Status
                            </span>
                        </div>
                    </div>

                    <!-- Order Details Grid -->
                    <div class="order-details-grid">
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="fas fa-shopping-bag"></i>
                            </div>
                            <div class="detail-content">
                                <span class="detail-label">Items</span>
                                <span class="detail-value">@order.TotalItems</span>
                            </div>
                        </div>

                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="fas fa-peso-sign"></i>
                            </div>
                            <div class="detail-content">
                                <span class="detail-label">Total Amount</span>
                                <span class="detail-value">@("P" + order.TotalAmount.ToString("F2"))</span>
                            </div>
                        </div>

                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="fas fa-credit-card"></i>
                            </div>
                            <div class="detail-content">
                                <span class="detail-label">Payment</span>
                                <span class="detail-value">@order.PaymentMethod</span>
                            </div>
                        </div>

                        <div class="detail-item detail-item-full">
                            <a href="@Url.Action("Details", "Order", new { id = order.Id })" 
                               class="btn-track-order">
                                <i class="fas fa-eye me-2"></i>
                                View Details
                            </a>
                        </div>
                    </div>

                    <!-- Status Messages -->
                    @if (order.Status == "Ready")
                    {
                        <div class="order-status-message ready-message">
                            <i class="fas fa-bell"></i>
                            <span>Your order is ready for courier pickup!</span>
                        </div>
                    }
                    else if (order.Status == "Preparing")
                    {
                        <div class="order-status-message preparing-message">
                            <i class="fas fa-utensils"></i>
                            <span>Your order is being prepared...</span>
                        </div>
                    }
                    else if (order.Status.ToLower() == "received" && !order.HasReview)
                    {
                        <div class="review-section-modern">
                            <div class="review-prompt">
                                <div class="review-icon">
                                    <i class="fas fa-star"></i>
                                </div>
                                <div class="review-text">
                                    <h6>How was your experience?</h6>
                                    <p>Share your feedback and help others</p>
                                </div>
                            </div>
                            <a href="@Url.Action("Create", "Review", new { orderId = order.Id })"
                               class="btn-leave-review">
                                <i class="fas fa-pen me-2"></i>
                                Leave a Review
                            </a>
                        </div>
                    }
                    else if (order.Status.ToLower() == "received" && order.HasReview)
                    {
                        <div class="order-status-message completed-message">
                            <i class="fas fa-check-double"></i>
                            <span>Review completed - Thank you for your feedback!</span>
                        </div>
                    }

                    <!-- Expandable Order Items -->
                    <div class="order-items-preview collapse" id="orderItems@order.Id">
                        <div class="items-preview-header">
                            <i class="fas fa-list-ul me-2"></i>
                            <span>Order Items</span>
                        </div>
                        <div class="items-preview-list">
                            @foreach (var item in order.OrderItems.Take(3))
                            {
                                <div class="preview-item-row">
                                    <div class="item-info">
                                        <span class="item-name-text">@item.MenuItemName</span>
                                        <span class="item-quantity-badge">×@item.Quantity</span>
                                    </div>
                                    <span class="item-price-text">@("P" + item.TotalPrice.ToString("F2"))</span>
                                </div>
                            }
                            @if (order.OrderItems.Count() > 3)
                            {
                                <div class="preview-item-row more-items">
                                    <span class="text-muted">
                                        <i class="fas fa-plus-circle me-2"></i>
                                        and @(order.OrderItems.Count() - 3) more items...
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="empty-state-container">
            <div class="empty-state-content">
                <div class="empty-icon-circle">
                    <i class="fas fa-receipt"></i>
                </div>
                <h3 class="empty-title">No Orders Yet</h3>
                <p class="empty-description">
                    You haven't placed any orders yet. Start exploring our delicious menu and place your first order!
                </p>
                <a href="@Url.Action("Browse", "Menu")" class="btn-browse-menu">
                    <i class="fas fa-utensils me-2"></i>
                    Browse Menu
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/my-orders.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/my-orders.css" />
}