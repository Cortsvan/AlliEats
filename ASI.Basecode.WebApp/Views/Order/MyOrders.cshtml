@model IEnumerable<ASI.Basecode.Services.ServiceModels.OrderViewModel>

@{
    ViewData["Title"] = "My Orders & Tracking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="orders-header text-center">
        <h1 class="display-5 fw-bold"><i class="fas fa-history me-3"></i>My Orders & Tracking</h1>
        <p class="lead">View all your orders and track their status in real-time</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            @if (Model != null && Model.Any())
            {
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0">Order History (@Model.Count() orders)</h4>
                    <div>
                        <a href="@Url.Action("Browse", "Menu")" class="btn btn-checkout">
                            <i class="fas fa-utensils me-2"></i>Order More Food
                        </a>
                    </div>
                </div>

                <div>
                    @foreach (var order in Model)
                    {
                        <div class="order-card mb-4">
                            <div class="order-card-header">
                                <div class="row align-items-center">
                                    <div class="col-md-3">
                                        <div class="order-number">
                                            <strong>Order #@order.OrderNumber</strong>
                                        </div>
                                        <div class="order-date">
                                            @order.CreatedTime.ToString("MMM dd, yyyy h:mm tt")
                                        </div>
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <span class="items-badge">@order.TotalItems items</span>
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <span class="total-amount">@("P" + order.TotalAmount.ToString("F2"))</span>
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <span class="payment-method">@order.PaymentMethod</span>
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <span class="badge @order.StatusBadgeClass status-badge">@order.Status</span>
                                        @if (order.Status == "Ready")
                                        {
                                            <div class="status-note text-warning">
                                                <small><i class="fas fa-bell"></i> Ready for courier pickup!</small>
                                            </div>
                                        }
                                        else if (order.Status == "Preparing")
                                        {
                                            <div class="status-note text-primary">
                                                <small><i class="fas fa-utensils"></i> Being prepared...</small>
                                            </div>
                                        }
                                        else if (order.Status.ToLower() == "received" && !order.HasReview)
                                        {
                                            <div class="status-note review-section">
                                                <div class="review-prompt-card">
                                                    <div class="review-prompt-content">
                                                        <i class="fas fa-star-half-alt text-warning me-1"></i>
                                                        <small class="text-muted">How was your experience?</small>
                                                    </div>
                                                    <a href="@Url.Action("Create", "Review", new { orderId = order.Id })"
                                                       class="btn-review">
                                                        <i class="fas fa-star me-1"></i>Leave Review
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                        else if (order.Status.ToLower() == "received" && order.HasReview)
                                        {
                                            <div class="status-note">
                                                <div class="review-completed">
                                                    <i class="fas fa-check-circle"></i> Review completed
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-1 text-center">
                                        <a href="@Url.Action("Details", "Order", new { id = order.Id })"
                                           class="btn btn-outline-primary btn-sm track-btn">
                                            <i class="fas fa-eye me-1"></i>Track
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Expandable Order Items (Initially Hidden) -->
                            <div class="order-items-preview collapse" id="orderItems@order.Id">
                                <div class="order-items-container">
                                    <h6 class="mb-3"><i class="fas fa-list me-2"></i>Order Items:</h6>
                                    @foreach (var item in order.OrderItems.Take(3))
                                    {
                                        <div class="preview-item">
                                            <span class="item-name">@item.MenuItemName</span>
                                            <span class="item-details">x@item.Quantity - @("P" + item.TotalPrice.ToString("F2"))</span>
                                        </div>
                                    }
                                    @if (order.OrderItems.Count() > 3)
                                    {
                                        <div class="preview-item text-muted">
                                            <small>and @(order.OrderItems.Count() - 3) more items...</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-orders-container">
                    <div class="empty-icon"><i class="fas fa-shopping-bag"></i></div>
                    <h3 class="mt-4">No Orders Yet</h3>
                    <p class="text-muted">You haven't placed any orders yet. Start by browsing our delicious menu!</p>
                    <a href="@Url.Action("Browse", "Menu")" class="btn btn-checkout btn-lg mt-3">
                        <i class="fas fa-utensils me-2"></i>Browse Menu
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/my-orders.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/my-orders.css" />
}