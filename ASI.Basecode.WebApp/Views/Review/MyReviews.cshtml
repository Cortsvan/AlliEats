@model ASI.Basecode.Services.ServiceModels.MyReviewsViewModel

@{
    ViewData["Title"] = "My Reviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="reviews-header text-center">
        <h1 class="display-5 fw-bold"><i class="fas fa-star me-3"></i>My Reviews</h1>
        <p class="lead">Your feedback and ratings for past orders</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Reviews.Any())
    {
        <div class="row">
            @foreach (var review in Model.Reviews)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm review-card">
                        <div class="card-body">
                            <!-- Review Header -->
                            <div class="review-header-info mb-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="review-order-number mb-1">
                                            <i class="fas fa-receipt me-2"></i>@review.OrderNumber
                                        </h6>
                                        <small class="text-muted">
                                            Order Date: @review.OrderDate.ToString("MMM dd, yyyy")
                                        </small>
                                    </div>
                                    <div class="review-rating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            @if (i <= review.Rating)
                                            {
                                                <i class="fas fa-star text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-muted"></i>
                                            }
                                        }
                                        <span class="rating-number ms-2">(@review.Rating/5)</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Review Comment -->
                            @if (!string.IsNullOrEmpty(review.Comment))
                            {
                                <div class="review-comment mb-3">
                                    <p class="mb-0">"@review.Comment"</p>
                                </div>
                            }

                            <!-- Order Items Summary -->
                            <div class="order-items-summary mb-3">
                                <h6 class="mb-2">Items Reviewed:</h6>
                                <div class="items-list">
                                    @foreach (var item in review.OrderItems)
                                    {
                                        <div class="item-summary">
                                            <img src="@(string.IsNullOrEmpty(item.MenuItemImagePath) ? "/img/placeholder-food.png" : item.MenuItemImagePath)"
                                                 alt="@item.MenuItemName" class="item-image"
                                                 onerror="this.src='/img/placeholder-food.png'; this.onerror=null;">
                                            <div class="item-info">
                                                <span class="item-name">@item.MenuItemName</span>
                                                <span class="item-qty">x @item.Quantity</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Review Footer -->
                            <div class="review-footer">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="review-meta">
                                        <small class="text-muted">
                                            <i class="fas fa-clock me-1"></i>
                                            Reviewed on @review.ReviewDate.ToString("MMM dd, yyyy")
                                        </small>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-success">@("P" + review.OrderTotal.ToString("F2"))</span>
                                        <button type="button" class="btn btn-sm btn-outline-primary edit-review-btn"
                                                data-order-id="@review.OrderId">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="no-reviews-container">
                <i class="fas fa-star fa-3x text-muted mb-3"></i>
                <h5 class="text-muted mb-3">No Reviews Yet</h5>
                <p class="text-muted mb-4">You haven't left any reviews yet. Complete some orders and share your experience!</p>
                <a href="@Url.Action("MyOrders", "Order")" class="btn btn-primary">
                    <i class="fas fa-list me-2"></i>View My Orders
                </a>
            </div>
        </div>
    }
</div>

<!-- Edit Review Modal -->
<div class="modal fade" id="editReviewModal" tabindex="-1" aria-labelledby="editReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editReviewModalLabel">
                    <i class="fas fa-edit me-2"></i>Edit Review
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editReviewForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editOrderId" />

                    <!-- Star Rating -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Rating <span class="text-danger">*</span></label>
                        <div class="star-rating" id="editStarRating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="star" data-rating="@i">
                                    <i class="far fa-star"></i>
                                </span>
                            }
                        </div>
                        <input type="hidden" id="editRatingInput" />
                        <div id="editRatingText" class="rating-text mt-2"></div>
                        <div id="editRatingError" class="text-danger mt-1" style="display: none;"></div>
                    </div>

                    <!-- Comment -->
                    <div class="mb-4">
                        <label for="editComment" class="form-label fw-bold">Your Comments (Optional)</label>
                        <textarea id="editComment" class="form-control" rows="5"
                                  placeholder="Tell us about your experience with this order..."
                                  maxlength="1000"></textarea>
                        <div class="text-muted small mt-1">
                            <span id="editCharCount">0</span>/1000 characters
                        </div>
                        <div id="editCommentError" class="text-danger mt-1" style="display: none;"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveReviewBtn">
                    <i class="fas fa-save me-2"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/review.css" />
}

@section Scripts {
    <script src="~/js/review.js"></script>
}