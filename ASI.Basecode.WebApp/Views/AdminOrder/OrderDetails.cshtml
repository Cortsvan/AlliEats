@model ASI.Basecode.Services.ServiceModels.OrderViewModel

@{
    ViewData["Title"] = "Order Details - Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: 'Georgia', serif;
        background-color: #FFF3E0; /* Cream Beige */
        color: #212121; /* Dark Charcoal */
    }

    .custom-card-bg {
        background-color: white;
        border: 1px solid rgba(93, 64, 55, 0.1);
        border-radius: 1rem;
        box-shadow: 0 4px 12px -2px rgba(93, 64, 55, 0.1), 0 2px 4px -2px rgba(93, 64, 55, 0.05);
    }

    .bg-deep-maroon {
        background-color: #5D4037 !important; /* Deep Maroon */
        color: white !important;
    }

    .text-deep-maroon {
        color: #5D4037 !important;
    }

    .badge-status {
        border-radius: 0.5rem;
        font-size: 0.85rem;
        padding: 0.4em 0.8em;
        font-weight: 600;
        text-transform: uppercase;
    }

        .badge-status.Pending {
            background-color: #FFD54F;
            color: #212121;
        }
        /* Gold */
        .badge-status.Confirmed {
            background-color: #FFA000;
            color: #212121;
        }
        /* Darker Gold */
        .badge-status.Preparing {
            background-color: #1976D2;
            color: white;
        }
        /* Blue */
        .badge-status.Ready {
            background-color: #4CAF50;
            color: white;
        }
        /* Green */
        .badge-status.Delivered {
            background-color: #5D4037;
            color: white;
        }
        /* Deep Maroon */
        .badge-status.Cancelled {
            background-color: #F44336;
            color: white;
        }
    /* Red */

    .btn-accent-gold {
        background-color: #FFD54F;
        color: #212121;
        border: none;
        border-radius: 0.5rem;
        font-weight: 500;
    }

        .btn-accent-gold:hover {
            background-color: #FFC107;
            color: #212121;
        }

    .btn-maroon {
        background-color: #5D4037;
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-weight: 500;
    }

        .btn-maroon:hover {
            background-color: #4E342E;
        }

    .order-item-row {
        padding: 0.8rem 0;
        border-bottom: 1px solid rgba(93, 64, 55, 0.1);
    }

        .order-item-row:hover {
            background-color: rgba(93, 64, 55, 0.05);
        }

    .modal-header {
        background-color: #5D4037 !important;
        color: white !important;
    }

    .btn-close-white {
        background-color: white;
        color: #5D4037;
    }

    .alert-primary, .alert-danger {
        background-color: #FFF3E0;
        color: #5D4037;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }


</style>

<div class="container-fluid px-4">

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-primary border-0 shadow-sm d-flex align-items-center">
                <div class="me-3">
                    <i class="fas fa-receipt fa-2x text-deep-maroon"></i>
                </div>
                <div>
                    <h4 class="alert-heading mb-1 text-deep-maroon"> Order Details</h4>
                    <p class="mb-0">Complete information for order <strong>@Model.OrderNumber</strong></p>
                </div>
            </div>
        </div>
    </div>


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm mb-4" role="alert" style="border-radius:1rem;">
            <i class="fas fa-exclamation-triangle me-3 fa-lg text-danger"></i>
            <div class="flex-grow-1 fw-semibold">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close btn-close-lg ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left: Order Info & Items -->
        <div class="col-lg-8">
            <!-- Order Info Card -->
            <div class="card custom-card-bg shadow">
                <div class="card-header bg-deep-maroon d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i> Order Information</h5>
                    <span class="badge badge-status @Model.StatusBadgeClass">@Model.Status</span>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-md-6"><strong>Order #:</strong> @Model.OrderNumber</div>
                        <div class="col-md-6"><strong>Customer ID:</strong> @Model.UserId</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6"><strong>Order Date:</strong> @Model.CreatedTime.ToString("MMM dd, yyyy h:mm tt")</div>
                        <div class="col-md-6"><strong>Last Updated:</strong> @(Model.UpdatedTime?.ToString("MMM dd, yyyy h:mm tt") ?? "Not updated")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6"><strong>Payment Method:</strong> @Model.PaymentMethod</div>
                        <div class="col-md-6"><strong>Total Amount:</strong> <span class="text-success fw-bold">$@Model.TotalAmount.ToString("F2")</span></div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <strong>Customer Notes:</strong>
                                <div class="p-3 bg-light rounded mt-2">@Model.Notes</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Items Card -->
            <div class="card custom-card-bg shadow mt-4">
                <div class="card-header bg-deep-maroon text-white">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i> Ordered Items (@Model.TotalItems items)</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center mb-2 rounded" style="background-color:#FFF8F5; border:1px solid rgba(93,64,55,0.1);">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@item.MenuItemName</h6>
                                    <small class="text-dark fw-semibold">$@item.Price.ToString("F2")</small>
                                </div>
                                <span class="badge bg-deep-maroon text-white mx-2">@item.Quantity</span>
                                <span class="fw-bold text-deep-maroon">$@item.TotalPrice.ToString("F2")</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between border-top pt-3 mt-3">
                        <h6>Total Items: @Model.TotalItems</h6>
                        <h5 class="text-deep-maroon fw-bold">Total: $@Model.TotalAmount.ToString("F2")</h5>
                    </div>
                </div>
            </div>

        </div>

        <!-- Right: Admin Actions -->
        <div class="col-lg-4">
            <div class="card custom-card-bg shadow">
                <div class="card-header bg-deep-maroon text-white"><h5 class="mb-0"><i class="fas fa-cogs me-2"></i> Admin Actions</h5></div>
                <div class="card-body">
                    @if (Model.Status != "Delivered" && Model.Status != "Cancelled")
                    {
                        <div class="d-grid gap-2 mb-3">
                            <button type="button" class="btn btn-maroon"
                                    onclick="showUpdateStatusModal(@Model.Id, '@Model.OrderNumber', '@Model.Status')">
                                <i class="fas fa-edit me-2"></i> Update Status
                            </button>
                        </div>
                    }

                    <div class="mb-2 fw-semibold">Quick Status Updates:</div>
                    <div class="d-grid gap-2">
                        @if (Model.Status == "Pending")
                        {
                            <button onclick="updateStatus(@Model.Id,'Confirmed')" class="btn btn-accent-gold">Confirm Order</button>
                        }
                        @if (Model.Status == "Confirmed")
                        {
                            <button onclick="updateStatus(@Model.Id,'Preparing')" class="btn btn-accent-gold">Start Preparing</button>
                        }
                        @if (Model.Status == "Preparing")
                        {
                            <button onclick="updateStatus(@Model.Id,'Ready')" class="btn btn-accent-gold">Mark as Ready</button>
                        }
                        @if (Model.Status == "Ready")
                        {
                            <button onclick="updateStatus(@Model.Id,'Delivered')" class="btn btn-accent-gold">Mark as Delivered</button>
                        }
                        @if (Model.Status != "Delivered" && Model.Status != "Cancelled")
                        {
                            <button onclick="updateStatus(@Model.Id,'Cancelled')" class="btn btn-outline-danger">Cancel Order</button>
                        }
                    </div>
                </div>
            </div>

            <div class="card custom-card-bg shadow mt-3">
                <div class="card-body text-center">
                    <a href="@Url.Action("ManageOrders", "AdminOrder")" class="btn btn-accent-gold"><i class="fas fa-arrow-left me-2"></i> Back to Orders</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content custom-card-bg shadow-lg">
            <div class="modal-header bg-deep-maroon">
                <h5 class="modal-title text-white"><i class="fas fa-edit me-2"></i>Update Status</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="updateStatusForm" method="post" action="@Url.Action("UpdateStatus","AdminOrder")">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="orderId" name="orderId" />
                    <div class="mb-3">
                        <label class="form-label">Order Number:</label>
                        <input type="text" id="orderNumber" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Status:</label>
                        <select id="status" name="status" class="form-select" required>
                            <option value="">Select Status</option>
                            <option value="Pending">Pending</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Preparing">Preparing</option>
                            <option value="Ready">Ready</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-accent-gold"><i class="fas fa-save me-2"></i>Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showUpdateStatusModal(orderId, orderNumber, currentStatus) {
            document.getElementById('orderId').value = orderId;
            document.getElementById('orderNumber').value = orderNumber;
            document.getElementById('status').value = currentStatus;
            new bootstrap.Modal(document.getElementById('updateStatusModal')).show();
        }

        function updateStatus(orderId, status) {
            if(confirm(`Are you sure you want to change this order to ${status}?`)) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("UpdateStatus", "AdminOrder")';

                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                form.innerHTML = `<input type="hidden" name="__RequestVerificationToken" value="${token}" />
                                  <input type="hidden" name="orderId" value="${orderId}" />
                                  <input type="hidden" name="status" value="${status}" />`;
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}
