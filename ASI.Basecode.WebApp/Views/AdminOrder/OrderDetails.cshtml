@model ASI.Basecode.Services.ServiceModels.OrderViewModel

@{
    ViewData["Title"] = "Order Details - Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="admin-order-header">
        <h1><i class="fas fa-receipt me-3"></i>Order Details</h1>
        <p class="lead mb-0">Complete order information and management tools</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Order Information -->
        <div class="col-lg-8">
            <!-- Order Summary Card -->
            <div class="card order-summary-card mb-4">
                <div class="card-header order-card-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <h5 class="mb-0">
                            <i class="fas fa-hashtag me-2"></i>Order #@Model.OrderNumber
                        </h5>
                        <span class="status-badge-detailed @Model.Status.ToLower().Replace(" ", "-")">
                            <i class="fas @GetStatusIcon(Model.Status)"></i>
                            @Model.Status
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="order-info-grid">
                        <div class="order-info-item">
                            <span class="order-info-label">
                                <i class="fas fa-user"></i>Customer
                            </span>
                            <span class="order-info-value">@Model.UserId</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">
                                <i class="fas fa-calendar"></i>Order Date
                            </span>
                            <span class="order-info-value">@Model.CreatedTime.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">
                                <i class="fas fa-clock"></i>Order Time
                            </span>
                            <span class="order-info-value">@Model.CreatedTime.ToString("h:mm tt")</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">
                                <i class="fas fa-sync-alt"></i>Last Updated
                            </span>
                            <span class="order-info-value">
                                @(Model.UpdatedTime?.ToString("MMM dd, yyyy h:mm tt") ?? "Not updated")
                            </span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">
                                <i class="fas fa-credit-card"></i>Payment Method
                            </span>
                            <span class="order-info-value payment-method-badge">@Model.PaymentMethod</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">
                                <i class="fas fa-peso-sign"></i>Total Amount
                            </span>
                            <span class="order-info-value order-total-amount">@("₱" + Model.TotalAmount.ToString("F2"))</span>
                        </div>
                    </div>

                    @if (Model.Status == "On the Way")
                    {
                        var timeSinceUpdate = DateTime.Now - (Model.UpdatedTime ?? Model.CreatedTime);
                        var remainingTime = TimeSpan.FromHours(2) - timeSinceUpdate;
                        var isOverdue = remainingTime.TotalMinutes <= 0;

                        <div class="timer-info-section">
                            <div class="alert @(isOverdue ? "alert-warning" : "alert-info") timer-alert mb-0">
                                <div class="d-flex align-items-start">
                                    <i class="fas @(isOverdue ? "fa-exclamation-triangle" : "fa-hourglass-half") me-3"></i>
                                    <div class="flex-grow-1">
                                        <strong class="d-block mb-2">Auto-Receipt Timer</strong>
                                        <div class="timer-details">
                                            @if (isOverdue)
                                            {
                                                <span class="text-warning d-block mb-2">⚠️ This order is overdue and will be automatically marked as "Received" shortly.</span>
                                            }
                                            else
                                            {
                                                <span class="d-block mb-2">This order will be automatically marked as "Received" in:</span>
                                                <div class="countdown-display" data-remaining="@remainingTime.TotalSeconds">
                                                    <span class="countdown-time">@(remainingTime.Hours)h @(remainingTime.Minutes)m</span>
                                                </div>
                                            }
                                        </div>
                                        <small class="text-muted d-block mt-2">
                                            <i class="fas fa-clock me-1"></i>
                                            Started: @((Model.UpdatedTime ?? Model.CreatedTime).ToString("MMM dd, yyyy h:mm tt"))
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="customer-notes-section">
                            <div class="notes-header">
                                <i class="fas fa-sticky-note"></i>Customer Notes
                            </div>
                            <div class="notes-content">
                                @Model.Notes
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Items Card -->
            <div class="card order-items-card">
                <div class="card-header order-card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-utensils me-2"></i>Order Items (@Model.TotalItems items)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="order-items-container">
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="order-item-row">
                                <div class="item-info">
                                    <div class="item-name">@item.MenuItemName</div>
                                    <div class="item-price">@("₱" + item.Price.ToString("F2")) each</div>
                                </div>
                                <div class="item-quantity">
                                    <span class="quantity-badge">×@item.Quantity</span>
                                </div>
                                <div class="item-total">
                                    @("₱" + item.TotalPrice.ToString("F2"))
                                </div>
                            </div>
                        }
                    </div>

                    <div class="order-summary-footer">
                        <div class="summary-row">
                            <span class="summary-label">Total Items:</span>
                            <span class="summary-value">@Model.TotalItems</span>
                        </div>
                        <div class="summary-row total-row">
                            <span class="summary-label">Grand Total:</span>
                            <span class="summary-value total-amount">@("₱" + Model.TotalAmount.ToString("F2"))</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Admin Actions Sidebar -->
        <div class="col-lg-4">
            <!-- Quick Actions Card -->
            <div class="card admin-actions-card mb-4">
                <div class="card-header admin-card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-cogs me-2"></i>Admin Actions
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Status != "Received" && Model.Status != "Cancelled")
                    {
                        <div class="action-section">
                            <h6 class="action-section-title">
                                <i class="fas fa-edit"></i>Update Status
                            </h6>
                            <button type="button" class="btn btn-admin-primary w-100"
                                    onclick="showUpdateStatusModal(@Model.Id, '@Model.OrderNumber', '@Model.Status')">
                                <i class="fas fa-edit me-2"></i>Change Order Status
                            </button>
                        </div>

                        @if (Model.Status == "Pending" || Model.Status == "Confirmed" || Model.Status == "Preparing" || Model.Status == "Ready")
                        {
                            <div class="action-section">
                                <h6 class="action-section-title">
                                    <i class="fas fa-bolt"></i>Quick Actions
                                </h6>
                                <div class="quick-actions">
                                    @if (Model.Status == "Pending")
                                    {
                                        <button onclick="updateStatus(@Model.Id, 'Confirmed')" class="btn btn-quick-action confirmed">
                                            <i class="fas fa-check"></i>
                                            <span>Confirm Order</span>
                                        </button>
                                    }
                                    @if (Model.Status == "Confirmed")
                                    {
                                        <button onclick="updateStatus(@Model.Id, 'Preparing')" class="btn btn-quick-action preparing">
                                            <i class="fas fa-utensils"></i>
                                            <span>Start Preparing</span>
                                        </button>
                                    }
                                    @if (Model.Status == "Preparing")
                                    {
                                        <button onclick="updateStatus(@Model.Id, 'Ready')" class="btn btn-quick-action ready">
                                            <i class="fas fa-bell"></i>
                                            <span>Mark as Ready</span>
                                        </button>
                                    }
                                    @if (Model.Status == "Ready")
                                    {
                                        <button onclick="updateStatus(@Model.Id, 'On the Way')" class="btn btn-quick-action ontheway">
                                            <i class="fas fa-shipping-fast"></i>
                                            <span>Out for Delivery</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <!-- Status Information -->
                    <div class="action-section">
                        <h6 class="action-section-title">
                            <i class="fas fa-info-circle"></i>Status Information
                        </h6>

                        @if (Model.Status == "On the Way")
                        {
                            <div class="status-info pending-customer">
                                <i class="fas fa-truck"></i>
                                <div>
                                    <strong>Waiting for Customer</strong>
                                    <p>Order is out for delivery. Customer will confirm receipt or it will be auto-confirmed after 2 hours.</p>
                                    <small>
                                        <i class="fas fa-clock me-1"></i>
                                        Timer started: @((Model.UpdatedTime ?? Model.CreatedTime).ToString("h:mm tt"))
                                    </small>
                                </div>
                            </div>
                        }
                        else if (Model.Status == "Received")
                        {
                            <div class="status-info completed">
                                <i class="fas fa-check-circle"></i>
                                <div>
                                    <strong>Order Completed</strong>
                                    <p>Customer has confirmed receipt of the order.</p>
                                </div>
                            </div>
                        }
                        else if (Model.Status == "Cancelled")
                        {
                            <div class="status-info cancelled">
                                <i class="fas fa-times-circle"></i>
                                <div>
                                    <strong>Order Cancelled</strong>
                                    <p>This order has been cancelled.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="status-flow-info">
                                <div class="flow-step @(GetStepClass("Pending", Model.Status))">
                                    <span class="step-number">1</span>
                                    <span class="step-name">Pending</span>
                                </div>
                                <div class="flow-arrow">→</div>
                                <div class="flow-step @(GetStepClass("Confirmed", Model.Status))">
                                    <span class="step-number">2</span>
                                    <span class="step-name">Confirmed</span>
                                </div>
                                <div class="flow-arrow">→</div>
                                <div class="flow-step @(GetStepClass("Preparing", Model.Status))">
                                    <span class="step-number">3</span>
                                    <span class="step-name">Preparing</span>
                                </div>
                                <div class="flow-arrow">→</div>
                                <div class="flow-step @(GetStepClass("Ready", Model.Status))">
                                    <span class="step-number">4</span>
                                    <span class="step-name">Ready</span>
                                </div>
                                <div class="flow-arrow">→</div>
                                <div class="flow-step @(GetStepClass("On the Way", Model.Status))">
                                    <span class="step-number">5</span>
                                    <span class="step-name">On the Way</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Navigation Card -->
            <div class="card navigation-card">
                <div class="card-body">
                    <div class="d-grid gap-3">
                        <a href="@Url.Action("ManageOrders", "AdminOrder")" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Order Management
                        </a>
                        <button type="button" class="btn btn-outline-primary" onclick="refreshPage()">
                            <i class="fas fa-sync-alt me-2"></i>Refresh Page
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Action Confirmation Modal -->
<div class="modal fade" id="quickActionModal" tabindex="-1" aria-labelledby="quickActionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header quick-action-modal-header">
                <h5 class="modal-title" id="quickActionModalLabel">
                    <i id="quickActionIcon" class="fas fa-bolt me-2"></i>
                    <span id="quickActionTitle">Confirm Action</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="quickActionOrderId" />
                <input type="hidden" id="quickActionStatus" />

                <div class="quick-action-confirmation">
                    <div class="confirmation-icon-wrapper">
                        <div class="confirmation-icon">
                            <i class="fas fa-question-circle"></i>
                        </div>
                    </div>
                    <p class="confirmation-message" id="quickActionDescription">
                        Are you sure you want to proceed with this action?
                    </p>
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        <small>This action will update the order status immediately.</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-action" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-admin-primary btn-action" id="confirmQuickActionBtn" onclick="confirmQuickAction()">
                    <i class="fas fa-check me-2"></i>Yes, Update Status
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Enhanced Update Status Modal -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-labelledby="updateStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header update-modal-header">
                <h5 class="modal-title" id="updateStatusModalLabel">
                    <i class="fas fa-edit me-2"></i>Update Order Status
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="updateStatusForm" method="post" action="@Url.Action("UpdateStatus", "AdminOrder")">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="orderId" name="orderId" />

                    <div class="mb-3">
                        <label for="orderNumber" class="form-label fw-bold">
                            <i class="fas fa-hashtag me-1"></i>Order Number
                        </label>
                        <input type="text" id="orderNumber" class="form-control form-control-enhanced" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="currentStatus" class="form-label fw-bold">
                            <i class="fas fa-info-circle me-1"></i>Current Status
                        </label>
                        <input type="text" id="currentStatus" class="form-control form-control-enhanced" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="status" class="form-label fw-bold">
                            <i class="fas fa-arrow-right me-1"></i>New Status
                        </label>
                        <select id="status" name="status" class="form-select form-control-enhanced" required>
                            <option value="">-- Select New Status --</option>
                        </select>
                    </div>

                    <div class="status-flow-guide">
                        <small class="text-muted">
                            <i class="fas fa-lightbulb me-1"></i>
                            <strong>Admin Flow:</strong> Pending → Confirmed → Preparing → Ready → On the Way
                            <br>
                            <i class="fas fa-info-circle me-1"></i>
                            <strong>Note:</strong> Orders marked as "On the Way" will auto-confirm after 2 hours
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-action" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-admin-primary btn-action">
                        <i class="fas fa-save me-2"></i>Update Status
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-order-details.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-order-details.css" />
}

@functions {
    string GetStatusIcon(string status)
    {
        return status switch
        {
            "Pending" => "fa-clock",
            "Confirmed" => "fa-check",
            "Preparing" => "fa-utensils",
            "Ready" => "fa-bell",
            "On the Way" => "fa-shipping-fast",
            "Received" => "fa-check-circle",
            "Cancelled" => "fa-times-circle",
            _ => "fa-question-circle"
        };
    }

    string GetStepClass(string stepStatus, string currentStatus)
    {
        var statusOrder = new[] { "Pending", "Confirmed", "Preparing", "Ready", "On the Way", "Received" };
        var stepIndex = Array.IndexOf(statusOrder, stepStatus);
        var currentIndex = Array.IndexOf(statusOrder, currentStatus);

        if (stepIndex == currentIndex) return "active";
        if (stepIndex < currentIndex) return "completed";
        return "";
    }
}