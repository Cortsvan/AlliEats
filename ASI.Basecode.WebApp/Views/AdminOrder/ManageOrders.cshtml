@model IEnumerable<ASI.Basecode.Services.ServiceModels.OrderViewModel>

@{
    ViewData["Title"] = "Manage Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    body {
        font-family: Georgia, serif;
        background-color: #FFF3E0; /* Secondary */
        color: #212121; /* Text */
    }
    .custom-card-bg {
        background-color: white;
        border: 1px solid rgba(93, 64, 55, 0.1);
        border-radius: 1rem;
        box-shadow: 0 4px 12px -2px rgba(93, 64, 55, 0.1), 0 2px 4px -2px rgba(93, 64, 55, 0.05);
    }

    .table thead {
        background-color: #5D4037;
        color: white;
    }

    .table tbody tr:hover {
        background-color: rgba(93, 64, 55, 0.05);
    }

    .badge-status {
        border-radius: 8px;
        font-size: 0.85rem;
        padding: 0.4em 0.7em;
    }

    .total-badge {
        font-size: 0.85rem;
        padding: 0.5em 1em;
        border-radius: 20px;
    }

    .alert-primary {
        background-color: #FFF3E0;
        color: #5D4037;
        border: 1px solid rgba(93, 64, 55, 0.3);
    }

        .alert-primary.d-flex {
            gap: 1.2rem;
        }

    .btn-outline-primary {
        border-color: #5D4037;
        color: #5D4037;
    }

        .btn-outline-primary:hover {
            background-color: rgba(93, 64, 55, 0.1);
        }

    .btn-outline-success {
        border-color: #388E3C;
        color: #388E3C;
    }

        .btn-outline-success:hover {
            background-color: rgba(56, 142, 60, 0.1);
        }

    .status-card {
        border-radius: 1rem;
        border-width: 2px;
        padding: 1rem;
        transition: 0.2s;
        background: #fff;
        text-align: center;
    }

        .status-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

    .status-count {
        font-weight: 600;
        font-size: 1.3rem;
    }

    .btn-close-lg {
        width: 2.5rem;
        height: 2.5rem;
    }

</style>

<div class="container-fluid px-4">
    <!-- Admin Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-primary border-0 shadow-sm d-flex align-items-center">
                <div class="me-3">
                    <i class="fas fa-clipboard-list fa-2x text-deep-maroon"></i>
                </div>
                <div>
                    <h4 class="alert-heading mb-1 text-deep-maroon">Order Management</h4>
                    <p class="mb-0">View and update the status of customer orders.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Table Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card custom-card-bg shadow">
                <div class="card-header d-flex justify-content-between align-items-center" style="background-color:#5D4037; color:white;">
                    <h4 class="mb-0"><i class="fas fa-shopping-bag me-2"></i> Customer Orders</h4>
                    <span class="badge bg-light text-dark total-badge">@Model.Count() Total Orders</span>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center shadow-sm p-3 mb-4" role="alert" style="border-radius:1rem;">
                            <i class="fas fa-check-circle me-3 fa-lg text-success"></i>
                            <div class="flex-grow-1 fw-semibold">
                                @TempData["SuccessMessage"]
                            </div>
                            <button type="button" onclick="this.parentElement.style.display='none';"
                                    style="
                        background-color: #5D4037;
                        color: white;
                        border: none;
                        border-radius: 50%;
                        width: 2.5rem;
                        height: 2.5rem;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-weight: bold;
                        font-size: 1.2rem;
                        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
                        cursor: pointer;
                    ">
                                &times;
                            </button>
                        </div>
                    }


                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm p-3 mb-4" role="alert" style="border-radius:1rem;">
                            <i class="fas fa-exclamation-triangle me-3 fa-lg text-danger"></i>
                            <div class="flex-grow-1 fw-semibold">
                                @TempData["ErrorMessage"]
                            </div>
                            <button type="button" class="btn-close btn-close-lg ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (Model.Any())
                    {
                        <!-- Order Summary Stats -->
                        <div class="row mb-4 g-3">
                            <div class="col-md-2">
                                <div class="status-card border-warning">
                                    <div class="status-count text-warning">@Model.Count(o => o.Status == "Pending")</div>
                                    <small>Pending</small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="status-card border-info">
                                    <div class="status-count text-info">@Model.Count(o => o.Status == "Confirmed")</div>
                                    <small>Confirmed</small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="status-card border-primary">
                                    <div class="status-count text-primary">@Model.Count(o => o.Status == "Preparing")</div>
                                    <small>Preparing</small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="status-card border-success">
                                    <div class="status-count text-success">@Model.Count(o => o.Status == "Ready")</div>
                                    <small>Ready</small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="status-card border-success">
                                    <div class="status-count text-success">@Model.Count(o => o.Status == "Delivered")</div>
                                    <small>Delivered</small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="status-card border-danger">
                                    <div class="status-count text-danger">@Model.Count(o => o.Status == "Cancelled")</div>
                                    <small>Cancelled</small>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Customer</th>
                                        <th>Date</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Payment</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model)
                                    {
                                        <tr class="@(order.Status == "Delivered" ? "table-success" : "")">
                                            <td><strong>@order.OrderNumber</strong></td>
                                            <td><small>@order.UserId</small></td>
                                            <td>
                                                <div>@order.CreatedTime.ToString("MMM dd, yyyy")</div>
                                                <small class="text-muted">@order.CreatedTime.ToString("h:mm tt")</small>
                                            </td>
                                            <td><span class="badge bg-info">@order.TotalItems items</span></td>
                                            <td><span class="fw-bold text-success">$@order.TotalAmount.ToString("F2")</span></td>
                                            <td><small>@order.PaymentMethod</small></td>
                                            <td><span class="badge badge-status @order.StatusBadgeClass">@order.Status</span></td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("OrderDetails", "AdminOrder", new { id = order.Id })"
                                                       class="btn btn-sm btn-outline-primary" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @if (order.Status != "Delivered" && order.Status != "Cancelled")
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-success"
                                                                onclick="showUpdateStatusModal(@order.Id, '@order.OrderNumber', '@order.Status')"
                                                                title="Update Status">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-shopping-bag fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Orders Found</h5>
                            <p class="text-muted">No customer orders have been placed yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-labelledby="updateStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content custom-card-bg shadow-lg p-3">
            <div class="modal-header" style="background-color: #5D4037; border-bottom: 0; position: relative;">
                <h5 class="modal-title text-white" id="updateStatusModalLabel">
                    <i class="fas fa-edit me-2"></i> Update Order Status
                </h5>
                <button type="button" class="btn" data-bs-dismiss="modal" aria-label="Close"
                        style="position: absolute; top: 10px; right: 10px; background-color: white; color: #5D4037; border-radius: 50%; width: 2rem; height: 2rem; display: flex; align-items: center; justify-content: center; font-weight: bold; box-shadow: 0 2px 6px rgba(0,0,0,0.3);">
                    &times;
                </button>
            </div>
            <form id="updateStatusForm" method="post" action="@Url.Action("UpdateStatus", "AdminOrder")">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="orderId" name="orderId" />
                    <div class="mb-3">
                        <label for="orderNumber" class="form-label">Order Number:</label>
                        <input type="text" id="orderNumber" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="status" class="form-label">New Status:</label>
                        <select id="status" name="status" class="form-select" required>
                            <option value="">Select Status</option>
                            <option value="Pending">Pending</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Preparing">Preparing</option>
                            <option value="Ready">Ready</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-accent-orange">
                        <i class="fas fa-save me-2"></i> Update Status
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function showUpdateStatusModal(orderId, orderNumber, currentStatus) {
            document.getElementById('orderId').value = orderId;
            document.getElementById('orderNumber').value = orderNumber;
            document.getElementById('status').value = currentStatus;

            var updateModal = new bootstrap.Modal(document.getElementById('updateStatusModal'));
            updateModal.show();
        }

        // Auto refresh page every 30 seconds for real-time updates
        setTimeout(function() {
            location.reload();
        }, 30000);
    </script>
}
