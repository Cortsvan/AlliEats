@model ASI.Basecode.Services.ServiceModels.MenuItemViewModel

@{
    ViewData["Title"] = "Edit Menu Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="admin-menu-header text-center mb-4">
        <h1 class="display-5 fw-bold"><i class="fas fa-edit me-3"></i>Edit Menu Item</h1>
        <p class="lead">Update your menu item details and keep your offerings fresh</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card admin-menu-card">
                <div class="card-header admin-card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-utensils me-2"></i>Menu Item Details
                        </h4>
                        <!-- Stock Status Badge -->
                        <div class="stock-status-badge">
                            @if (Model.Stock == 0)
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-exclamation-circle me-1"></i>Out of Stock
                                </span>
                            }
                            else if (Model.Stock <= 5)
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-exclamation-triangle me-1"></i>Low Stock (@Model.Stock)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i>In Stock (@Model.Stock)
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="EditItem" asp-controller="AdminMenu" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="edit-item-form">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ImagePath" type="hidden" />

                        <div class="row">
                            <!-- Left Column -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label fw-bold">
                                        <i class="fas fa-tag me-1"></i>Item Name
                                    </label>
                                    <input asp-for="Name" class="form-control form-control-enhanced" placeholder="Enter item name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Category" class="form-label fw-bold">
                                        <i class="fas fa-list me-1"></i>Category
                                    </label>
                                    <select asp-for="Category" class="form-select form-control-enhanced">
                                        <option value="">-- Select Category --</option>
                                        <option value="Appetizers">Appetizers</option>
                                        <option value="Main Courses">Main Courses</option>
                                        <option value="Desserts">Desserts</option>
                                        <option value="Beverages">Beverages</option>
                                    </select>
                                    <span asp-validation-for="Category" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Price" class="form-label fw-bold">
                                                <i class="fas fa-peso-sign me-1"></i>Price (PHP)
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text price-symbol">P</span>
                                                <input asp-for="Price" class="form-control form-control-enhanced" type="number" step="0.01" min="0.01" placeholder="0.00" />
                                            </div>
                                            <span asp-validation-for="Price" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Stock" class="form-label fw-bold">
                                                <i class="fas fa-boxes me-1"></i>Stock Quantity
                                            </label>
                                            <div class="stock-input-group">
                                                <input asp-for="Stock" class="form-control form-control-enhanced stock-input" type="number" min="0" placeholder="0" onchange="updateStockPreview(this.value)" />
                                                <div class="stock-quick-actions">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="adjustStock(-10)">-10</button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="adjustStock(-5)">-5</button>
                                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="adjustStock(5)">+5</button>
                                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="adjustStock(10)">+10</button>
                                                </div>
                                            </div>
                                            <span asp-validation-for="Stock" class="text-danger"></span>
                                            <div class="form-text">
                                                <i class="fas fa-info-circle me-1"></i>
                                                <span id="stock-preview-text">
                                                    Current: @Model.Stock items available for ordering
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Active Status -->
                                <div class="mb-4">
                                    <div class="form-check-container">
                                        <input asp-for="IsActive" class="form-check-input form-check-enhanced" type="checkbox" />
                                        <label asp-for="IsActive" class="form-check-label fw-bold">
                                            <i class="fas fa-toggle-on me-1"></i>Active Status
                                        </label>
                                        <div class="form-text">Unchecking this will hide the item from customers</div>
                                    </div>

                                    <!-- Stock Warning Section -->
                                    <div class="stock-warnings mt-3" id="stock-warnings">
                                        @if (Model.Stock == 0)
                                        {
                                            <div class="alert alert-warning alert-sm">
                                                <i class="fas fa-exclamation-triangle me-2"></i>
                                                <strong>Warning:</strong> This item is out of stock. Consider restocking or setting it to inactive.
                                            </div>
                                        }
                                        else if (Model.Stock <= 5)
                                        {
                                            <div class="alert alert-info alert-sm">
                                                <i class="fas fa-info-circle me-2"></i>
                                                <strong>Notice:</strong> Low stock level. Consider restocking soon.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column -->
                            <div class="col-md-6">
                                <!-- Current Image Display -->
                                <div class="mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-image me-1"></i>Current Image
                                    </label>
                                    <div class="current-image-container">
                                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                                        {
                                            <img src="@Model.ImagePath" alt="Current Image" class="current-image" id="currentImage" />
                                            <div class="image-overlay">
                                                <button type="button" class="btn btn-sm btn-outline-light" onclick="toggleImageSize()">
                                                    <i class="fas fa-expand"></i> View Full Size
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="no-image-placeholder">
                                                <i class="fas fa-image"></i>
                                                <span>No image uploaded</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- New Image Upload -->
                                <div class="mb-3">
                                    <label asp-for="ImageFile" class="form-label fw-bold">
                                        <i class="fas fa-camera me-1"></i>Upload New Image
                                    </label>
                                    <div class="image-upload-container">
                                        <input asp-for="ImageFile" class="form-control form-control-enhanced" type="file" accept="image/*" onchange="previewNewImage(this)" id="imageInput" />
                                        <div class="upload-hint">
                                            <i class="fas fa-cloud-upload-alt"></i>
                                            <span>Upload JPG, PNG, or GIF (Max 5MB)</span>
                                            <small class="d-block mt-1">Leave blank to keep current image</small>
                                        </div>
                                    </div>
                                    <span asp-validation-for="ImageFile" class="text-danger"></span>

                                    <!-- New Image Preview -->
                                    <div id="newImagePreview" class="image-preview-container">
                                        <img id="newPreview" src="#" alt="New Preview" class="preview-image">
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-image" onclick="removeNewImage()">
                                            <i class="fas fa-times"></i> Remove
                                        </button>
                                    </div>
                                </div>

                                <!-- Stock Summary Card -->
                                <div class="stock-summary-card">
                                    <h6 class="stock-summary-title">
                                        <i class="fas fa-chart-line me-1"></i>Stock Information
                                    </h6>
                                    <div class="stock-summary-content">
                                        <div class="stock-summary-item">
                                            <span class="summary-label">Current Stock:</span>
                                            <span class="summary-value" id="current-stock-display">@Model.Stock</span>
                                        </div>
                                        <div class="stock-summary-item">
                                            <span class="summary-label">Status:</span>
                                            <span class="summary-value" id="stock-status-display">
                                                @(Model.Stock == 0 ? "Out of Stock" : Model.Stock <= 5 ? "Low Stock" : "In Stock")
                                            </span>
                                        </div>
                                        <div class="stock-summary-item">
                                            <span class="summary-label">Availability:</span>
                                            <span class="summary-value">
                                                @(Model.IsActive && Model.Stock > 0 ? "Available for Order" : "Not Available")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Description (Full Width) -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">
                                <i class="fas fa-align-left me-1"></i>Description
                            </label>
                            <textarea asp-for="Description" class="form-control form-control-enhanced" rows="4"
                                      placeholder="Enter a description for this menu item (optional)"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="form-actions">
                            <a href="@Url.Action("ViewItems", "AdminMenu")" class="btn btn-secondary btn-action">
                                <i class="fas fa-arrow-left me-2"></i>Back to Menu
                            </a>
                            <button type="submit" class="btn btn-admin-primary btn-action">
                                <i class="fas fa-save me-2"></i>Update Item
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/edit-item.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/edit-item.css" />
}