@model ASI.Basecode.Services.ServiceModels.MenuItemViewModel

@{
    ViewData["Title"] = "Edit Menu Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("ViewItems", "AdminMenu")">Menu Management</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit Item</li>
        </ol>
    </nav>

    <div class="page-header-section mb-4">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="page-main-title display-5 fw-bold">
                    <i class="fas fa-edit me-2"></i>Edit Menu Item
                </h1>
                <p class="page-subtitle text-muted mb-0">Update details for <strong>@Model.Name</strong></p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <div class="d-inline-block me-3">
                    @if (Model.Stock == 0)
                    {
                        <span class="status-badge badge-out-of-stock">
                            <i class="fas fa-exclamation-circle me-1"></i>Out of Stock
                        </span>
                    }
                    else if (Model.Stock <= 5)
                    {
                        <span class="status-badge badge-low-stock">
                            <i class="fas fa-exclamation-triangle me-1"></i>Low Stock (@Model.Stock)
                        </span>
                    }
                    else
                    {
                        <span class="status-badge badge-in-stock">
                            <i class="fas fa-check-circle me-1"></i>In Stock (@Model.Stock)
                        </span>
                    }
                </div>
                <a href="@Url.Action("ViewItems", "AdminMenu")" class="btn btn-outline-secondary btn-back">
                    <i class="fas fa-arrow-left me-2"></i>Back to Menu
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-10">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show modern-alert mb-4" role="alert">
                    <div class="d-flex align-items-start">
                        <div class="alert-icon me-3">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>
                        <div class="flex-grow-1">
                            <strong>Error!</strong> @TempData["ErrorMessage"]
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }

            <form asp-action="EditItem" asp-controller="AdminMenu" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="edit-item-form">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="ImagePath" type="hidden" />

                <div class="card form-card shadow-sm">
                    <div class="card-body p-4">
                        <div class="row g-4">

                            <div class="col-lg-7">
                                <div class="form-section mb-4">
                                    <h5 class="section-heading">
                                        <i class="fas fa-info-circle me-2"></i>Basic Information
                                    </h5>
                                    <div class="section-divider"></div>

                                    <div class="mb-3">
                                        <label asp-for="Name" class="form-label">
                                            <i class="fas fa-signature me-1"></i>Item Name <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="Name" class="form-control form-control-modern" placeholder="e.g., Margherita Pizza" />
                                        <span asp-validation-for="Name" class="text-danger small d-block mt-2"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Category" class="form-label">
                                            <i class="fas fa-list me-1"></i>Category <span class="text-danger">*</span>
                                        </label>
                                        <select asp-for="Category" class="form-select form-control-modern">
                                            <option value="">-- Select Category --</option>
                                            <option value="Appetizers">Appetizers</option>
                                            <option value="Main Courses">Main Courses</option>
                                            <option value="Desserts">Desserts</option>
                                            <option value="Beverages">Beverages</option>
                                        </select>
                                        <span asp-validation-for="Category" class="text-danger small d-block mt-2"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Description" class="form-label">
                                            <i class="fas fa-align-left me-1"></i>Description
                                        </label>
                                        <textarea asp-for="Description" class="form-control form-control-modern" rows="4" placeholder="Describe this menu item..."></textarea>
                                        <span asp-validation-for="Description" class="text-danger small d-block mt-2"></span>
                                    </div>
                                </div>

                                <div class="form-section mb-4">
                                    <h5 class="section-heading">
                                        <i class="fas fa-dollar-sign me-2"></i>Pricing
                                    </h5>
                                    <div class="section-divider"></div>

                                    <div class="mb-3">
                                        <label asp-for="Price" class="form-label">
                                            <i class="fas fa-tag me-1"></i>Price (PHP) <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group price-input-group">
                                            <span class="input-group-text price-symbol">₱</span>
                                            <input asp-for="Price" class="form-control form-control-modern no-spinner" type="number" step="0.01" min="0.01" placeholder="0.00" />
                                        </div>
                                        <span asp-validation-for="Price" class="text-danger small d-block mt-2"></span>
                                    </div>
                                </div>

                                <div class="form-section mb-4">
                                    <h5 class="section-heading">
                                        <i class="fas fa-boxes me-2"></i>Inventory Management
                                    </h5>
                                    <div class="section-divider"></div>

                                    <div class="mb-3">
                                        <label asp-for="Stock" class="form-label">
                                            <i class="fas fa-warehouse me-1"></i>Current Stock <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="Stock" class="form-control form-control-modern stock-input-main" type="number" min="0" placeholder="0" id="Stock" onchange="updateStockPreview(this.value)" />
                                        <span asp-validation-for="Stock" class="text-danger small d-block mt-2"></span>

                                        <div class="stock-quick-adjust mt-2">
                                            <span class="small text-muted me-2">Quick adjust:</span>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="adjustStock(-10)"><i class="fas fa-minus"></i> 10</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="adjustStock(-5)"><i class="fas fa-minus"></i> 5</button>
                                            <button type="button" class="btn btn-sm btn-outline-success" onclick="adjustStock(5)"><i class="fas fa-plus"></i> 5</button>
                                            <button type="button" class="btn btn-sm btn-outline-success" onclick="adjustStock(10)"><i class="fas fa-plus"></i> 10</button>
                                        </div>

                                        <div class="form-text small mt-2" id="stock-preview-text">
                                            <i class="fas fa-info-circle me-1"></i>
                                            Current: @Model.Stock items available for ordering
                                        </div>
                                    </div>

                                    <div class="stock-info-card">
                                        <div class="stock-info-row">
                                            <span class="stock-info-label">Current Stock:</span>
                                            <span class="stock-info-value" id="current-stock-display">@Model.Stock</span>
                                        </div>
                                        <div class="stock-info-row">
                                            <span class="stock-info-label">Status:</span>
                                            <span class="stock-info-value" id="stock-status-display">
                                                @(Model.Stock == 0 ? "Out of Stock" : Model.Stock <= 5 ? "Low Stock" : "In Stock")
                                            </span>
                                        </div>
                                        <div class="stock-info-row">
                                            <span class="stock-info-label">Availability:</span>
                                            <span class="stock-info-value">
                                                @(Model.IsActive && Model.Stock > 0 ? "Available for Order" : "Not Available")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-section">
                                    <h5 class="section-heading">
                                        <i class="fas fa-toggle-on me-2"></i>Visibility Settings
                                    </h5>
                                    <div class="section-divider"></div>

                                    <div class="form-check-modern">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                                        <label asp-for="IsActive" class="form-check-label" for="isActiveCheck">
                                            <strong>Active Status</strong>
                                            <span class="d-block small text-muted mt-1">Item is visible to customers and available for ordering</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-5">
                                <div class="form-section h-100">
                                    <h5 class="section-heading">
                                        <i class="fas fa-camera me-2"></i>Product Images
                                    </h5>
                                    <div class="section-divider"></div>

                                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                                    {
                                        <div class="current-image-section mb-4">
                                            <label class="form-label small text-muted mb-2">Current Image</label>
                                            <div class="current-image-display">
                                                <img src="@Model.ImagePath" alt="Current Image" class="current-image-preview" id="currentImage" />
                                                <button type="button" class="btn-view-full" onclick="toggleImageSize()" title="View full size">
                                                    <i class="fas fa-search-plus"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="no-image-display mb-4">
                                            <div class="no-image-icon">
                                                <i class="fas fa-image"></i>
                                            </div>
                                            <p class="no-image-text">No image uploaded yet</p>
                                        </div>
                                    }

                                    <div class="upload-new-section">
                                        <label asp-for="ImageFile" class="form-label">
                                            <i class="fas fa-upload me-1"></i>Upload New Image
                                        </label>

                                        <div class="image-upload-zone compact" id="uploadZone" onclick="document.getElementById('imageInput').click();">
                                            <input asp-for="ImageFile" class="d-none" type="file" accept="image/*" onchange="previewNewImage(this)" id="imageInput" />
                                            <div class="upload-placeholder">
                                                <div class="upload-icon-sm">
                                                    <i class="fas fa-cloud-upload-alt"></i>
                                                </div>
                                                <p class="upload-text-sm mb-1">Click to upload or drag & drop</p>
                                                <p class="upload-hint-sm mb-0">JPG, PNG or GIF (MAX. 5MB)</p>
                                            </div>
                                        </div>
                                        <span asp-validation-for="ImageFile" class="text-danger small d-block mt-2"></span>
                                        <div class="form-text small mt-2">
                                            <i class="fas fa-info-circle me-1"></i>Leave blank to keep current image
                                        </div>

                                        <div id="newImagePreview" class="image-preview-box new-image" style="display: none;">
                                            <button type="button" class="btn-remove-preview" onclick="removeNewImage()" title="Remove new image">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            <img id="newPreview" src="#" alt="New Preview" class="preview-img">
                                            <div class="preview-overlay new">
                                                <p class="mb-0 small text-white fw-bold text-shadow">
                                                    <i class="fas fa-sync-alt me-1"></i>New image will replace current one
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="card-footer form-footer">
                        <div class="row align-items-center">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <p class="mb-0 text-muted small">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <span class="text-danger">*</span> Required fields
                                </p>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <a href="@Url.Action("ViewItems", "AdminMenu")" class="btn btn-secondary btn-action me-2">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-primary-custom btn-action">
                                    <i class="fas fa-save me-2"></i>Update Item
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

<div class="image-backdrop" onclick="closeFullSizeImage()"></div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/edit-item.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/edit-item.css?v=5.0" />
}