@model ASI.Basecode.Services.ServiceModels.MenuItemViewModel

@{
    ViewData["Title"] = "Add Menu Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("ViewItems", "AdminMenu")">Menu Management</a></li>
            <li class="breadcrumb-item active" aria-current="page">Add New Item</li>
        </ol>
    </nav>

    <div class="page-header-section mb-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="page-main-title">
                    <i class="fas fa-plus-circle me-2"></i>Add New Menu Item
                </h1>
                <p class="page-subtitle mb-0">Create a new item for your restaurant menu</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a href="@Url.Action("ViewItems", "AdminMenu")" class="btn btn-outline-secondary btn-back">
                    <i class="fas fa-arrow-left me-2"></i>Back to Menu
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-10">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show modern-alert mb-4" role="alert">
                    <div class="d-flex align-items-start">
                        <div class="alert-icon me-3">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>
                        <div class="flex-grow-1">
                            <strong>Error!</strong> @TempData["ErrorMessage"]
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }

            <form asp-action="AddItem" asp-controller="AdminMenu" method="post" enctype="multipart/form-data" class="add-item-form">
                @Html.AntiForgeryToken()

                <div class="card form-card shadow-sm">
                    <div class="card-body p-4">
                        <div class="row g-4">

                            <div class="col-lg-7">
                                <div class="form-section mb-4">
                                    <h5 class="section-heading">
                                        <i class="fas fa-info-circle me-2"></i>Basic Information
                                    </h5>
                                    <div class="section-divider"></div>

                                    <div class="mb-3">
                                        <label asp-for="Name" class="form-label">
                                            <i class="fas fa-signature me-1"></i>Item Name <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="Name" class="form-control form-control-modern" placeholder="e.g., Margherita Pizza" />
                                        <span asp-validation-for="Name" class="text-danger small d-block mt-2"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Category" class="form-label">
                                            <i class="fas fa-list me-1"></i>Category <span class="text-danger">*</span>
                                        </label>
                                        <select asp-for="Category" class="form-select form-control-modern">
                                            <option value="">-- Select Category --</option>
                                            <option value="Appetizers">Appetizers</option>
                                            <option value="Main Courses">Main Courses</option>
                                            <option value="Desserts">Desserts</option>
                                            <option value="Beverages">Beverages</option>
                                        </select>
                                        <span asp-validation-for="Category" class="text-danger small d-block mt-2"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Description" class="form-label">
                                            <i class="fas fa-align-left me-1"></i>Description
                                        </label>
                                        <textarea asp-for="Description" class="form-control form-control-modern" rows="4"
                                                  placeholder="Describe ingredients, taste, special features..."></textarea>
                                        <span asp-validation-for="Description" class="text-danger small d-block mt-2"></span>
                                        <div class="form-text small">
                                            <i class="fas fa-lightbulb me-1"></i>Provide a compelling description to attract customers
                                        </div>
                                    </div>
                                </div>

                                <div class="form-section">
                                    <h5 class="section-heading">
                                        <i class="fas fa-dollar-sign me-2"></i>Pricing & Inventory
                                    </h5>
                                    <div class="section-divider"></div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label asp-for="Price" class="form-label">
                                                <i class="fas fa-tag me-1"></i>Price (PHP) <span class="text-danger">*</span>
                                            </label>

                                            <div class="price-input-group">
                                                <span class="price-symbol">₱</span>
                                                <input asp-for="Price" class="form-control form-control-modern no-spinner" type="number" step="0.01" min="0.01" placeholder="0.00" />
                                            </div>

                                            <span asp-validation-for="Price" class="text-danger small d-block mt-2"></span>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label asp-for="Stock" class="form-label">
                                                <i class="fas fa-boxes me-1"></i>Initial Stock <span class="text-danger">*</span>
                                            </label>
                                            <input asp-for="Stock" class="form-control form-control-modern no-spinner" type="number" min="0" placeholder="0" />
                                            <span asp-validation-for="Stock" class="text-danger small d-block mt-2"></span>
                                            <div class="form-text small">
                                                <i class="fas fa-info-circle me-1"></i>Number of items available
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-5">
                                <div class="form-section h-100">
                                    <h5 class="section-heading">
                                        <i class="fas fa-camera me-2"></i>Product Image
                                    </h5>
                                    <div class="section-divider"></div>

                                    <div class="mb-3">
                                        <div class="image-upload-zone" id="uploadZone" onclick="document.getElementById('imageInput').click();">
                                            <input asp-for="ImageFile" class="d-none" type="file" accept="image/*" onchange="previewImage(this)" id="imageInput" />

                                            <div class="upload-placeholder text-center p-4">
                                                <div class="upload-icon mb-3">
                                                    <i class="fas fa-cloud-upload-alt"></i>
                                                </div>
                                                <p class="upload-text mb-1"><strong>Click to upload</strong> or drag and drop</p>
                                                <p class="upload-hint text-muted small">JPG, PNG or GIF (MAX. 5MB)</p>
                                            </div>
                                        </div>
                                        <span asp-validation-for="ImageFile" class="text-danger small d-block mt-2"></span>

                                        <div id="imagePreview" class="image-preview-box d-none text-center mt-3 position-relative">
                                            <img id="preview" src="#" alt="Preview" class="preview-img">
                                            <button type="button" class="btn-remove-preview" onclick="removeImage(event)">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            <div class="preview-overlay">
                                                <p class="mb-0 small text-white"><i class="fas fa-check-circle me-1"></i>Image ready to upload</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="upload-instructions mb-3">
                                        <div class="instruction-item">
                                            <i class="fas fa-check-circle text-success me-2"></i>
                                            <span>Accepted formats: JPG, PNG, GIF</span>
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fas fa-check-circle text-success me-2"></i>
                                            <span>Maximum size: 5MB</span>
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fas fa-check-circle text-success me-2"></i>
                                            <span>Recommended: Square image (1:1)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="card-footer form-footer">
                        <div class="row align-items-center">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <p class="mb-0 text-muted small">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <span class="text-danger">*</span> Required fields
                                </p>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <a href="@Url.Action("ViewItems", "AdminMenu")" class="btn btn-secondary btn-action me-2">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-primary-custom btn-action">
                                    <i class="fas fa-plus-circle me-2"></i>Add Item
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/add-item.js"></script>
    <script>
        // Simple script to handle preview logic inside the view
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('preview').src = e.target.result;
                    document.querySelector('.upload-placeholder').parentElement.classList.add('d-none');
                    document.getElementById('imagePreview').classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function removeImage(event) {
            if(event) event.stopPropagation();
            document.getElementById('imageInput').value = "";
            document.querySelector('.upload-placeholder').parentElement.classList.remove('d-none');
            document.getElementById('imagePreview').classList.add('d-none');
        }
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/add-item.css" />
}