@model ASI.Basecode.Services.ServiceModels.MenuItemViewModel

@{
    ViewData["Title"] = "Add Menu Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="admin-menu-header text-center mb-4">
        <h1 class="display-5 fw-bold"><i class="fas fa-plus-circle me-3"></i>Add New Menu Item</h1>
        <p class="lead">Add a delicious new item to your restaurant menu</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card admin-menu-card">
                <div class="card-header admin-card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-utensils me-2"></i>Menu Item Details
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="AddItem" asp-controller="AdminMenu" method="post" enctype="multipart/form-data" class="add-item-form">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <!-- Left Column -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label fw-bold">
                                        <i class="fas fa-tag me-1"></i>Item Name
                                    </label>
                                    <input asp-for="Name" class="form-control form-control-enhanced" placeholder="Enter item name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Category" class="form-label fw-bold">
                                        <i class="fas fa-list me-1"></i>Category
                                    </label>
                                    <select asp-for="Category" class="form-select form-control-enhanced">
                                        <option value="">-- Select Category --</option>
                                        <option value="Appetizers">Appetizers</option>
                                        <option value="Main Courses">Main Courses</option>
                                        <option value="Desserts">Desserts</option>
                                        <option value="Beverages">Beverages</option>
                                    </select>
                                    <span asp-validation-for="Category" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Price" class="form-label fw-bold">
                                                <i class="fas fa-peso-sign me-1"></i>Price (PHP)
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text price-symbol">P</span>
                                                <input asp-for="Price" class="form-control form-control-enhanced" type="number" step="0.01" min="0.01" placeholder="0.00" />
                                            </div>
                                            <span asp-validation-for="Price" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Stock" class="form-label fw-bold">
                                                <i class="fas fa-boxes me-1"></i>Stock Quantity
                                            </label>
                                            <input asp-for="Stock" class="form-control form-control-enhanced" type="number" min="0" placeholder="0" />
                                            <span asp-validation-for="Stock" class="text-danger"></span>
                                            <div class="form-text">
                                                <i class="fas fa-info-circle me-1"></i>
                                                Number of items available for ordering
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column -->
                            <div class="col-md-6">
                                <!-- Image Upload Section -->
                                <div class="mb-3">
                                    <label asp-for="ImageFile" class="form-label fw-bold">
                                        <i class="fas fa-camera me-1"></i>Food Image
                                    </label>
                                    <div class="image-upload-container">
                                        <input asp-for="ImageFile" class="form-control form-control-enhanced" type="file" accept="image/*" onchange="previewImage(this)" id="imageInput" />
                                        <div class="upload-hint">
                                            <i class="fas fa-cloud-upload-alt"></i>
                                            <span>Upload JPG, PNG, or GIF (Max 5MB)</span>
                                        </div>
                                    </div>
                                    <span asp-validation-for="ImageFile" class="text-danger"></span>

                                    <!-- Image Preview -->
                                    <div id="imagePreview" class="image-preview-container">
                                        <img id="preview" src="#" alt="Preview" class="preview-image">
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-image" onclick="removeImage()">
                                            <i class="fas fa-times"></i> Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Description (Full Width) -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">
                                <i class="fas fa-align-left me-1"></i>Description
                            </label>
                            <textarea asp-for="Description" class="form-control form-control-enhanced" rows="4"
                                      placeholder="Enter a description for this menu item (optional)"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="form-actions">
                            <a href="@Url.Action("ViewItems", "AdminMenu")" class="btn btn-secondary btn-action">
                                <i class="fas fa-arrow-left me-2"></i>Back to Menu
                            </a>
                            <button type="submit" class="btn btn-admin-primary btn-action">
                                <i class="fas fa-save me-2"></i>Add Item
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/add-item.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/add-item.css" />
}