@model IEnumerable<ASI.Basecode.Services.ServiceModels.MenuItemViewModel>

@{
    ViewData["Title"] = "Menu Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userName = Context.Session.GetString("UserName");
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="admin-menu-header text-center mb-4">
        <h1 class="display-5 fw-bold"><i class="fas fa-utensils me-3"></i>Menu Management</h1>
        <p class="lead">Manage your restaurant's menu items efficiently</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card admin-menu-card">
                <div class="card-header admin-card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-list me-2"></i>Menu Items (<span id="itemCount">@Model.Count()</span> total)
                        </h4>
                        <a href="@Url.Action("AddItem", "AdminMenu")" class="btn btn-admin-primary">
                            <i class="fas fa-plus me-2"></i>Add New Item
                        </a>
                    </div>
                </div>

                <!-- Search and Filter Section -->
                <div class="card-body border-bottom">
                    <div class="row g-3">
                        <!-- Search Bar -->
                        <div class="col-md-6">
                            <div class="search-container">
                                <i class="fas fa-search search-icon"></i>
                                <input type="text" id="searchInput" class="form-control search-input" placeholder="Search by name or description...">
                                <button type="button" id="clearSearch" class="btn btn-sm btn-outline-secondary clear-btn" style="display: none;">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Category Filter -->
                        <div class="col-md-3">
                            <select id="categoryFilter" class="form-select">
                                <option value="all">All Categories</option>
                                @foreach (var category in Model.Select(x => x.Category).Distinct().OrderBy(x => x))
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </div>

                        <!-- Status Filter -->
                        <div class="col-md-3">
                            <select id="statusFilter" class="form-select">
                                <option value="all">All Status</option>
                                <option value="active">Active Only</option>
                                <option value="inactive">Inactive Only</option>
                            </select>
                        </div>
                    </div>

                    <!-- Filter Results Info -->
                    <div id="filterInfo" class="filter-info mt-2" style="display: none;">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Showing <span id="visibleCount">0</span> of @Model.Count() items
                        </small>
                        <button type="button" id="clearFilters" class="btn btn-sm btn-link p-0 ms-2">
                            Clear all filters
                        </button>
                    </div>
                </div>

                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover admin-table mb-0">
                                <thead class="admin-table-header">
                                    <tr>
                                        <th class="text-center" width="80">Image</th>
                                        <th>Name</th>
                                        <th width="120">Category</th>
                                        <th width="100">Price</th>
                                        <th>Description</th>
                                        <th width="100" class="text-center">Status</th>
                                        <th width="120" class="text-center">Actions</th>
                                        <th width="100" class="text-center">Stock</th>
                                    </tr>
                                </thead>
                                <tbody id="menuItemsTable">
                                    @foreach (var item in Model)
                                    {
                                        <tr class="admin-table-row menu-item-row"
                                            data-name="@item.Name.ToLower()"
                                            data-category="@item.Category"
                                            data-description="@(item.Description?.ToLower() ?? "")"
                                            data-status="@(item.IsActive ? "active" : "inactive")">
                                            <td class="text-center">
                                                <div class="menu-image-container">
                                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                                    {
                                                        <img src="@item.ImagePath" alt="@item.Name" class="menu-item-img">
                                                    }
                                                    else
                                                    {
                                                        <div class="menu-placeholder">
                                                            <i class="fas fa-image"></i>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="item-name">@item.Name</div>
                                            </td>
                                            <td>
                                                <span class="category-badge">@item.Category</span>
                                            </td>
                                            <td>
                                                <span class="price-text">@("P" + item.Price.ToString("F2"))</span>
                                            </td>
                                            <td>
                                                <div class="description-text">
                                                    @(string.IsNullOrEmpty(item.Description) ? "No description" : item.Description)
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                @if (item.IsActive)
                                                {
                                                    <span class="status-badge active">
                                                        <i class="fas fa-check-circle"></i> Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge inactive">
                                                        <i class="fas fa-pause-circle"></i> Inactive
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="stock-info">
                                                    <span class="stock-number @(item.Stock == 0 ? "text-danger" : item.Stock <= 5 ? "text-warning" : "text-success")">
                                                        @item.Stock
                                                    </span>
                                                    <div class="stock-status">
                                                        @if (item.Stock == 0)
                                                        {
                                                            <span class="badge bg-danger">Out of Stock</span>
                                                        }
                                                        else if (item.Stock <= 5)
                                                        {
                                                            <span class="badge bg-warning">Low Stock</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success">In Stock</span>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="action-buttons">
                                                    <a href="@Url.Action("EditItem", "AdminMenu", new { id = item.Id })"
                                                       class="btn btn-sm btn-edit" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    @if (item.IsActive)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-delete"
                                                                onclick="confirmDelete(@item.Id, '@item.Name')" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>

                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- No Results Message -->
                        <div id="noResults" class="no-results" style="display: none;">
                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No items found</h5>
                            <p class="text-muted">Try adjusting your search or filter criteria.</p>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-utensils fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No menu items found</h5>
                            <p class="text-muted">Get started by adding your first menu item.</p>
                            <a href="@Url.Action("AddItem", "AdminMenu")" class="btn btn-admin-primary">
                                <i class="fas fa-plus me-2"></i>Add First Item
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Simple Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="itemName"></strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-menu.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-menu.css" />
}