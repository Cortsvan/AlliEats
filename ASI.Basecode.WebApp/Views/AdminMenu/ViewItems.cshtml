@model IEnumerable<ASI.Basecode.Services.ServiceModels.MenuItemViewModel>

@{
    ViewData["Title"] = "Menu Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userName = Context.Session.GetString("UserName");
}

<style>
    body {
        font-family: Georgia, serif;
        background-color: #FFF3E0; /* Secondary */
        color: #212121; /* Text */
    }

    .custom-card-bg {
        background-color: white;
        border: 1px solid rgba(255, 243, 224, 0.5);
        border-radius: 1rem;
        box-shadow: 0 4px 12px -2px rgba(93, 64, 55, 0.1), 0 2px 4px -2px rgba(93, 64, 55, 0.05);
    }

    .btn-accent-orange {
        background-color: #5D4037; /* Primary */
        border-color: #5D4037;
        color: white;
    }

        .btn-accent-orange:hover {
            opacity: 0.9;
        }

    .text-deep-maroon {
        color: #5D4037 !important; /* Primary */
    }

    .text-price-accent {
        color: #FFD54F !important; /* Accent */
    }

    .badge-category {
        background-color: rgba(93, 64, 55, 0.1);
        color: #5D4037;
        font-weight: 500;
    }

    .table thead {
        background-color: #5D4037; /* Deep Maroon */
        color: white;
    }

    .table tbody tr:hover {
        background-color: rgba(93, 64, 55, 0.05);
    }

    .btn-outline-primary {
        border-color: #5D4037;
        color: #5D4037;
    }

        .btn-outline-primary:hover {
            background-color: rgba(93, 64, 55, 0.1);
        }

    .btn-outline-danger {
        border-color: #D32F2F;
        color: #D32F2F;
    }

        .btn-outline-danger:hover {
            background-color: rgba(211, 47, 47, 0.1);
        }

    .alert-primary {
        background-color: #FFF3E0;
        color: #5D4037;
        border: 1px solid rgba(93, 64, 55, 0.3);
    }

        .alert-primary.d-flex {
            gap: 1.2rem; /* space between icon and text */
        }

</style>

<div class="container-fluid px-4">
    <!-- Admin Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-primary border-0 shadow-sm d-flex align-items-center">
                <div class="me-3">
                    <i class="fas fa-user-shield fa-2x text-deep-maroon"></i>
                </div>
                <div>
                    <h4 class="alert-heading mb-1 text-deep-maroon">Hello Admin</h4>
                    <p class="mb-0"> Welcome to the AlliEats Admin Dashboard. Manage your menu items and monitor your restaurant.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Menu Management Table -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card custom-card-bg">
                <div class="card-header d-flex justify-content-between align-items-center" style="background-color: #5D4037; color: white; border-bottom: 0;">
                    <h4 class="mb-0"><i class="fas fa-utensils me-2"></i> Menu Management</h4>
                    <a href="@Url.Action("AddItem", "AdminMenu")" class="btn btn-accent-orange">
                        <i class="fas fa-plus me-2"></i> Add New Item
                    </a>
                </div>
                <div class="card-body p-4">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Description</th>
                                        <th>Status</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="fw-bold text-deep-maroon">@item.Name</td>
                                            <td>
                                                <span class="badge badge-category">@item.Category</span>
                                            </td>
                                            <td class="fw-bold text-price-accent">$@item.Price.ToString("F2")</td>
                                            <td>@(string.IsNullOrEmpty(item.Description) ? "No description" : item.Description)</td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success"> Active </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary"> Inactive </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("EditItem", "AdminMenu", new { id = item.Id })" class="btn btn-sm btn-outline-primary">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    @if (item.IsActive)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                                onclick="confirmDelete(@item.Id, '@item.Name')">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-utensils fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted"> No menu items found </h5>
                            <p class="text-muted"> Get started by adding your first menu item. </p>
                            <a href="@Url.Action("AddItem", "AdminMenu")" class="btn btn-accent-orange">
                                <i class="fas fa-plus me-2"></i> Add First Item
                            </a>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content custom-card-bg shadow-lg p-3">
            <div class="modal-header" style="background-color: #D32F2F; border-bottom: 0; position: relative;">
                <h5 class="modal-title text-white" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i> Confirm Deletion
                </h5>
                <button type="button" class="btn" data-bs-dismiss="modal" aria-label="Close"
                        style="position: absolute; top: 10px; right: 10px; background-color: white; color: #D32F2F; border-radius: 50%; width: 2rem; height: 2rem; display: flex; align-items: center; justify-content: center; font-weight: bold; box-shadow: 0 2px 6px rgba(0,0,0,0.3);">
                    &times;
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="itemName"></strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-accent-orange">
                        <i class="fas fa-trash me-2"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(itemId, itemName) {
            document.getElementById('itemName').textContent = itemName;
            document.getElementById('deleteForm').action = '@Url.Action("DeleteItem", "AdminMenu")/' + itemId;
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }
    </script>
}
