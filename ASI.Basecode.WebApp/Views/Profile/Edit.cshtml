@model ASI.Basecode.Services.ServiceModels.ProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="profile-edit-header text-center">
        <h1 class="display-5 fw-bold"><i class="fas fa-edit me-3"></i>Edit Profile</h1>
        <p class="lead">Update your personal information and delivery preferences</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <form asp-action="Edit" method="post" id="profileEditForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <div class="row">
                    <!-- Personal Information Section -->
                    <div class="col-lg-6">
                        <div class="card shadow-sm profile-section-card mb-4">
                            <div class="card-body">
                                <h5 class="section-title">
                                    <i class="fas fa-user me-2"></i>Personal Information
                                </h5>

                                <div class="form-group mb-3">
                                    <label asp-for="Name" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                                        <input asp-for="Name" class="form-control" placeholder="Enter your full name" />
                                    </div>
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Phone" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                        <input asp-for="Phone" class="form-control" placeholder="e.g., +1 (555) 123-4567" />
                                    </div>
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="DateOfBirth" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                                        <input asp-for="DateOfBirth" class="form-control" type="date" />
                                    </div>
                                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label class="form-label">Email Address</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                        <input type="email" value="@Model.UserId" class="form-control" readonly />
                                    </div>
                                    <small class="form-text text-muted">
                                        <i class="fas fa-info-circle me-1"></i>Email cannot be changed
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Address Information Section -->
                    <div class="col-lg-6">
                        <div class="card shadow-sm profile-section-card mb-4">
                            <div class="card-body">
                                <h5 class="section-title">
                                    <i class="fas fa-map-marker-alt me-2"></i>Address Information
                                </h5>

                                <div class="form-group mb-3">
                                    <label asp-for="Address" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-home"></i></span>
                                        <input asp-for="Address" class="form-control" placeholder="Street address, apartment, suite, etc." />
                                    </div>
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="form-group mb-3">
                                            <label asp-for="City" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fas fa-city"></i></span>
                                                <input asp-for="City" class="form-control" placeholder="Enter city" />
                                            </div>
                                            <span asp-validation-for="City" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mb-3">
                                            <label asp-for="PostalCode" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fas fa-mail-bulk"></i></span>
                                                <input asp-for="PostalCode" class="form-control" placeholder="ZIP" />
                                            </div>
                                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Delivery Preferences Section -->
                    <div class="col-12">
                        <div class="card shadow-sm profile-section-card mb-4">
                            <div class="card-body">
                                <h5 class="section-title">
                                    <i class="fas fa-truck me-2"></i>Delivery Preferences
                                </h5>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="PreferredDeliveryAddress" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fas fa-map-pin"></i></span>
                                                <input asp-for="PreferredDeliveryAddress" class="form-control" placeholder="If different from your address above" />
                                            </div>
                                            <span asp-validation-for="PreferredDeliveryAddress" class="text-danger"></span>
                                            <small class="form-text text-muted">Leave blank to use your address above</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="DeliveryInstructions" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fas fa-sticky-note"></i></span>
                                                <textarea asp-for="DeliveryInstructions" class="form-control" rows="3"
                                                          placeholder="e.g., Leave at door, Ring doorbell, Call upon arrival"></textarea>
                                            </div>
                                            <span asp-validation-for="DeliveryInstructions" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-12">
                        <div class="form-actions text-center">
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary me-3">
                                <i class="fas fa-arrow-left me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-checkout" id="saveBtn">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/profile-edit.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile-edit.css" />
}