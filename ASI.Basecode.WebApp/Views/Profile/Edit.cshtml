@model ASI.Basecode.Services.ServiceModels.ProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="profile-header text-center">
        <h1 class="display-5 fw-bold"><i class="fas fa-edit me-3"></i>Edit Profile</h1>
        <p class="lead">Update your personal information and delivery preferences</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["MissingDeliveryInfo"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-truck me-2"></i>
            <strong>Complete your delivery information:</strong> Missing fields - @TempData["MissingDeliveryInfo"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Edit" method="post" class="profile-edit-form">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserId)

        <div class="row">
            <!-- Personal Information -->
            <div class="col-lg-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h4 class="card-title mb-4">
                            <i class="fas fa-user me-2"></i>Personal Information
                        </h4>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter your full name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input value="@Model.UserId" class="form-control" readonly />
                            <div class="form-text">Email cannot be changed</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="e.g., +63 912 345 6789" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                            <div class="form-text">Required for delivery coordination</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Address Information -->
            <div class="col-lg-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h4 class="card-title mb-4">
                            <i class="fas fa-map-marker-alt me-2"></i>Address Information
                        </h4>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Street Address <span class="text-danger">*</span></label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter your complete address"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                            <div class="form-text">Required for delivery</div>
                        </div>

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="City" class="form-label">City <span class="text-danger">*</span></label>
                                    <input asp-for="City" class="form-control" placeholder="Enter your city" />
                                    <span asp-validation-for="City" class="text-danger"></span>
                                    <div class="form-text">Required for delivery</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="PostalCode" class="form-label">Postal Code</label>
                                    <input asp-for="PostalCode" class="form-control" placeholder="e.g., 1234" />
                                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delivery Preferences -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h4 class="card-title mb-4">
                            <i class="fas fa-truck me-2"></i>Delivery Preferences
                        </h4>

                        <div class="mb-3">
                            <label asp-for="PreferredDeliveryAddress" class="form-label">Preferred Delivery Address</label>
                            <textarea asp-for="PreferredDeliveryAddress" class="form-control" rows="2"
                                      placeholder="If different from your address above, specify preferred delivery location"></textarea>
                            <span asp-validation-for="PreferredDeliveryAddress" class="text-danger"></span>
                            <div class="form-text">Leave empty to use your main address</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DeliveryInstructions" class="form-label">Delivery Instructions</label>
                            <textarea asp-for="DeliveryInstructions" class="form-control" rows="3"
                                      placeholder="Special instructions for delivery (e.g., security code, landmarks, contact person)"></textarea>
                            <span asp-validation-for="DeliveryInstructions" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Profile
                    </a>
                    <button type="submit" class="btn btn-checkout">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/profile.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" />
}