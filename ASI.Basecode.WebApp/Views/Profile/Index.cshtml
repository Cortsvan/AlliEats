@model ASI.Basecode.Services.ServiceModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-primary border-0 shadow-sm">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <i class="fas fa-user fa-2x text-primary"></i>
                    </div>
                    <div>
                        <h4 class="alert-heading mb-1">My Profile</h4>
                        <p class="mb-0">Manage your personal information and delivery preferences</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <!-- Profile Information Card -->
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-user me-2"></i>Profile Information
                        </h5>
                        <a href="@Url.Action("Edit")" class="btn btn-light btn-sm">
                            <i class="fas fa-edit me-2"></i>Edit Profile
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong>Full Name:</strong>
                            <div class="text-muted">@Model.Name</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Email:</strong>
                            <div class="text-muted">@Model.UserId</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Phone:</strong>
                            <div class="text-muted">@(string.IsNullOrEmpty(Model.Phone) ? "Not provided" : Model.Phone)</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Date of Birth:</strong>
                            <div class="text-muted">@(Model.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not provided")</div>
                        </div>
                        <div class="col-12 mb-3">
                            <strong>Address:</strong>
                            <div class="text-muted">
                                @if (!string.IsNullOrEmpty(Model.Address))
                                {
                                    @Model.Address
                                    @if (!string.IsNullOrEmpty(Model.City))
                                    {
                                        <br />
                                        @Model.City
                                        @if (!string.IsNullOrEmpty(Model.PostalCode))
                                        {
                                            @Model.PostalCode
                                        }
                                    }
                                }
                                else
                                {
                                    <text>Not provided</text>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delivery Preferences Card -->
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-truck me-2"></i>Delivery Preferences
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <strong>Preferred Delivery Address:</strong>
                            <div class="text-muted">@(string.IsNullOrEmpty(Model.PreferredDeliveryAddress) ? "Not set" : Model.PreferredDeliveryAddress)</div>
                        </div>
                        <div class="col-12">
                            <strong>Delivery Instructions:</strong>
                            <div class="text-muted">@(string.IsNullOrEmpty(Model.DeliveryInstructions) ? "No special instructions" : Model.DeliveryInstructions)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Profile Completion Card -->
            <div class="card shadow mb-4">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">Profile Completion</h6>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        <div class="progress" style="height: 12px;">
                            <div class="progress-bar bg-success" style="width: @Model.ProfileCompletionPercentage%"></div>
                        </div>
                        <small class="text-muted mt-2 d-block">@Model.ProfileCompletionPercentage% Complete</small>
                    </div>
                    @if (!Model.IsProfileComplete)
                    {
                        <p class="text-muted small">Complete your profile to get better delivery experience!</p>
                        <a href="@Url.Action("Edit")" class="btn btn-info btn-sm">
                            <i class="fas fa-plus me-2"></i>Complete Profile
                        </a>
                    }
                    else
                    {
                        <p class="text-success small">
                            <i class="fas fa-check-circle me-1"></i>Profile Complete!
                        </p>
                    }
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-history me-2"></i>Order History
                        </a>
                        <a href="@Url.Action("ViewCart", "Cart")" class="btn btn-outline-success btn-sm">
                            <i class="fas fa-shopping-cart me-2"></i>My Cart
                        </a>
                        <a href="@Url.Action("Browse", "Menu")" class="btn btn-outline-info btn-sm">
                            <i class="fas fa-utensils me-2"></i>Browse Menu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>