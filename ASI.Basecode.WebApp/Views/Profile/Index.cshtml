@model ASI.Basecode.Services.ServiceModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="profile-header text-center">
        <h1 class="display-5 fw-bold"><i class="fas fa-user me-3"></i>My Profile</h1>
        <p class="lead">Manage your personal information and delivery preferences</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Profile Information -->
        <div class="col-lg-8">
            <!-- Profile Information Card -->
            <div class="card shadow-sm profile-info-card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="card-title mb-0">
                            <i class="fas fa-user me-2"></i>Profile Information
                        </h4>
                        <a href="@Url.Action("Edit")" class="btn btn-checkout">
                            <i class="fas fa-edit me-2"></i>Edit Profile
                        </a>
                    </div>

                    <div class="profile-info-grid">
                        <div class="profile-info-item">
                            <span class="profile-info-label">Full Name:</span>
                            <span class="profile-info-value">@Model.Name</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="profile-info-label">Email:</span>
                            <span class="profile-info-value">@Model.UserId</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="profile-info-label">Phone:</span>
                            <span class="profile-info-value">@(string.IsNullOrEmpty(Model.Phone) ? "Not provided" : Model.Phone)</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="profile-info-label">Date of Birth:</span>
                            <span class="profile-info-value">@(Model.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not provided")</span>
                        </div>
                        <div class="profile-info-item full-width">
                            <span class="profile-info-label">Address:</span>
                            <div class="profile-address">
                                @if (!string.IsNullOrEmpty(Model.Address))
                                {
                                    <div>@Model.Address</div>
                                    @if (!string.IsNullOrEmpty(Model.City))
                                    {
                                        <div>@Model.City @Model.PostalCode</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Not provided</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delivery Preferences Card -->
            <div class="card shadow-sm delivery-preferences-card">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="fas fa-truck me-2"></i>Delivery Preferences
                    </h5>

                    <div class="delivery-info">
                        <div class="delivery-info-item">
                            <span class="delivery-info-label">Preferred Delivery Address:</span>
                            <div class="delivery-info-value">
                                @(string.IsNullOrEmpty(Model.PreferredDeliveryAddress) ?
                                                                Html.Raw("<span class='text-muted'>Not set - Using your profile address</span>") :
                                                                Html.Raw(Model.PreferredDeliveryAddress))
                            </div>
                        </div>
                        <div class="delivery-info-item">
                            <span class="delivery-info-label">Delivery Instructions:</span>
                            <div class="delivery-info-value">
                                @(string.IsNullOrEmpty(Model.DeliveryInstructions) ?
                                                                Html.Raw("<span class='text-muted'>No special instructions</span>") :
                                                                Html.Raw(Model.DeliveryInstructions))
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Profile Completion Card -->
            <div class="card shadow-sm completion-card mb-4">
                <div class="card-body text-center">
                    <h6 class="card-title mb-3">
                        <i class="fas fa-chart-pie me-2"></i>Profile Completion
                    </h6>

                    <div class="completion-circle mb-3">
                        <div class="progress-ring">
                            <div class="progress-value">@Model.ProfileCompletionPercentage%</div>
                        </div>
                    </div>

                    <div class="progress mb-3" style="height: 8px;">
                        <div class="progress-bar" style="width: @Model.ProfileCompletionPercentage%"></div>
                    </div>

                    @if (!Model.IsProfileComplete)
                    {
                        <p class="text-muted small mb-3">Complete your profile to get better delivery experience!</p>
                        <a href="@Url.Action("Edit")" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-plus me-2"></i>Complete Profile
                        </a>
                    }
                    else
                    {
                        <p class="text-success small mb-0">
                            <i class="fas fa-check-circle me-1"></i>Profile Complete!
                        </p>
                    }
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="card shadow-sm quick-actions-card">
                <div class="card-body">
                    <h6 class="card-title mb-3">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h6>

                    <div class="quick-actions">
                        <a href="@Url.Action("MyOrders", "Order")" class="quick-action-btn">
                            <i class="fas fa-history"></i>
                            <span>Order History</span>
                        </a>
                        <a href="@Url.Action("ViewCart", "Cart")" class="quick-action-btn">
                            <i class="fas fa-shopping-cart"></i>
                            <span>My Cart</span>
                        </a>
                        <a href="@Url.Action("Browse", "Menu")" class="quick-action-btn">
                            <i class="fas fa-utensils"></i>
                            <span>Browse Menu</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" />
}