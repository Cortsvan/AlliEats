@model ASI.Basecode.Services.ServiceModels.CartViewModel

@{
    ViewData["Title"] = "My Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cart-wrapper">
    <div class="container-fluid px-lg-5 py-4">
        <div class="row align-items-center mb-4">
            <div class="col">
                <h1 class="page-title">
                    <i class="fas fa-shopping-basket me-3"></i>Your Food Basket
                </h1>
                <p class="text-muted mb-0">Review your items and proceed to checkout</p>
            </div>
            <div class="col-auto d-none d-md-block">
                <div class="header-stats">
                    <span class="stat-pill">
                        <i class="fas fa-layer-group"></i> @Model.TotalItems Items
                    </span>
                    <span class="stat-pill highlight">
                        Total: ₱@Model.TotalAmount.ToString("F2")
                    </span>
                </div>
            </div>
        </div>

        <div class="alerts-container mb-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show custom-alert shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show custom-alert shadow-sm" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="alert alert-warning alert-dismissible fade show d-none custom-alert shadow-sm" id="stockIssuesAlert" role="alert">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-start">
                        <i class="fas fa-exclamation-circle fs-4 me-3 mt-1"></i>
                        <div>
                            <h6 class="alert-heading fw-bold mb-1">Stock Issues Detected</h6>
                            <div id="stockIssuesContent" class="small"></div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold" id="autoFixStockBtn">
                        <i class="fas fa-magic me-2"></i>Auto-fix
                    </button>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>

        <div class="@(Model.CartItems.Any() ? "d-none" : "") text-center py-5" id="empty-cart-container">
            <div class="empty-state-content">
                <div class="empty-icon mb-4">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <h3 class="fw-bold text-secondary">Your cart is empty</h3>
                <p class="text-muted mb-4">Looks like you haven't added anything to your cart yet.</p>
                <a href="@Url.Action("Browse", "Menu")" class="btn btn-primary btn-lg rounded-pill px-5">
                    <i class="fas fa-utensils me-2"></i>Browse Our Menu
                </a>
            </div>
        </div>

        <div class="row g-4 @(Model.CartItems.Any() ? "" : "d-none")" id="cart-content-wrapper">

            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center rounded-top-4">
                        <h5 class="mb-0 fw-bold text-secondary">Cart Items</h5>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" id="checkStockBtn">
                                <i class="fas fa-sync me-1"></i> Check Stock
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" onclick="confirmClearCart()">
                                <i class="fas fa-trash-alt me-1"></i> Clear
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="cart-items-list" id="cart-items-list">
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="cart-item-row p-4 border-bottom" data-item-id="@item.Id" data-menu-item-id="@item.MenuItemId">
                                    <div class="row align-items-center g-3">
                                        <div class="col-12 col-sm-auto">
                                            <div class="img-wrapper">
                                                <img src="@(string.IsNullOrEmpty(item.MenuItemImagePath) ? "/images/placeholder-food.jpg" : item.MenuItemImagePath)"
                                                     alt="@item.MenuItemName"
                                                     class="rounded-3 object-fit-cover"
                                                     width="100" height="100"
                                                     onerror="this.src='/images/placeholder-food.jpg'; this.onerror=null;">
                                            </div>
                                        </div>

                                        <div class="col">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h5 class="mb-1 fw-bold text-dark">@item.MenuItemName</h5>
                                                    <span class="badge bg-light text-secondary border rounded-pill mb-2">@item.MenuItemCategory</span>
                                                </div>
                                                <button type="button" class="btn-icon-danger" onclick="confirmRemove(@item.Id, '@item.MenuItemName')" title="Remove Item">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                            <p class="text-muted small mb-3 text-truncate-2">
                                                @(item.MenuItemDescription != null && item.MenuItemDescription.Length > 80 ? item.MenuItemDescription.Substring(0, 80) + "..." : item.MenuItemDescription)
                                            </p>

                                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                                <div class="quantity-wrapper">
                                                    <form method="post" action="@Url.Action("UpdateItem", "Cart")" class="d-flex align-items-center">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="cartItemId" value="@item.Id" />

                                                        <div class="stepper-ui">
                                                            <button class="stepper-btn" type="button" data-action="decrease"><i class="fas fa-minus"></i></button>
                                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="50"
                                                                   class="stepper-input quantity-input"
                                                                   data-item-id="@item.Id" data-last-valid="@item.Quantity">
                                                            <button class="stepper-btn" type="button" data-action="increase"><i class="fas fa-plus"></i></button>
                                                        </div>
                                                    </form>
                                                </div>

                                                <div class="text-end">
                                                    <div class="small text-muted">Unit: ₱@item.Price.ToString("F2")</div>
                                                    <div class="fw-bold text-primary fs-5 item-total">
                                                        ₱@((item.Quantity * item.Price).ToString("F2"))
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="stock-indicator mt-2 d-none">
                                                <small class="stock-status px-2 py-1 rounded bg-light border">
                                                    <i class="fas fa-box me-1"></i> <span class="stock-text"></span>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-white py-3 text-center">
                        <a href="@Url.Action("Browse", "Menu")" class="text-decoration-none fw-bold text-primary">
                            <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="order-summary-card sticky-top" style="top: 20px; z-index: 10;">
                    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                        <div class="card-header bg-brown text-white py-3 px-4">
                            <h5 class="mb-0"><i class="fas fa-receipt me-2"></i>Order Summary</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="summary-scroll-area mb-3">
                                <ul class="list-group list-group-flush">
                                    @foreach (var item in Model.CartItems)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                                            <div class="text-truncate me-2">
                                                <span class="fw-medium">@item.MenuItemName</span>
                                                <span class="text-muted small ms-1">× @item.Quantity</span>
                                            </div>
                                            <span class="text-dark fw-bold">₱@((item.Price * item.Quantity).ToString("F2"))</span>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <hr class="border-dashed my-3">

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="h5 mb-0 text-secondary">Total Amount</span>
                                <span class="h3 mb-0 text-primary fw-bold" id="summary-total">₱@Model.TotalAmount.ToString("F2")</span>
                            </div>

                            <a href="@Url.Action("Index", "Checkout")" class="btn btn-primary w-100 btn-lg rounded-pill shadow-sm mb-3" id="checkoutBtn">
                                Proceed to Checkout <i class="fas fa-chevron-right ms-2"></i>
                            </a>

                            <div class="text-center text-muted small">
                                <i class="fas fa-shield-alt me-1"></i> Secure Checkout
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.CartItems.Any())
{
    <div class="modal fade" id="removeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content rounded-4 border-0 overflow-hidden">
                <div class="modal-body text-center p-4">
                    <div class="mb-3 text-warning display-6"><i class="fas fa-exclamation-circle"></i></div>
                    <h5 class="fw-bold mb-2">Remove Item?</h5>
                    <p class="text-muted small mb-4">Are you sure you want to remove <strong id="removeItemName" class="text-dark"></strong>?</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <form id="removeForm" method="post" action="@Url.Action("RemoveItem", "Cart")">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger rounded-pill px-4">Remove</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="clearModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content rounded-4 border-0 overflow-hidden">
                <div class="modal-body text-center p-4">
                    <div class="mb-3 text-danger display-6"><i class="fas fa-trash-alt"></i></div>
                    <h5 class="fw-bold mb-2">Clear Cart?</h5>
                    <p class="text-muted small mb-4">This will remove all items from your basket. This action cannot be undone.</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <form id="clearForm" method="post" action="@Url.Action("Clear", "Cart")">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger rounded-pill px-4">Yes, Clear It</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/cart.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/cart.css" />
}