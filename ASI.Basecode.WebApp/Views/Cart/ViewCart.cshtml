@model ASI.Basecode.Services.ServiceModels.CartViewModel

@{
    ViewData["Title"] = "My Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="cart-header text-center">
        <h1 class="display-5 fw-bold"><i class="fas fa-shopping-basket me-3"></i>Your Food Basket</h1>
        <p class="lead">Review your items and proceed to checkout.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row @(Model.CartItems.Any() ? "" : "hidden")" id="cart-content-wrapper">

        <div class="col-lg-8" id="cart-items-container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0" id="cart-item-count">Cart Items (@Model.TotalItems)</h4>
                <a href="@Url.Action("Browse", "Menu")" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                </a>
            </div>

            <div id="cart-items-list">
                @foreach (var item in Model.CartItems)
                {
                    <div class="cart-item-card mb-3" data-item-id="@item.Id">
                        <div class="cart-item-image">
                            <img src="@(string.IsNullOrEmpty(item.MenuItemImagePath) ? "/images/placeholder-food.jpg" : item.MenuItemImagePath)"
                                 alt="@item.MenuItemName"
                                 onerror="this.src='/images/placeholder-food.jpg'; this.onerror=null;">
                        </div>
                        <div class="cart-item-details">
                            <h5>@item.MenuItemName</h5>
                            <p class="text-muted small mb-1">
                                @(item.MenuItemDescription != null && item.MenuItemDescription.Length > 80 ? item.MenuItemDescription.Substring(0, 80) + "..." : item.MenuItemDescription)
                            </p>
                            <span class="badge badge-category">@item.MenuItemCategory</span>
                        </div>
                        <div classtext-center px-3" style="min-width: 100px;">
                            <span class="item-price" data-unit-price="@item.Price.ToString("F2")">@("P" + item.Price.ToString("F2"))</span>
                        </div>

                        <div class="quantity-controls px-3">
                            <form method="post" action="@Url.Action("UpdateItem", "Cart")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary btn-quantity" type="button" data-action="decrease">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <input type="number" name="quantity" value="@item.Quantity"
                                           min="1" max="50" class="form-control quantity-input"
                                           data-item-id="@item.Id" data-last-valid="@item.Quantity">
                                    <button class="btn btn-outline-secondary btn-quantity" type="button" data-action="increase">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="text-center px-3" style="min-width: 120px;">
                            <span class="item-total">@("P" + item.Price.ToString("F2"))</span>
                        </div>
                        <div class="text-center">
                            <button type="button" class="remove-btn" onclick="confirmRemove(@item.Id, '@item.MenuItemName')">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="text-end mt-3">
                <button type="button" class="btn btn-outline-danger" onclick="confirmClearCart()">
                    <i class="fas fa-times-circle me-2"></i>Clear Cart
                </button>
            </div>
        </div>

        <div class="col-lg-4" id="order-summary-container">
            <div class="card shadow-sm order-summary-card">
                <div class="card-body">
                    <h4 class="card-title text-center mb-4">
                        <i class="fas fa-receipt me-2"></i>Order Summary
                    </h4>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.CartItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    @item.MenuItemName
                                    <span class="text-muted small"> (x @item.Quantity)</span>
                                </div>
                                <span class="fw-bold">
                                    @("P" + (item.Price * item.Quantity).ToString("F2"))
                                </span>
                            </li>
                        }
                        <li class="list-group-item d-flex justify-content-between align-items-center fw-bold h5">
                            Total
                            <span class="text-success" id="summary-total">@("P" + Model.TotalAmount.ToString("F2"))</span>
                        </li>
                    </ul>
                    <div class="d-grid mt-4">
                        <a href="@Url.Action("Index", "Checkout")" class="btn btn-checkout btn-lg">
                            <i class="fas fa-credit-card me-2"></i>Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div> <div class="col-12 @(Model.CartItems.Any() ? "hidden" : "")" id="empty-cart-container">
        <div class="empty-cart-container">
            <div class="icon"><i class="fas fa-shopping-bag"></i></div>
            <h3 class="mt-4">Your cart is empty</h3>
            <p class="text-muted">Looks like you haven't added anything to your cart yet.</p>
            <a href="@Url.Action("Browse", "Menu")" class="btn btn-primary btn-lg mt-3">
                <i class="fas fa-utensils me-2"></i>Browse Menu
            </a>
        </div>
    </div>
</div>

<!-- Modals -->
@if (Model.CartItems.Any())
{
    <!-- Remove Item Modal -->
    <div class="modal fade" id="removeModal" tabindex="-1" aria-labelledby="removeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title" id="removeModalLabel"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Removal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to remove <strong id="removeItemName"></strong> from your cart?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="removeForm" method="post" action="@Url.Action("RemoveItem", "Cart")">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning"><i class="fas fa-trash me-2"></i>Remove</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Clear Cart Modal -->
    <div class="modal fade" id="clearModal" tabindex="-1" aria-labelledby="clearModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="clearModalLabel"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Clear Cart</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to clear your entire cart? This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="clearForm" method="post" action="@Url.Action("Clear", "Cart")">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger"><i class="fas fa-trash me-2"></i>Clear Cart</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}


@section Scripts {
    <script src="~/js/cart.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/cart.css" />
}