@model ASI.Basecode.Services.ServiceModels.CartViewModel

@{
    ViewData["Title"] = "My Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userName = Context.Session.GetString("UserName");
}

<div class="container-fluid px-4">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-info border-0 shadow-sm">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <i class="fas fa-shopping-cart fa-2x text-info"></i>
                    </div>
                    <div>
                        <h4 class="alert-heading mb-1">Your Shopping Cart</h4>
                        <p class="mb-0">Review your items and proceed to checkout when ready.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-list me-2"></i>Cart Items
                        </h4>
                        <a href="@Url.Action("Browse", "Menu")" class="btn btn-light">
                            <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (Model.CartItems.Any())
                    {
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="row align-items-center border-bottom py-3">
                                <div class="col-md-6">
                                    <h6 class="mb-1">@item.MenuItemName</h6>
                                    <p class="text-muted small mb-1">@item.MenuItemDescription</p>
                                    <span class="badge bg-info">@item.MenuItemCategory</span>
                                </div>
                                <div class="col-md-2 text-center">
                                    <span class="text-success fw-bold">$@item.Price.ToString("F2")</span>
                                </div>
                                <div class="col-md-2">
                                    <form method="post" action="@Url.Action("UpdateItem", "Cart")" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="quantity" value="@item.Quantity"
                                                   min="1" max="50" class="form-control text-center"
                                                   onchange="this.form.submit()">
                                        </div>
                                    </form>
                                </div>
                                <div class="col-md-2 text-center">
                                    <span class="fw-bold">$@item.TotalPrice.ToString("F2")</span>
                                    <form method="post" action="@Url.Action("RemoveItem", "Cart")" class="d-inline mt-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                onclick="confirmRemove(@item.Id, '@item.MenuItemName')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }

                        <div class="row mt-3">
                            <div class="col-12 text-end">
                                <form method="post" action="@Url.Action("Clear", "Cart")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-outline-danger" onclick="confirmClearCart()">
                                        <i class="fas fa-trash me-2"></i>Clear Cart
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Your cart is empty</h5>
                            <p class="text-muted">Add some delicious items from our menu!</p>
                            <a href="@Url.Action("Browse", "Menu")" class="btn btn-primary">
                                <i class="fas fa-utensils me-2"></i>Browse Menu
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (Model.CartItems.Any())
        {
            <div class="col-lg-4">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-receipt me-2"></i>Order Summary
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Total Items:</span>
                            <span class="fw-bold">@Model.TotalItems</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal:</span>
                            <span class="fw-bold">$@Model.TotalAmount.ToString("F2")</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="h5">Total:</span>
                            <span class="h5 text-success">$@Model.TotalAmount.ToString("F2")</span>
                        </div>

                        <button class="btn btn-success w-100 btn-lg" disabled>
                            <i class="fas fa-credit-card me-2"></i>Proceed to Checkout
                        </button>
                        <p class="text-muted small text-center mt-2">Checkout feature coming soon!</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Update the Remove Item Modal -->
<div class="modal fade" id="removeModal" tabindex="-1" aria-labelledby="removeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="removeModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Remove Item
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to remove <strong id="removeItemName"></strong> from your cart?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="removeForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-trash me-2"></i>Remove
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Update the Clear Cart Modal -->
<div class="modal fade" id="clearModal" tabindex="-1" aria-labelledby="clearModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="clearModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Clear Cart
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to clear your entire cart?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="clearForm" method="post" action="@Url.Action("Clear", "Cart")" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Clear Cart
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add event listeners for cancel buttons
            const cancelButtons = document.querySelectorAll('[data-bs-dismiss="modal"]');
            cancelButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const modalElement = this.closest('.modal');
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) {
                        modal.hide();
                    }
                });
            });
        });

        function confirmRemove(cartItemId, itemName) {
            document.getElementById('removeItemName').textContent = itemName;
            document.getElementById('removeForm').action = '@Url.Action("RemoveItem", "Cart")';
            document.getElementById('removeForm').innerHTML =
                '@Html.AntiForgeryToken()' +
                '<input type="hidden" name="cartItemId" value="' + cartItemId + '" />' +
                '<button type="submit" class="btn btn-warning"><i class="fas fa-trash me-2"></i>Remove</button>';

            const modal = new bootstrap.Modal(document.getElementById('removeModal'));
            modal.show();
        }

        function confirmClearCart() {
            const modal = new bootstrap.Modal(document.getElementById('clearModal'));
            modal.show();
        }
    </script>
}