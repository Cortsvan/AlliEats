@model IEnumerable<ASI.Basecode.Services.ServiceModels.MenuItemViewModel>

@{
    ViewData["Title"] = "Browse Menu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userName = Context.Session.GetString("UserName");
}

<style>
    body {
        font-family: Georgia, serif;
        background-color: #FFF3E0;
    }

    .custom-card-bg {
        background-color: white;
        border: 1px solid rgba(255, 243, 224, 0.5);
        border-radius: 1rem;
        box-shadow: 0 4px 12px -2px rgba(240, 98, 72, 0.1), 0 2px 4px -2px rgba(240, 98, 72, 0.05);
    }

    .btn-accent-orange {
        background-color: #5D4037;
        border-color: #5D4037;
        color: white;
    }

        .btn-accent-orange:hover {
            background-color: #5D4037;
            border-color: #5D4037;
            color: white;
            opacity: 0.9;
        }

    .text-deep-maroon {
        color: #5D4037 !important;
    }

    .text-price-green {
        color: #FFD54F !important;
    }

    .badge-category {
        background-color: rgba(93, 64, 55, 0.1);
        color: #5D4037;
        font-weight: 500;
        padding: 0.3em 0.6em;
        border-radius: 0.5rem;
    }

    .image-placeholder {
        height: 150px;
        background-color: #FFF3E0;
        background-image: linear-gradient(to bottom, #fff8f5, #FFF3E0);
        border-radius: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        color: rgba(224, 224, 224, 0.8);
    }
</style>

<div class="container-fluid px-4">
    <div class="row my-4 align-items-center">
        <div class="col-md-8">
            <h2 class="text-deep-maroon" style="font-weight: bold;">Welcome to AlliEats</h2>
            <p style="color: #212121;">Discover delicious food and add your favorites to the cart!</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("ViewCart", "Cart")" class="btn btn-accent-orange position-relative">
                <i class="fas fa-shopping-cart me-2"></i> View Cart
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    1
                    <span class="visually-hidden">items in cart</span>
                </span>
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5" style="color: #212121; font-weight: bold;">
                <i class="fas fa-bars me-4 text-deep-maroon"></i> Our Menu
            </h1>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 custom-card-bg">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="text-end mb-2">
                                <span class="badge badge-category">@item.Category</span>
                            </div>

                            <div class="image-placeholder">
                                <i class="fas fa-utensils fa-5x"></i>
                            </div>

                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h5 class="card-title mb-1" style="color: #212121;"><strong>@item.Name</strong></h5>
                                    <h5 class="mb-0 text-price-green" style="font-weight: bold;">$@item.Price.ToString("F2")</h5>
                                </div>
                                <p class="card-text text-muted small mb-3">
                                    @(string.IsNullOrEmpty(item.Description) ? "A delicious item from our menu." : item.Description)
                                </p>
                            </div>

                            <button type="button" class="btn btn-accent-orange w-100 mt-auto"
                                    onclick="addToCart(@item.Id, '@item.Name', @item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                <i class="fas fa-plus me-1"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-utensils fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No menu items available</h5>
            <p class="text-muted">Please check back later for our delicious offerings.</p>
        </div>
    }
</div>

<div class="modal fade" id="addToCartModal" tabindex="-1" aria-labelledby="addToCartModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 0.5rem; overflow: hidden;">

            <div class="modal-header text-white" style="background-color: #5D4037; border-bottom: 0;">
                <h5 class="modal-title" id="addToCartModalLabel">
                    <i class="fas fa-shopping-cart me-2"></i> Add to Cart
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <p class="text-muted mb-1" style="font-size: 0.9rem;">You're adding</p>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold mb-0" id="modalItemName">Premium Steak</h3>
                    <h3 class="fw-bold mb-0 text-deep-maroon" id="modalItemPrice">$34.99</h3>
                </div>

                <label for="quantity" class="form-label fw-bold">Quantity</label>
                <div class="input-group mb-3" style="max-width: 150px;">
                    <button class="btn btn-outline-secondary" type="button" id="modal-quantity-minus" style="font-weight: 600;">-</button>
                    <input type="text" class="form-control text-center fw-bold" id="quantity" value="1" min="1" max="10" readonly>
                    <button class="btn btn-outline-secondary" type="button" id="modal-quantity-plus" style="font-weight: 600;">+</button>
                </div>

                <div class="mt-4 p-3 bg-light" style="border-radius: 0.5rem;">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Subtotal</span>
                        <span class="fw-bold fs-5 text-deep-maroon" id="modalSubtotal">$34.99</span>
                    </div>
                </div>

            </div>

            <div class="modal-footer" style="border-top: 1px solid #dee2e6; padding: 1rem 1.5rem;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="flex-grow: 1;">Cancel</button>
                <button type="button" class="btn btn-accent-orange" id="confirmAddToCart" style="flex-grow: 1;">
                    <i class="fas fa-shopping-cart me-2"></i> Add to Cart
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let currentMenuItemId = null;
        let currentItemPrice = 0.0; 

   
        function updateSubtotal() {
            const quantity = parseInt($('#quantity').val()) || 1;
            const subtotal = quantity * currentItemPrice;
            $('#modalSubtotal').text('$' + subtotal.toFixed(2));
        }

   
        function addToCart(menuItemId, itemName, itemPrice) {
            currentMenuItemId = menuItemId;
            currentItemPrice = parseFloat(itemPrice); 

           
            $('#modalItemName').text(itemName);
            $('#modalItemPrice').text('$' + currentItemPrice.toFixed(2));

            $('#quantity').val(1); 
            updateSubtotal(); 

            $('#addToCartModal').modal('show');
        }

        $(document).ready(function() {
         
            $('[data-bs-dismiss="modal"]').click(function() {
                $('#addToCartModal').modal('hide');
            });

            $('#modal-quantity-plus').click(function() {
                let quantityInput = $('#quantity');
                let currentVal = parseInt(quantityInput.val());
                let max = parseInt(quantityInput.attr('max')) || 10;
                if (currentVal < max) {
                    quantityInput.val(currentVal + 1);
                    updateSubtotal();
                }
            });

            $('#modal-quantity-minus').click(function() {
                let quantityInput = $('#quantity');
                let currentVal = parseInt(quantityInput.val());
                let min = parseInt(quantityInput.attr('min')) || 1;
                if (currentVal > min) {
                    quantityInput.val(currentVal - 1);
                    updateSubtotal();
                }
            });

            $('#confirmAddToCart').click(function() {
                const quantity = $('#quantity').val();
                const token = $('input[name="__RequestVerificationToken"]').val();
                const button = $(this);

                button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Adding...');

                $.post('@Url.Action("AddItem", "Cart")', {
                    menuItemId: currentMenuItemId,
                    quantity: quantity,
                    __RequestVerificationToken: token
                })
                .done(function(data) {
                    if (data.success) {
                        toastr.success(data.message);
                        $('#addToCartModal').modal('hide');
                    } else {
                        toastr.error(data.message);
                    }
                })
                .fail(function() {
                    toastr.error('An error occurred while adding item to cart.');
                })
                .always(function() {
                    button.prop('disabled', false).html('<i class="fas fa-shopping-cart me-2"></i>Add to Cart');
                });
            });
        });
    </script>
    @Html.AntiForgeryToken()
}