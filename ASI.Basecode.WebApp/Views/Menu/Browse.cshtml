@model IEnumerable<ASI.Basecode.Services.ServiceModels.MenuItemViewModel>

@{
    ViewData["Title"] = "Browse Menu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userName = Context.Session.GetString("UserName");
}

<div class="container-fluid px-4">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-success border-0 shadow-sm">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <i class="fas fa-utensils fa-2x text-success"></i>
                    </div>
                    <div>
                        <h4 class="alert-heading mb-1">Welcome to AlliEats Menu</h4>
                        <p class="mb-0">Discover delicious food and add your favorites to cart!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-list me-2"></i>Our Menu
                        </h4>
                        <a href="@Url.Action("ViewCart", "Cart")" class="btn btn-light">
                            <i class="fas fa-shopping-cart me-2"></i>View Cart
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (Model.Any())
                    {
                        <div class="row">
                            @foreach (var item in Model)
                            {
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="card h-100 border-0 shadow-sm hover-card">
                                        <!-- NEW: Image Section -->
                                        <div class="position-relative overflow-hidden" style="height: 200px;">
                                            @if (!string.IsNullOrEmpty(item.ImagePath))
                                            {
                                                <img src="@item.ImagePath" alt="@item.Name" class="card-img-top food-image"
                                                     style="width: 100%; height: 200px; object-fit: cover;"
                                                     onerror="this.src='/images/placeholder-food.jpg'; this.onerror=null;">
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center h-100 bg-light">
                                                    <i class="fas fa-utensils fa-3x text-muted"></i>
                                                </div>
                                            }
                                            <!-- Category Badge Overlay -->
                                            <span class="badge bg-info position-absolute top-0 end-0 m-2">@item.Category</span>
                                        </div>

                                        <div class="card-body d-flex flex-column">
                                            <div class="mb-2">
                                                <h5 class="card-title mb-1 text-truncate">@item.Name</h5>
                                                <span class="h5 text-success mb-0">$@item.Price.ToString("F2")</span>
                                            </div>

                                            <p class="card-text text-muted small flex-grow-1">
                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                                                }
                                                else
                                                {
                                                    <em>No description available</em>
                                                }
                                            </p>

                                            <div class="mt-auto">
                                                <button type="button" class="btn btn-success w-100"
                                                        onclick="addToCart(@item.Id, '@item.Name')">
                                                    <i class="fas fa-plus me-1"></i>Add to Cart
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-utensils fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No menu items available</h5>
                            <p class="text-muted">Please check back later for our delicious offerings.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add to Cart Modal -->
<div class="modal fade" id="addToCartModal" tabindex="-1" aria-labelledby="addToCartModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="addToCartModalLabel">
                    <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Add <strong id="modalItemName"></strong> to your cart?</p>
                <div class="mb-3">
                    <label for="quantity" class="form-label">Quantity:</label>
                    <input type="number" class="form-control" id="quantity" value="1" min="1" max="10">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmAddToCart">
                    <i class="fas fa-plus me-2"></i>Add to Cart
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentMenuItemId = null;

        function addToCart(menuItemId, itemName) {
            currentMenuItemId = menuItemId;
            $('#modalItemName').text(itemName);
            $('#quantity').val(1);
            $('#addToCartModal').modal('show');
        }

        $(document).ready(function() {
            $('[data-bs-dismiss="modal"]').click(function() {
                $('#addToCartModal').modal('hide');
            });

            $('#confirmAddToCart').click(function() {
                const quantity = $('#quantity').val();
                const token = $('input[name="__RequestVerificationToken"]').val();
                const button = $(this);

                button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Adding...');

                $.post('@Url.Action("AddItem", "Cart")', {
                    menuItemId: currentMenuItemId,
                    quantity: quantity,
                    __RequestVerificationToken: token
                })
                .done(function(data) {
                    if (data.success) {
                        toastr.success(data.message);
                        $('#addToCartModal').modal('hide');
                    } else {
                        toastr.error(data.message);
                    }
                })
                .fail(function() {
                    toastr.error('An error occurred while adding item to cart.');
                })
                .always(function() {
                    button.prop('disabled', false).html('<i class="fas fa-plus me-2"></i>Add to Cart');
                });
            });
        });
    </script>
    @Html.AntiForgeryToken()
}

@section Styles {
    <style>
        .hover-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

            .hover-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
            }

        .food-image {
            transition: transform 0.3s ease-in-out;
        }

        .hover-card:hover .food-image {
            transform: scale(1.05);
        }

        .card-img-top {
            border-radius: calc(0.375rem - 1px) calc(0.375rem - 1px) 0 0;
        }
    </style>
}