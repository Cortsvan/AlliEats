@model IEnumerable<ASI.Basecode.Services.ServiceModels.MenuItemViewModel>

@{
    ViewData["Title"] = "Explore Our Menu";
    var categories = new[] { "Appetizers", "Main Courses", "Desserts", "Beverages" };
    var menuItemsByCategory = Model.GroupBy(item => item.Category).ToDictionary(g => g.Key, g => g.ToList());
}

<div class="menu-container">
    <!-- Menu Header -->
    <div class="menu-header">
        <h1>Explore Our Menu</h1>
        <p>Deliciously crafted meals, just a few clicks away.</p>
    </div>

    <!-- Category Filters -->
    <div class="category-filters">
        <button class="category-btn active" data-target="#menu-all">All</button>
        @foreach (var category in categories)
        {
            <button class="category-btn" data-target="#@category.Replace(" ", "-").ToLower()">@category</button>
        }
    </div>

    <!-- Menu Items Sections -->
    <div id="menu-all">
        @foreach (var category in categories)
        {
            if (menuItemsByCategory.ContainsKey(category))
            {
                <div id="@category.Replace(" ", "-").ToLower()" class="category-section">
                    <h2 class="category-title">@category</h2>
                    <div class="row g-4">
                        @foreach (var item in menuItemsByCategory[category])
                        {
                            <div class="col-lg-4 col-md-6">
                                <div class="menu-item-card @(item.Stock == 0 ? "out-of-stock" : "")"
                                     data-id="@item.Id"
                                     data-name="@item.Name"
                                     data-description="@item.Description"
                                     data-price="@item.Price"
                                     data-stock="@item.Stock"
                                     data-image="@item.ImagePath">
                                    <div class="menu-item-image-container">
                                        <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/img/placeholder-food.png" : item.ImagePath)" alt="@item.Name" class="menu-item-preview-img" />
                                        @if (item.Stock == 0)
                                        {
                                            <div class="stock-overlay">
                                                <span class="out-of-stock-label">Out of Stock</span>
                                            </div>
                                        }
                                        else if (item.Stock <= 5)
                                        {
                                            <div class="stock-badge low-stock">
                                                Only @item.Stock left!
                                            </div>
                                        }
                                    </div>
                                    <div class="menu-item-content">
                                        <h5 class="menu-item-name">@item.Name</h5>
                                        <p class="menu-item-description">@item.Description</p>
                                        <div class="price mt-auto">P@(item.Price.ToString("F2"))</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- New Add to Cart Modal -->
<div class="modal fade" id="addToCartModal" tabindex="-1" aria-labelledby="addToCartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <img id="modalItemImage" src="" alt="Menu Item" class="modal-item-img">
                    </div>
                    <div class="col-md-6 d-flex flex-column">
                        <h3 id="modalItemName" class="modal-item-name"></h3>
                        <p id="modalItemDescription" class="modal-item-description"></p>
                        <p id="modalItemPrice" class="modal-item-price"></p>

                        <div class="mt-auto">
                            <div class="quantity-selector">
                                <label for="quantity-input">Quantity</label>
                                <div class="quantity-controls">
                                    <button id="quantity-minus" class="quantity-btn">-</button>
                                    <input type="number" id="quantity-input" value="1" min="1" max="10" readonly>
                                    <button id="quantity-plus" class="quantity-btn">+</button>
                                </div>
                            </div>
                            <button type="button" class="btn" id="confirmAddToCart">Add to Cart</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/menu.js" asp-append-version="true"></script>
    @Html.AntiForgeryToken()
}

@section Styles {
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
}