@{
    ViewData["Title"] = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="settings-wrapper">

        <header class="page-header">
            <h1 class="display-5 page-title"><i class="fas fa-cog me-3 text-muted opacity-50"></i>Settings</h1>
            <p class="page-subtitle">Manage your account preferences, security, and orders</p>
        </header>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success shadow-sm border-0 rounded-3 mb-4" role="alert" data-success-message="@TempData["SuccessMessage"]">
                <div class="d-flex align-items-center">
                    <i class="fas fa-check-circle me-3 fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger shadow-sm border-0 rounded-3 mb-4" role="alert" data-error-message="@TempData["ErrorMessage"]">
                <div class="d-flex align-items-center">
                    <i class="fas fa-exclamation-circle me-3 fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        <section class="settings-section">
            <div class="section-label">Security & Access</div>
            <div class="settings-card">

                <div class="setting-item">
                    <div class="setting-content-wrapper">
                        <div class="settings-icon security-icon">
                            <i class="fas fa-lock"></i>
                        </div>
                        <div class="setting-text">
                            <h3 class="setting-name">Password</h3>
                            <p class="setting-desc">Update your password to keep your account secure</p>
                        </div>
                    </div>

                    <div class="action-wrapper">
                        <a href="@Url.Action("ChangePassword", "Settings")" class="btn btn-action-subtle settings-action-btn">
                            Change
                        </a>
                    </div>
                </div>

            </div>
        </section>

        <section class="settings-section">
            <div class="section-label">Personal Information</div>
            <div class="settings-card">

                <div class="setting-item">
                    <div class="setting-content-wrapper">
                        <div class="settings-icon account-icon">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="setting-text">
                            <h3 class="setting-name">Profile Details</h3>
                            <p class="setting-desc">Update your name, email, and personal bio</p>
                        </div>
                    </div>

                    <div class="action-wrapper">
                        <a href="@Url.Action("Index", "Profile")" class="btn btn-action-subtle settings-action-btn">
                            Edit
                        </a>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-content-wrapper">
                        <div class="settings-icon preferences-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="setting-text">
                            <h3 class="setting-name">Delivery Address</h3>
                            <p class="setting-desc">Set your default location for faster checkout</p>
                        </div>
                    </div>

                    <div class="action-wrapper">
                        <a href="@Url.Action("Edit", "Profile", new { returnUrl = Context.Request.Path })" class="btn btn-action-subtle settings-action-btn">
                            Update
                        </a>
                    </div>
                </div>

            </div>
        </section>

        <section class="settings-section">
            <div class="section-label">Payment</div>
            <div class="settings-card">

                <div class="setting-item">
                    <div class="setting-content-wrapper">
                        <div class="settings-icon security-icon">
                            <i class="fas fa-credit-card"></i>
                        </div>
                        <div class="setting-text">
                            <h3 class="setting-name">Payment Methods</h3>
                            <p class="setting-desc">Manage your saved credit and debit cards</p>
                        </div>
                    </div>

                    <div class="action-wrapper">
                        <a href="@Url.Action("PaymentMethods", "Settings")" class="btn btn-action-subtle settings-action-btn">
                            Manage
                        </a>
                    </div>
                </div>

            </div>
        </section>

        <section class="settings-section">
            <div class="section-label">History</div>
            <div class="settings-card">

                <div class="setting-item">
                    <div class="setting-content-wrapper">
                        <div class="settings-icon history-icon">
                            <i class="fas fa-receipt"></i>
                        </div>
                        <div class="setting-text">
                            <h3 class="setting-name">Order History</h3>
                            <p class="setting-desc">View past transactions and download receipts</p>
                        </div>
                    </div>

                    <div class="action-wrapper">
                        <a href="@Url.Action("MyOrders", "Order")" class="btn btn-action-subtle settings-action-btn">
                            View
                        </a>
                    </div>
                </div>

            </div>
        </section>

        <section class="settings-section mt-5">
            <div class="section-label text-center mb-3">Quick Actions</div>
            <div class="quick-actions-grid">

                <a href="@Url.Action("ViewCart", "Cart")" class="quick-action-item">
                    <div class="quick-action-icon cart-action">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <span class="quick-action-title">My Cart</span>
                    <span class="quick-action-text d-none">My Cart</span>
                    <span class="quick-action-desc">View Items</span>
                </a>

                <a href="@Url.Action("Browse", "Menu")" class="quick-action-item">
                    <div class="quick-action-icon menu-action">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <span class="quick-action-title">Browse Menu</span>
                    <span class="quick-action-text d-none">Browse Menu</span>
                    <span class="quick-action-desc">Order Food</span>
                </a>

                <a href="@Url.Action("Index", "Home")" class="quick-action-item">
                    <div class="quick-action-icon home-action">
                        <i class="fas fa-home"></i>
                    </div>
                    <span class="quick-action-title">Home</span>
                    <span class="quick-action-text d-none">Home</span>
                    <span class="quick-action-desc">Go Back</span>
                </a>

            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script src="~/js/settings.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" />
}