@model ASI.Basecode.Services.ServiceModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="password-header text-center">
        <h1 class="display-5 fw-bold"><i class="fas fa-key me-3"></i>Change Password</h1>
        <p class="lead">Update your account password for better security</p>
    </div>

    <!-- Handle TempData messages with server-side alerts instead of JavaScript -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="row">
                <!-- Password Form -->
                <div class="col-md-7">
                    <div class="card shadow-sm password-form-card">
                        <div class="card-body">
                            <h5 class="form-title mb-4">
                                <i class="fas fa-shield-alt me-2"></i>Password Security
                            </h5>

                            <form asp-action="ChangePassword" method="post" id="changePasswordForm" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="Email" />

                                <div class="password-form-group mb-3">
                                    <label asp-for="CurrentPassword" class="form-label"></label>
                                    <div class="password-input-group">
                                        <span class="password-input-icon">
                                            <i class="fas fa-lock"></i>
                                        </span>
                                        <input asp-for="CurrentPassword" class="form-control password-input"
                                               autocomplete="current-password" placeholder="Enter your current password" />
                                        <button type="button" class="password-toggle" data-target="CurrentPassword">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                                </div>

                                <div class="password-form-group mb-3">
                                    <label asp-for="NewPassword" class="form-label"></label>
                                    <div class="password-input-group">
                                        <span class="password-input-icon">
                                            <i class="fas fa-key"></i>
                                        </span>
                                        <input asp-for="NewPassword" class="form-control password-input"
                                               autocomplete="new-password" placeholder="Enter your new password" />
                                        <button type="button" class="password-toggle" data-target="NewPassword">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>

                                    <!-- Password Strength Indicator -->
                                    <div class="password-strength mt-2">
                                        <div class="password-strength-bar">
                                            <div class="password-strength-fill"></div>
                                        </div>
                                        <span class="password-strength-text">Password strength</span>
                                    </div>
                                </div>

                                <div class="password-form-group mb-4">
                                    <label asp-for="ConfirmNewPassword" class="form-label"></label>
                                    <div class="password-input-group">
                                        <span class="password-input-icon">
                                            <i class="fas fa-check-circle"></i>
                                        </span>
                                        <input asp-for="ConfirmNewPassword" class="form-control password-input"
                                               autocomplete="new-password" placeholder="Confirm your new password" />
                                        <button type="button" class="password-toggle" data-target="ConfirmNewPassword">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                                </div>

                                <div class="form-actions">
                                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary me-3">
                                        <i class="fas fa-arrow-left me-2"></i>Cancel
                                    </a>
                                    <button type="submit" class="btn btn-checkout" id="changePasswordBtn">
                                        <i class="fas fa-save me-2"></i>Change Password
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Security Tips and Requirements -->
                <div class="col-md-5">
                    <!-- Password Requirements -->
                    <div class="card shadow-sm password-requirements-card mb-4">
                        <div class="card-body">
                            <h6 class="card-title mb-3">
                                <i class="fas fa-check-circle me-2"></i>Password Requirements
                            </h6>

                            <div class="requirements-list">
                                <div class="requirement-item" data-requirement="length">
                                    <i class="fas fa-circle requirement-icon"></i>
                                    <span>At least 8 characters long</span>
                                </div>
                                <div class="requirement-item" data-requirement="lowercase">
                                    <i class="fas fa-circle requirement-icon"></i>
                                    <span>One lowercase letter</span>
                                </div>
                                <div class="requirement-item" data-requirement="uppercase">
                                    <i class="fas fa-circle requirement-icon"></i>
                                    <span>One uppercase letter</span>
                                </div>
                                <div class="requirement-item" data-requirement="number">
                                    <i class="fas fa-circle requirement-icon"></i>
                                    <span>One number</span>
                                </div>
                                <div class="requirement-item" data-requirement="special">
                                    <i class="fas fa-circle requirement-icon"></i>
                                    <span>One special character</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Security Tips -->
                    <div class="card shadow-sm security-tips-card">
                        <div class="card-body">
                            <h6 class="card-title mb-3">
                                <i class="fas fa-lightbulb me-2"></i>Security Tips
                            </h6>

                            <div class="security-tips-list">
                                <div class="security-tip">
                                    <i class="fas fa-shield-alt tip-icon"></i>
                                    <span>Use a unique password that you don't use elsewhere</span>
                                </div>
                                <div class="security-tip">
                                    <i class="fas fa-random tip-icon"></i>
                                    <span>Include a mix of letters, numbers, and special characters</span>
                                </div>
                                <div class="security-tip">
                                    <i class="fas fa-user-secret tip-icon"></i>
                                    <span>Avoid using personal information like your name or birthday</span>
                                </div>
                                <div class="security-tip">
                                    <i class="fas fa-sync-alt tip-icon"></i>
                                    <span>Update your password regularly for better security</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/change-password.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/change-password.css" />
}