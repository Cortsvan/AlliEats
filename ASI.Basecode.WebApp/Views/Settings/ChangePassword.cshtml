@model ASI.Basecode.Services.ServiceModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="change-password-wrapper">

        <!-- Page Header -->
        <header class="page-header">
            <div class="header-content">
                <h1 class="page-title">
                    <i class="fas fa-key header-icon"></i>
                    Change Password
                </h1>
                <p class="page-subtitle">Update your account password to keep your account secure</p>
            </div>
            <a href="@Url.Action("Index", "Settings")" class="btn-back">
                <i class="fas fa-arrow-left"></i> Back to Settings
            </a>
        </header>

        <!-- Alert Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-modern fade show" role="alert">
                <div class="alert-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="alert-content">
                    <div class="alert-title">Success!</div>
                    <div class="alert-message">@TempData["SuccessMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-modern fade show" role="alert">
                <div class="alert-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="alert-content">
                    <div class="alert-title">Error</div>
                    <div class="alert-message">@TempData["ErrorMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Main Password Form -->
            <div class="col-lg-7">
                <div class="password-card">
                    <div class="card-header-custom">
                        <h2 class="card-title">
                            <i class="fas fa-shield-alt me-2"></i>
                            Password Security
                        </h2>
                        <p class="card-subtitle">Enter your current password and choose a new secure password</p>
                    </div>

                    <form asp-action="ChangePassword" method="post" id="changePasswordForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />

                        <div class="form-section">
                            <div class="form-group-custom">
                                <label asp-for="CurrentPassword" class="form-label-custom">
                                    <i class="fas fa-lock label-icon"></i>
                                    Current Password
                                </label>
                                <div class="input-wrapper">
                                    <input asp-for="CurrentPassword" 
                                           class="form-control-custom"
                                           type="password"
                                           autocomplete="current-password" 
                                           placeholder="Enter your current password" />
                                    <button type="button" class="input-toggle" data-target="CurrentPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="CurrentPassword" class="validation-message"></span>
                            </div>

                            <div class="divider-line"></div>

                            <div class="form-group-custom">
                                <label asp-for="NewPassword" class="form-label-custom">
                                    <i class="fas fa-key label-icon"></i>
                                    New Password
                                </label>
                                <div class="input-wrapper">
                                    <input asp-for="NewPassword" 
                                           class="form-control-custom"
                                           type="password"
                                           autocomplete="new-password" 
                                           placeholder="Enter your new password" />
                                    <button type="button" class="input-toggle" data-target="NewPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="validation-message"></span>

                                <!-- Password Strength Indicator -->
                                <div class="strength-indicator">
                                    <div class="strength-bar">
                                        <div class="strength-fill"></div>
                                    </div>
                                    <span class="strength-text">Enter password to check strength</span>
                                </div>
                            </div>

                            <div class="form-group-custom">
                                <label asp-for="ConfirmNewPassword" class="form-label-custom">
                                    <i class="fas fa-check-circle label-icon"></i>
                                    Confirm New Password
                                </label>
                                <div class="input-wrapper">
                                    <input asp-for="ConfirmNewPassword" 
                                           class="form-control-custom"
                                           type="password"
                                           autocomplete="new-password" 
                                           placeholder="Re-enter your new password" />
                                    <button type="button" class="input-toggle" data-target="ConfirmNewPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmNewPassword" class="validation-message"></span>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-primary-custom" id="changePasswordBtn">
                                <i class="fas fa-save me-2"></i>
                                Update Password
                            </button>
                            <a href="@Url.Action("Index", "Settings")" class="btn-secondary-custom">
                                <i class="fas fa-times me-2"></i>
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Sidebar: Requirements & Tips -->
            <div class="col-lg-5">
                <!-- Password Requirements -->
                <div class="info-card requirements-card">
                    <div class="info-card-header">
                        <i class="fas fa-clipboard-check me-2"></i>
                        Password Requirements
                    </div>
                    <div class="info-card-body">
                        <ul class="requirements-list">
                            <li class="requirement-item" data-requirement="length">
                                <span class="requirement-icon">
                                    <i class="fas fa-circle"></i>
                                </span>
                                <span class="requirement-text">At least 8 characters long</span>
                            </li>
                            <li class="requirement-item" data-requirement="lowercase">
                                <span class="requirement-icon">
                                    <i class="fas fa-circle"></i>
                                </span>
                                <span class="requirement-text">One lowercase letter (a-z)</span>
                            </li>
                            <li class="requirement-item" data-requirement="uppercase">
                                <span class="requirement-icon">
                                    <i class="fas fa-circle"></i>
                                </span>
                                <span class="requirement-text">One uppercase letter (A-Z)</span>
                            </li>
                            <li class="requirement-item" data-requirement="number">
                                <span class="requirement-icon">
                                    <i class="fas fa-circle"></i>
                                </span>
                                <span class="requirement-text">One number (0-9)</span>
                            </li>
                            <li class="requirement-item" data-requirement="special">
                                <span class="requirement-icon">
                                    <i class="fas fa-circle"></i>
                                </span>
                                <span class="requirement-text">One special character (@Html.Raw("(!@#$%^&*)"))</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Security Tips -->
                <div class="info-card tips-card">
                    <div class="info-card-header">
                        <i class="fas fa-lightbulb me-2"></i>
                        Security Best Practices
                    </div>
                    <div class="info-card-body">
                        <div class="tips-list">
                            <div class="tip-item">
                                <div class="tip-icon">
                                    <i class="fas fa-shield-alt"></i>
                                </div>
                                <div class="tip-content">
                                    <h6 class="tip-title">Use a unique password</h6>
                                    <p class="tip-desc">Don't reuse passwords from other accounts</p>
                                </div>
                            </div>
                            <div class="tip-item">
                                <div class="tip-icon">
                                    <i class="fas fa-random"></i>
                                </div>
                                <div class="tip-content">
                                    <h6 class="tip-title">Mix character types</h6>
                                    <p class="tip-desc">Combine letters, numbers, and symbols</p>
                                </div>
                            </div>
                            <div class="tip-item">
                                <div class="tip-icon">
                                    <i class="fas fa-user-secret"></i>
                                </div>
                                <div class="tip-content">
                                    <h6 class="tip-title">Avoid personal info</h6>
                                    <p class="tip-desc">Don't use names, birthdays, or common words</p>
                                </div>
                            </div>
                            <div class="tip-item">
                                <div class="tip-icon">
                                    <i class="fas fa-sync-alt"></i>
                                </div>
                                <div class="tip-content">
                                    <h6 class="tip-title">Update regularly</h6>
                                    <p class="tip-desc">Change your password every few months</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/change-password.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/change-password.css" />
}