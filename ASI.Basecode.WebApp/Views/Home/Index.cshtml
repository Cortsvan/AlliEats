@using Microsoft.AspNetCore.Http
@using ASI.Basecode.Services.ServiceModels
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Home Page";
    var user = HttpContextAccessor.HttpContext.User;
    var isAuthenticated = user.Identity.IsAuthenticated;
    var isAdmin = user.IsInRole("Admin");
    
    var featuredMenuItems = ViewBag.FeaturedMenuItems as List<MenuItemViewModel> ?? new List<MenuItemViewModel>();
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var featuredReviews = ViewBag.FeaturedReviews as List<UserReviewViewModel> ?? new List<UserReviewViewModel>();
    
    // Helper function to get icon based on category
    string GetCategoryIcon(string category)
    {
        if (string.IsNullOrEmpty(category)) return "fa-utensils";
        
        var lowerCategory = category.ToLower();
        
        // Specific icons for main categories
        if (lowerCategory.Contains("main") || lowerCategory.Contains("main course")) return "fa-drumstick-bite";
        if (lowerCategory.Contains("appetizer") || lowerCategory.Contains("starter")) return "fa-bread-slice";
        if (lowerCategory.Contains("dessert") || lowerCategory.Contains("sweet")) return "fa-ice-cream";
        
        // Fallback icons for other categories
        if (lowerCategory.Contains("burger")) return "fa-hamburger";
        if (lowerCategory.Contains("pizza")) return "fa-pizza-slice";
        if (lowerCategory.Contains("fries") || lowerCategory.Contains("side")) return "fa-french-fries";
        if (lowerCategory.Contains("chicken")) return "fa-drumstick-bite";
        if (lowerCategory.Contains("sandwich")) return "fa-sandwich";
        if (lowerCategory.Contains("taco")) return "fa-taco";
        if (lowerCategory.Contains("noodle") || lowerCategory.Contains("ramen") || lowerCategory.Contains("pasta")) return "fa-bowl-rice";
        if (lowerCategory.Contains("drink") || lowerCategory.Contains("beverage")) return "fa-glass-whiskey";
        return "fa-utensils";
    }
    
    // Helper function to get category anchor link
    string GetCategoryAnchor(string category)
    {
        if (string.IsNullOrEmpty(category)) return "";
        return category.Replace(" ", "-").ToLower();
    }
    
    // Helper function to get initials from order number or generic initial
    string GetCustomerInitials(string orderNumber)
    {
        if (string.IsNullOrEmpty(orderNumber)) return "??";
        // Extract just letters from order number or use first 2 chars
        var letters = new string(orderNumber.Where(char.IsLetter).Take(2).ToArray());
        return string.IsNullOrEmpty(letters) ? "CU" : letters.ToUpper();
    }
}

<div class="container page-container">
    @if (isAuthenticated)
    {
        if (isAdmin)
        {
            /* --- ADMIN DASHBOARD --- */
            <div class="welcome-hero">
                <div class="welcome-content">
                    <div class="welcome-avatar-wrapper">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <h1 class="display-5 fw-bold mb-1">Hello Admin</h1>
                    <p class="mb-0 opacity-75">Welcome to the AlliEats control center.</p>
                </div>
                <i class="fas fa-chart-line welcome-decoration"></i>
            </div>

            <!-- Dashboard Overview Section -->
            <div class="admin-section-wrapper mb-5">
                <div class="admin-section-header mb-4">
                    <div>
                        <h4 class="section-title mb-0">Dashboard Overview</h4>
                        <p class="section-description text-muted mt-2 mb-0">Quick insights into your business performance</p>
                    </div>
                </div>
                
                <div class="row g-4">
                    <div class="col-6 col-md-3">
                        <div class="stat-card-modern">
                            <div class="stat-icon-wrapper">
                                <i class="fas fa-shopping-bag"></i>
                            </div>
                            <div class="stat-details">
                                <h6>Today's Orders</h6>
                                <p class="stat-value">@ViewBag.TodayOrders</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card-modern">
                            <div class="stat-icon-wrapper">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="stat-details">
                                <h6>Active Users</h6>
                                <p class="stat-value">@ViewBag.ActiveUsers</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card-modern">
                            <div class="stat-icon-wrapper">
                                <i class="fas fa-peso-sign"></i>
                            </div>
                            <div class="stat-details">
                                <h6>Total Revenue</h6>
                                <p class="stat-value">₱@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card-modern">
                            <div class="stat-icon-wrapper">
                                <i class="fas fa-star"></i>
                            </div>
                            <div class="stat-details">
                                <h6>Avg Rating</h6>
                                <p class="stat-value">@(((double)ViewBag.AverageRating).ToString("F1"))</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Management Tools Section -->
            <div class="admin-section-wrapper">
                <div class="admin-section-header mb-4">
                    <div>
                        <h4 class="section-title mb-0">Management Tools</h4>
                        <p class="section-description text-muted mt-2 mb-0">Access key administrative functions and controls</p>
                    </div>
                </div>
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="glass-card">
                            <div class="action-card-body">
                                <div class="action-icon-circle icon-menu">
                                    <i class="fas fa-utensils"></i>
                                </div>
                                <h5 class="action-title">Menu Management</h5>
                                <p class="action-desc">Add new dishes, update prices, and organize categories.</p>
                                <a asp-controller="AdminMenu" asp-action="ViewItems" class="btn btn-modern btn-modern-primary">
                                    Manage Menu
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="glass-card">
                            <div class="action-card-body">
                                <div class="action-icon-circle icon-orders">
                                    <i class="fas fa-clipboard-list"></i>
                                </div>
                                <h5 class="action-title">Order Management</h5>
                                <p class="action-desc">Track incoming orders, update status, and view history.</p>
                                <a asp-controller="AdminOrder" asp-action="ManageOrders" class="btn btn-modern btn-modern-primary">
                                    Manage Orders
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            /* --- USER DASHBOARD --- */

            /* 1. Welcome Hero */
            <div class="welcome-hero">
                <div class="welcome-content">
                    <div class="welcome-avatar-wrapper">
                        <i class="fas fa-user-circle"></i>
                    </div>
                    <h1 class="display-5 fw-bold mb-1">Hello, @user.Identity.Name!</h1>
                    <p class="mb-0 opacity-75">Ready to order some delicious food?</p>
                </div>
                <i class="fas fa-hamburger welcome-decoration"></i>
            </div>

            /* 2. Featured Categories Section */
            @if (categories.Any())
            {
                <div class="featured-categories-section">
                    <div class="section-header">
                        <div>
                            <h2>Best <span class="highlight">Delivered</span> Categories</h2>
                            <p class="section-subtitle">Here are some of our best distributed categories. If you want, you can order from here.</p>
                        </div>
                    </div>
                    <div class="category-grid">
                        @foreach (var category in categories)
                        {
                            var categoryIcon = GetCategoryIcon(category);
                            var categoryAnchor = GetCategoryAnchor(category);
                            <div class="category-card">
                                <div class="category-icon-wrapper">
                                    <div class="category-icon-circle">
                                        <i class="fas @categoryIcon"></i>
                                    </div>
                                </div>
                                <h5 class="category-title">@category</h5>
                                <a href="@Url.Action("Browse", "Menu")#@categoryAnchor" class="category-link">
                                    Order Now <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            /* 3. Features Info Section */
            <div class="features-info-section">
                <div class="features-grid">
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fas fa-shipping-fast"></i>
                        </div>
                        <div class="feature-content">
                            <h5>Fast Delivery</h5>
                            <p>Your order will be delivered to your home within 30-45 minutes.</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fas fa-sync-alt"></i>
                        </div>
                        <div class="feature-content">
                            <h5>Fresh Food</h5>
                            <p>Your food will be delivered 100% fresh to your home.</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fas fa-truck"></i>
                        </div>
                        <div class="feature-content">
                            <h5>Free Delivery</h5>
                            <p>Delivery is free. No cost, just order and enjoy.</p>
                        </div>
                    </div>
                </div>
            </div>

            /* 4. Menu Preview Section - 3x2 Grid */
            @if (featuredMenuItems.Any())
            {
                <div class="menu-preview-section">
                    <div class="menu-preview-header">
                        <h2>Our <span class="highlight">Regular</span> Menu</h2>
                        <p class="menu-preview-subtitle">These are our regular menus. You can order anything you like.</p>
                    </div>

                    <div class="menu-items-showcase-grid">
                        @foreach (var item in featuredMenuItems)
                        {
                            var itemIcon = GetCategoryIcon(item.Category);
                            var isOutOfStock = item.Stock == 0;
                            <div class="menu-item-card @(isOutOfStock ? "out-of-stock" : "")" data-item-id="@item.Id">
                                <div class="menu-item-image">
                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="@item.ImagePath" alt="@item.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="fas @itemIcon"></i>
                                    }
                                    @if (isOutOfStock)
                                    {
                                        <div class="out-of-stock-overlay">
                                            <span class="out-of-stock-badge">Sold Out</span>
                                        </div>
                                    }
                                </div>
                                <div class="menu-item-details">
                                    <h5 class="menu-item-name">@item.Name</h5>
                                    <div class="menu-item-rating">
                                        @if (item.ReviewCount > 0)
                                        {
                                            <div class="rating-stars">
                                                @{
                                                    var fullStars = (int)Math.Floor(item.AverageRating);
                                                    var hasHalfStar = (item.AverageRating - fullStars) >= 0.5;
                                                    var emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
                                                }
                                                @for (int i = 0; i < fullStars; i++)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                @if (hasHalfStar)
                                                {
                                                    <i class="fas fa-star-half-alt"></i>
                                                }
                                                @for (int i = 0; i < emptyStars; i++)
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            </div>
                                            <span class="rating-count">(@item.ReviewCount)</span>
                                        }
                                        else
                                        {
                                            <div class="rating-stars">
                                                @for (int i = 0; i < 5; i++)
                                                {
                                                    <i class="far fa-star text-muted"></i>
                                                }
                                            </div>
                                            <span class="rating-count text-muted">(No reviews)</span>
                                        }
                                    </div>
                                    <div class="menu-item-footer">
                                        <span class="menu-item-price">₱@item.Price.ToString("F2")</span>
                                        @if (isOutOfStock)
                                        {
                                            <button class="btn-add-to-cart" disabled>Out of Stock</button>
                                        }
                                        else
                                        {
                                            <button class="btn-add-to-cart view-details-btn" 
                                                    data-item-id="@item.Id"
                                                    data-item-name="@item.Name"
                                                    data-item-price="@item.Price"
                                                    data-item-stock="@item.Stock"
                                                    data-item-description="@item.Description"
                                                    data-item-image="@item.ImagePath"
                                                    data-item-category="@item.Category"
                                                    data-item-rating="@item.AverageRating.ToString("F1")"
                                                    data-item-review-count="@item.ReviewCount">
                                                Order Now
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="view-all-menu-wrapper">
                        <a asp-controller="Menu" asp-action="Browse" class="btn-view-all-menu">
                            See All <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i>
                    No menu items available at the moment. Please check back later!
                </div>
            }

            /* 5. Customer Testimonials Carousel Section */
            @if (featuredReviews.Any())
            {
                <div class="testimonials-section">
                    <div class="testimonials-header">
                        <h2>What Our <span class="highlight">Customers</span> Say</h2>
                        <p class="testimonials-subtitle">Real reviews from real customers who love our food!</p>
                    </div>

                    <div id="testimonialsCarousel" class="carousel slide testimonials-carousel" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            @for (int i = 0; i < featuredReviews.Count; i++)
                            {
                                <button type="button" 
                                        data-bs-target="#testimonialsCarousel" 
                                        data-bs-slide-to="@i" 
                                        class="@(i == 0 ? "active" : "")"
                                        aria-current="@(i == 0 ? "true" : "false")" 
                                        aria-label="Slide @(i + 1)"></button>
                            }
                        </div>

                        <div class="carousel-inner">
                            @for (int i = 0; i < featuredReviews.Count; i++)
                            {
                                var review = featuredReviews[i];
                                var customerInitials = GetCustomerInitials(review.OrderNumber);
                                
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <div class="testimonial-card">
                                        <div class="quote-icon">
                                            <i class="fas fa-quote-left"></i>
                                        </div>
                                        
                                        <div class="testimonial-rating">
                                            @for (int j = 1; j <= 5; j++)
                                            {
                                                @if (j <= review.Rating)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        </div>

                                        <p class="testimonial-text">
                                            "@review.Comment"
                                        </p>

                                        <div class="testimonial-items">
                                            <div class="items-ordered">
                                                @foreach (var item in review.OrderItems.Take(3))
                                                {
                                                    <div class="item-badge" title="@item.MenuItemName">
                                                        @if (!string.IsNullOrEmpty(item.MenuItemImagePath))
                                                        {
                                                            <img src="@item.MenuItemImagePath" alt="@item.MenuItemName" />
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-utensils"></i>
                                                        }
                                                    </div>
                                                }
                                                @if (review.OrderItems.Count > 3)
                                                {
                                                    <div class="item-badge more-items">
                                                        <span>+@(review.OrderItems.Count - 3)</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="testimonial-footer">
                                            <div class="customer-avatar">
                                                <span>@customerInitials</span>
                                            </div>
                                            <div class="customer-info">
                                                <h6 class="customer-name">Customer @review.OrderNumber.Substring(Math.Max(0, review.OrderNumber.Length - 4))</h6>
                                                <p class="order-date">@review.ReviewDate.ToString("MMM dd, yyyy")</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#testimonialsCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#testimonialsCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>

                    <div class="view-all-reviews-wrapper">
                        <a asp-controller="Review" asp-action="AllReviews" class="btn-view-all-reviews">
                            View All Reviews <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
        }
    }
    else
    {
        /* --- GUEST LANDING PAGE --- */
        <div class="guest-hero-split">

            <div class="hero-banner">
                <div class="hero-brand-icon">
                    <i class="fas fa-utensils"></i>
                </div>
                <h1 class="display-3 fw-bold mb-3">AlliEats</h1>
                <p class="lead mb-4 opacity-75">Your favorite food, delivered fast & fresh.</p>

                <div class="cta-group">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-hero-white">
                        Sign In
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-hero-outline">
                        Create Account
                    </a>
                </div>
            </div>

            <div class="features-grid">
                <div class="feature-box">
                    <div class="feature-box-icon">
                        <i class="fas fa-shipping-fast"></i>
                    </div>
                    <h5>Fast Delivery</h5>
                    <p class="text-muted small">We prioritize speed so you can enjoy your food while it's hot.</p>
                </div>
                <div class="feature-box">
                    <div class="feature-box-icon">
                        <i class="fas fa-leaf"></i>
                    </div>
                    <h5>Fresh Ingredients</h5>
                    <p class="text-muted small">We source locally to ensure the best quality in every bite.</p>
                </div>
                <div class="feature-box">
                    <div class="feature-box-icon">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <h5>Easy Ordering</h5>
                    <p class="text-muted small">Order from your phone in seconds with our intuitive app.</p>
                </div>
            </div>
        </div>
    }
</div>

<!-- Item Details Modal -->
<div class="modal fade" id="itemDetailsModal" tabindex="-1" aria-labelledby="itemDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="itemDetailsModalLabel">Item Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-5">
                        <div class="modal-item-image-wrapper">
                            <img id="modalItemImage" src="" alt="Item" class="modal-item-img" />
                        </div>
                    </div>
                    <div class="col-md-7">
                        <h3 id="modalItemName" class="modal-item-name"></h3>
                        <div id="modalItemRating" class="modal-item-rating mb-3"></div>
                        <p id="modalItemCategory" class="modal-item-category mb-2"></p>
                        <p id="modalItemDescription" class="modal-item-description"></p>
                        <p id="modalItemPrice" class="modal-item-price mb-3"></p>
                        
                        <div class="quantity-selector mb-4">
                            <label for="quantity-input" class="form-label fw-bold">Quantity</label>
                            <div class="quantity-controls">
                                <button id="quantity-minus" class="quantity-btn">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <input type="number" id="quantity-input" value="1" min="1" max="10" readonly class="quantity-input">
                                <button id="quantity-plus" class="quantity-btn">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        
                        <button type="button" class="btn btn-primary btn-lg w-100" id="confirmAddToCart">
                            <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/home.js"></script>
    @Html.AntiForgeryToken()
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}