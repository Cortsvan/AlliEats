@{
    ViewData["Title"] = "Home Page";
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
}

<div class="text-center">
    @if (!string.IsNullOrEmpty(userName))
    {
        @if (userRole == "Admin")
        {
            <h1 class="display-4">Hello Admin</h1>
            <p class="lead">Welcome to the AlliEats Admin Dashboard</p>
            <div class="mt-4">
                <a href="@Url.Action("ViewItems", "AdminMenu")" class="btn btn-primary btn-lg">
                    <i class="fas fa-cogs"></i> Manage Menu Items
                </a>
            </div>
        }
        else
        {
            <h1 class="display-4">Hello @userName</h1>
            <p class="lead">Welcome back to AlliEats! Ready to order some delicious food?</p>
            <div class="mt-4">
                <a href="@Url.Action("Browse", "Menu")" class="btn btn-success btn-lg">
                    <i class="fas fa-utensils"></i> Browse Menu
                </a>
                <a href="@Url.Action("ViewCart", "Cart")" class="btn btn-outline-primary btn-lg ml-2">
                    <i class="fas fa-shopping-cart"></i> My Cart
                </a>
            </div>
        }

        <div class="row mt-5">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-star text-warning"></i> Popular Items
                        </h5>
                        <p class="card-text">Check out our most popular dishes that customers love!</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-clock text-info"></i> Quick Delivery
                        </h5>
                        <p class="card-text">Get your favorite food delivered in 30 minutes or less.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-percent text-success"></i> Special Offers
                        </h5>
                        <p class="card-text">Don't miss out on our exclusive deals and discounts!</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <h1 class="display-4">Welcome to AlliEats</h1>
        <p class="lead">Your favorite food, delivered fast!</p>
        <div class="mt-4">
            <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-lg">
                <i class="fas fa-sign-in-alt"></i> Sign In
            </a>
            <a href="@Url.Action("Register", "Account")" class="btn btn-outline-secondary btn-lg ml-2">
                <i class="fas fa-user-plus"></i> Register
            </a>
        </div>
        <p class="mt-3">Learn about <a href="https://docs.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    }
</div>

@section Scripts {
    <script>
        // Add any client-side functionality here if needed
    </script>
}