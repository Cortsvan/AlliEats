@{
    ViewData["Title"] = "Home Page";
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
}

<style>
    body {
        font-family: Georgia, serif;
        background-color: #FFF3E0; /* Secondary */
        color: #212121; /* Text */
    }

    .custom-card-bg {
        background-color: white;
        border: 1px solid rgba(93, 64, 55, 0.1);
        border-radius: 1rem;
        box-shadow: 0 4px 12px -2px rgba(93, 64, 55, 0.1), 0 2px 4px -2px rgba(93, 64, 55, 0.05);
    }

    .btn-primary, .btn-success, .btn-outline-primary, .btn-outline-info {
        border-radius: 0.5rem;
        font-weight: 500;
    }

    .btn-accent-maroon {
        background-color: #5D4037;
        border-color: #5D4037;
        color: white;
    }

        .btn-accent-maroon:hover {
            opacity: 0.9;
        }

    .text-deep-maroon {
        color: #5D4037 !important;
    }

    .text-accent-gold {
        color: #FFD54F !important;
    }

    .card-title i {
        margin-right: 0.5rem;
    }
</style>

<div class="container py-5">
    @if (!string.IsNullOrEmpty(userName))
    {
        <div class="alert custom-card-bg p-4 mb-5 shadow-sm d-flex align-items-center" style="gap: 2rem;">
            <div>
                <i class="fas fa-user-circle fa-3x text-deep-maroon"></i>
            </div>
            <div>
                @if (userRole == "Admin")
                {
                    <h4 class="mb-1 text-deep-maroon">Hello Admin</h4>
                    <p class="mb-0">Welcome to the AlliEats Admin Dashboard.</p>
                    <a href="@Url.Action("ViewItems", "AdminMenu")" class="btn btn-accent-maroon mt-3">
                        <i class="fas fa-cogs me-2"></i> Manage Menu Items
                    </a>
                }
                else
                {
                    <h4 class="mb-1 text-deep-maroon">Hello @userName</h4>
                    <p class="mb-0">Welcome back to AlliEats! Ready to order some delicious food?</p>
                    <div class="mt-3">
                        <a href="@Url.Action("Browse", "Menu")" class="btn btn-accent-maroon me-3">
                            <i class="fas fa-utensils me-2"></i> Browse Menu
                        </a>
                        <a href="@Url.Action("ViewCart", "Cart")" class="btn btn-outline-primary me-3">
                            <i class="fas fa-shopping-cart me-2"></i> My Cart
                        </a>
                        <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-info">
                            <i class="fas fa-history me-2"></i> My Orders & Tracking
                        </a>
                    </div>
                }
            </div>
        </div>


        <div class="row g-4">
            <div class="col-md-4">
                <div class="card custom-card-bg h-100 text-center p-3">
                    <h5 class="card-title text-deep-maroon"><i class="fas fa-star text-accent-gold"></i> Popular Items</h5>
                    <p class="card-text">Check out our most popular dishes that customers love!</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card custom-card-bg h-100 text-center p-3">
                    <h5 class="card-title text-deep-maroon"><i class="fas fa-clock text-info"></i> Quick Delivery</h5>
                    <p class="card-text">Get your favorite food delivered in 30 minutes or less.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card custom-card-bg h-100 text-center p-3">
                    <h5 class="card-title text-deep-maroon"><i class="fas fa-percent text-accent-gold"></i> Special Offers</h5>
                    <p class="card-text">Don't miss out on our exclusive deals and discounts!</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <h1 class="display-4 text-deep-maroon">Welcome to AlliEats</h1>
            <p class="lead">Your favorite food, delivered fast!</p>
            <div class="mt-4">
                <a href="@Url.Action("Login", "Account")" class="btn btn-accent-maroon me-3">
                    <i class="fas fa-sign-in-alt me-2"></i> Sign In
                </a>
                <a href="@Url.Action("Register", "Account")" class="btn btn-outline-primary">
                    <i class="fas fa-user-plus me-2"></i> Register
                </a>
            </div>
            <p class="mt-3 text-muted">Learn about <a href="https://docs.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
        </div>
    }
</div>


@section Scripts {
    <script>
        // Add any client-side functionality here if needed
    </script>
}