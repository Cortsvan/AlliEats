@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Home Page";
    var user = HttpContextAccessor.HttpContext.User;
    var isAuthenticated = user.Identity.IsAuthenticated;
    var isAdmin = user.IsInRole("Admin");
}

<div class="homepage-container">
    @if (isAuthenticated)
    {
        if (isAdmin)
        {
            <h1>Hello Admin</h1>
            <p>Welcome to the AlliEats Admin Dashboard.</p>
            <div class="mt-4">
                <a asp-controller="AdminMenu" asp-action="ViewItems" class="btn btn-primary">Manage Menu</a>
                <a asp-controller="AdminOrder" asp-action="ManageOrders" class="btn btn-primary">Manage Orders</a>
            </div>
        }
        else
        {
            <h1>Hello @user.Identity.Name</h1>
            <p>Welcome back! Ready to order some delicious food?</p>
            <div class="mt-4">
                <a asp-controller="Menu" asp-action="Browse" class="btn btn-primary">Browse Menu</a>
                <a asp-controller="Order" asp-action="MyOrders" class="btn btn-primary">My Orders & Tracking</a>
            </div>
        }
    }
    else
    {
        <h1>Welcome to AlliEats</h1>
        <p>Your favorite food, delivered fast!</p>
        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Sign In</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary" style="margin-left: 10px;">Register</a>
        </div>
    }
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/homepage.css" asp-append-version="true" />
}