@{
    ViewData["Title"] = "Home Page";
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
}

<style>
    body {
        font-family: Georgia, serif;
        background-color: #FFF3E0; /* Cream Beige */
        color: #212121; /* Dark Charcoal */
    }

    .welcome-card {
        background: #ffffff;
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 4px 12px -2px rgba(93, 64, 55, 0.15), 0 2px 4px -2px rgba(93, 64, 55, 0.08);
        border: 1px solid rgba(93, 64, 55, 0.15);
    }

    .admin-actions a {
        margin: 0 0.5rem; /* horizontal space */
    }

    .user-actions a {
        margin: 0 0.5rem; /* horizontal space */
    }

    .btn-main {
        background-color: #5D4037;
        border-color: #5D4037;
        color: white;
    }

        .btn-main:hover {
            opacity: 0.9;
        }

    .btn-outline-main {
        border-color: #5D4037;
        color: #5D4037;
    }

        .btn-outline-main:hover {
            background-color: rgba(93, 64, 55, 0.1);
        }

    .icon-accent {
        color: #FFD54F;
    }

    .feature-card {
        background: #fff;
        padding: 1.8rem;
        border-radius: 1rem;
        box-shadow: 0 6px 15px -3px rgba(93,64,55,0.12), 0 2px 4px -3px rgba(93,64,55,0.06);
        display: flex;
        flex-direction: column;
        justify-content: center; /* centers text vertically */
        height: 100%;
        text-align: center;
    }

</style>

<div class="container py-5 text-center">

    @if (!string.IsNullOrEmpty(userName))
    {
        @if (userRole == "Admin")
        {
            <div class="welcome-card mb-5">
                <h1 class="display-5 text-deep-maroon"><i class="fas fa-user-shield icon-accent me-2"></i> Hello Admin</h1>
                <p class="lead"> Welcome to the AlliEats Admin Dashboard</p>

                <div class="mt-4 d-flex justify-content-center flex-wrap admin-actions">
                    <a href="@Url.Action("ViewItems", "AdminMenu")" class="btn btn-main btn-lg">
                        <i class="fas fa-cogs me-2"></i> Manage Menu Items
                    </a>
                    <a href="@Url.Action("ManageOrders", "AdminOrder")" class="btn btn-outline-main btn-lg">
                        <i class="fas fa-clipboard-list me-2"></i> Manage Orders
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="welcome-card mb-5">
                <h1 class="display-5 text-deep-maroon"><i class="fas fa-user icon-accent me-2"></i>Hello @userName</h1>
                <p class="lead">Welcome back to AlliEats! Ready for something delicious?</p>

                <div class="mt-4 d-flex justify-content-center flex-wrap user-actions">
                    <a href="@Url.Action("Browse", "Menu")" class="btn btn-main btn-lg">
                        <i class="fas fa-utensils me-2"></i> Browse Menu
                    </a>
                    <a href="@Url.Action("ViewCart", "Cart")" class="btn btn-outline-main btn-lg">
                        <i class="fas fa-shopping-cart me-2"></i> My Cart
                    </a>
                    <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-main btn-lg">
                        <i class="fas fa-history me-2"></i> My Orders & Tracking
                    </a>
                </div>

            </div>
        }

        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <h5><i class="fas fa-star icon-accent me-2"></i> Popular Items</h5>
                    <p class="text-muted mb-0">Explore what customers love the most!</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <h5><i class="fas fa-clock text-deep-maroon me-2"></i> Quick Delivery</h5>
                    <p class="text-muted mb-0">Hot and tasty food delivered fast.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <h5><i class="fas fa-percent icon-accent me-2"></i> Special Offers</h5>
                    <p class="text-muted mb-0">Exclusive deals just for you.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="welcome-card">
            <h1 class="display-4 text-deep-maroon"><i class="fas fa-utensils icon-accent me-2"></i>Welcome to AlliEats</h1>
            <p class="lead">Your favorite dishes delivered fresh & fast.</p>

            <div class="mt-4 d-flex justify-content-center gap-3">
                <a href="@Url.Action("Login", "Account")" class="btn btn-main btn-lg">
                    <i class="fas fa-sign-in-alt me-2"></i> Sign In
                </a>
                <a href="@Url.Action("Register", "Account")" class="btn btn-outline-main btn-lg">
                    <i class="fas fa-user-plus me-2"></i> Register
                </a>
            </div>

            <p class="mt-3 text-muted">
                Learn about <a href="https://docs.microsoft.com/aspnet/core" class="text-deep-maroon fw-bold">building Web apps with ASP.NET Core</a>.
            </p>
        </div>
    }

</div>

@section Scripts {
    <script>
        // Add any client-side functionality here if needed
    </script>
}