@model ASI.Basecode.Services.ServiceModels.OrderViewModel

@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="confirmation-header text-center">
        <div class="success-icon mb-3">
            <i class="fas fa-check-circle"></i>
        </div>
        <h1 class="display-5 fw-bold">Order Placed Successfully!</h1>
        <p class="lead">Thank you for your order. We'll start preparing it right away!</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Order Details Card -->
            <div class="card shadow-sm order-details-card mb-4">
                <div class="card-body">
                    <h4 class="card-title text-center mb-4">
                        <i class="fas fa-receipt me-2"></i>Order Details
                        <span class="badge @Model.StatusBadgeClass ms-2">@Model.Status</span>
                    </h4>

                    <div class="order-info-grid">
                        <div class="order-info-item">
                            <span class="order-info-label">Order Number:</span>
                            <span class="order-info-value">@Model.OrderNumber</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">Order Date:</span>
                            <span class="order-info-value">@Model.CreatedTime.ToString("MMM dd, yyyy h:mm tt")</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">Payment Method:</span>
                            <span class="order-info-value">@Model.PaymentMethod</span>
                        </div>
                        <div class="order-info-item">
                            <span class="order-info-label">Total Amount:</span>
                            <span class="order-info-value text-success fw-bold">@("P" + Model.TotalAmount.ToString("F2"))</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="order-info-item full-width">
                                <span class="order-info-label">Notes:</span>
                                <span class="order-info-value">@Model.Notes</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Order Items -->
            <div class="card shadow-sm order-items-card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="fas fa-list me-2"></i>Order Items (@Model.TotalItems items)
                    </h5>

                    <div id="confirmation-items-list">
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="confirmation-item-card mb-3">
                                <div class="confirmation-item-details">
                                    <h6 class="mb-1">@item.MenuItemName</h6>
                                </div>
                                <div class="text-center px-3" style="min-width: 100px;">
                                    <span class="item-price">@("P" + item.Price.ToString("F2"))</span>
                                </div>
                                <div class="text-center px-3" style="min-width: 80px;">
                                    <span class="quantity-badge">x @item.Quantity</span>
                                </div>
                                <div class="text-center px-3" style="min-width: 120px;">
                                    <span class="item-total">@("P" + item.TotalPrice.ToString("F2"))</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Estimated Delivery Time -->
            <div class="alert alert-info delivery-alert mb-4">
                <div class="d-flex align-items-center">
                    <i class="fas fa-clock me-3 fa-2x"></i>
                    <div>
                        <h6 class="mb-1">Estimated Delivery Time</h6>
                        <p class="mb-0">Your order will be ready in approximately <strong>25-35 minutes</strong>.</p>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="text-center action-buttons">
                <a href="@Url.Action("Details", "Order", new { id = Model.Id })" class="btn btn-checkout btn-lg me-3">
                    <i class="fas fa-search me-2"></i>Track Order
                </a>
                <a href="@Url.Action("Browse", "Menu")" class="btn btn-outline-primary btn-lg me-3">
                    <i class="fas fa-utensils me-2"></i>Order More Food
                </a>
                <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-history me-2"></i>View All Orders
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/order-confirmation.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/order-confirmation.css" />
}