@model ASI.Basecode.Services.ServiceModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="checkout-header text-center">
        <h1 class="display-5 fw-bold"><i class="fas fa-credit-card me-3"></i>Checkout</h1>
        <p class="lead">Review your order and complete your purchase.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Order Items and Delivery Info -->
        <div class="col-lg-8" id="checkout-items-container">
            <!-- Delivery Information Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="card-title mb-0">
                            <i class="fas fa-truck me-2"></i>Delivery Information
                        </h4>
                        <a href="@Url.Action("Edit", "Profile")" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-edit me-2"></i>Edit
                        </a>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="delivery-info-item mb-2">
                                <i class="fas fa-user me-2 text-muted"></i>
                                <strong>Name:</strong> @Model.UserProfile.Name
                            </div>
                            <div class="delivery-info-item mb-2">
                                <i class="fas fa-phone me-2 text-muted"></i>
                                <strong>Phone:</strong> @Model.UserProfile.Phone
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="delivery-info-item mb-2">
                                <i class="fas fa-map-marker-alt me-2 text-muted"></i>
                                <strong>Address:</strong> @Model.UserProfile.Address
                            </div>
                            <div class="delivery-info-item mb-2">
                                <i class="fas fa-city me-2 text-muted"></i>
                                <strong>City:</strong> @Model.UserProfile.City
                                @if (!string.IsNullOrEmpty(Model.UserProfile.PostalCode))
                                {
                                    <span>, @Model.UserProfile.PostalCode</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.UserProfile.PreferredDeliveryAddress))
                    {
                        <div class="mt-3 pt-3 border-top">
                            <div class="delivery-info-item">
                                <i class="fas fa-home me-2 text-muted"></i>
                                <strong>Preferred Delivery Address:</strong> @Model.UserProfile.PreferredDeliveryAddress
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.UserProfile.DeliveryInstructions))
                    {
                        <div class="mt-2">
                            <div class="delivery-info-item">
                                <i class="fas fa-sticky-note me-2 text-muted"></i>
                                <strong>Delivery Instructions:</strong> @Model.UserProfile.DeliveryInstructions
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Items -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0" id="checkout-item-count">Order Summary (@Model.Cart.TotalItems items)</h4>
                <a href="@Url.Action("ViewCart", "Cart")" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Cart
                </a>
            </div>

            <div id="checkout-items-list">
                @foreach (var item in Model.Cart.CartItems)
                {
                    <div class="checkout-item-card mb-3" data-item-id="@item.Id">
                        <div class="checkout-item-image">
                            <img src="@(string.IsNullOrEmpty(item.MenuItemImagePath) ? "/images/placeholder-food.jpg" : item.MenuItemImagePath)"
                                 alt="@item.MenuItemName"
                                 onerror="this.src='/images/placeholder-food.jpg'; this.onerror=null;">
                        </div>
                        <div class="checkout-item-details">
                            <h5>@item.MenuItemName</h5>
                            <p class="text-muted small mb-1">
                                @(item.MenuItemDescription != null && item.MenuItemDescription.Length > 80 ? item.MenuItemDescription.Substring(0, 80) + "..." : item.MenuItemDescription)
                            </p>
                            <span class="badge badge-category">@item.MenuItemCategory</span>
                        </div>
                        <div class="text-center px-3" style="min-width: 100px;">
                            <span class="item-price">@("P" + item.Price.ToString("F2"))</span>
                        </div>
                        <div class="text-center px-3" style="min-width: 80px;">
                            <span class="quantity-badge">x @item.Quantity</span>
                        </div>
                        <div class="text-center px-3" style="min-width: 120px;">
                            <span class="item-total">@("P" + item.TotalPrice.ToString("F2"))</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Payment & Order Summary -->
        <div class="col-lg-4" id="checkout-summary-container">
            <form id="checkoutForm" method="post" action="@Url.Action("PlaceOrder", "Checkout")">
                @Html.AntiForgeryToken()

                <div class="card shadow-sm checkout-summary-card">
                    <div class="card-body">
                        <h4 class="card-title text-center mb-4">
                            <i class="fas fa-credit-card me-2"></i>Payment Details
                        </h4>

                        <div class="mb-3">
                            <label for="PaymentMethod" class="form-label">Payment Method <span class="text-danger">*</span></label>
                            <select asp-for="PaymentMethod" class="form-select" id="PaymentMethod" required>
                                <option value="">-- Select Payment Method --</option>
                                @foreach (var method in Model.PaymentMethods)
                                {
                                    if (method.ToLower() == "credit card" || method.ToLower() == "debit card" || method.ToLower() == "paymaya")
                                    {
                                        <option value="@method" disabled>@method</option>
                                    }
                                    else
                                    {
                                        <option value="@method">@method</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label for="Notes" class="form-label">Order Notes (Optional)</label>
                            <textarea asp-for="Notes" class="form-control" id="Notes" rows="3"
                                      placeholder="Special instructions, allergies, etc..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <hr>

                        <!-- Order Summary -->
                        <h5 class="mb-3"><i class="fas fa-receipt me-2"></i>Order Total</h5>
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var item in Model.Cart.CartItems)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        @item.MenuItemName
                                        <span class="text-muted small"> (x @item.Quantity)</span>
                                    </div>
                                    <span class="fw-bold">
                                        @("P" + item.TotalPrice.ToString("F2"))
                                    </span>
                                </li>
                            }
                            <li class="list-group-item d-flex justify-content-between align-items-center fw-bold h5">
                                Total
                                <span class="text-success" id="checkout-total">@("P" + Model.Cart.TotalAmount.ToString("F2"))</span>
                            </li>
                        </ul>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-checkout btn-lg" id="placeOrderBtn">
                                <i class="fas fa-shopping-bag me-2"></i>Place Order (@("P" + Model.Cart.TotalAmount.ToString("F2")))
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/checkout.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkout.css" />
}