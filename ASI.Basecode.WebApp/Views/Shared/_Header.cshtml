@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var user = HttpContextAccessor.HttpContext.User;
    var isAuthenticated = user.Identity.IsAuthenticated;
    var isAdmin = user.IsInRole("Admin");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isOnMenuPage = currentController?.Equals("Menu", StringComparison.OrdinalIgnoreCase) == true &&
                       currentAction?.Equals("Browse", StringComparison.OrdinalIgnoreCase) == true;
}

<header>
    <nav class="navbar navbar-expand-md navbar-toggleable-sm navbar-new">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <!-- You could add a logo image here -->
                AlliEats
            </a>

            <!-- Search Bar (Centered) -->
            @if (isAuthenticated && !isAdmin && isOnMenuPage)
            {
                <div class="navbar-search-container d-none d-md-flex">
                    <div class="search-wrapper">
                        <button type="button" class="search-btn" disabled>
                            <i class="fas fa-search"></i>
                        </button>
                        <input type="text"
                               id="headerSearchInput"
                               class="form-control search-input"
                               placeholder="Search menu..."
                               autocomplete="off">

                        <button type="button" id="headerClearSearch" class="clear-search-btn" style="display: none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <div id="searchSuggestions" class="search-suggestions" style="display: none;">
                        <div class="suggestions-header">
                            <span class="suggestions-title">Suggestions</span>
                        </div>
                        <div id="suggestionsContent" class="suggestions-content">
                            <!-- Dynamic content -->
                        </div>
                    </div>
                </div>
            }

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="fas fa-bars"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                @if (isAuthenticated)
                {
                    @if (isAdmin)
                    {
                        <!-- Admin Navbar -->
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Overview</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "AdminMenu" ? "active" : "")" asp-controller="AdminMenu" asp-action="ViewItems">Menu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "AdminOrder" ? "active" : "")" asp-controller="AdminOrder" asp-action="ManageOrders">Orders</a>
                            </li>
                            <li class="nav-item dropdown ms-2">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-user-shield"></i> Admin
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                                    <li><h6 class="dropdown-header">Management</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Review" asp-action="AllReviews"><i class="fas fa-star"></i> Reviews</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Account</h6></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="SignOutUser"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- User Navbar -->
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Menu" ? "active" : "")" asp-controller="Menu" asp-action="Browse">Menu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Review" && currentAction == "AllReviews" ? "active" : "")" asp-controller="Review" asp-action="AllReviews">Reviews</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Order" ? "active" : "")" asp-controller="Order" asp-action="MyOrders">Orders</a>
                            </li>
                            <li class="nav-item position-relative mx-2">
                                <a class="nav-link @(currentController == "Cart" ? "active" : "")" asp-controller="Cart" asp-action="ViewCart">
                                    <i class="fas fa-shopping-cart"></i>
                                    <span id="cartItemCount" class="cart-badge" style="display: none;">0</span>
                                </a>
                            </li>

                            <!-- User Dropdown with Sections -->
                            <li class="nav-item dropdown ms-1">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-user-circle"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><h6 class="dropdown-header">Activity</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Review" asp-action="MyReviews"><i class="fas fa-star"></i> My Reviews</a></li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li><h6 class="dropdown-header">Account</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="fas fa-id-card"></i> Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="fas fa-cog"></i> Settings</a></li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="SignOutUser"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                                </ul>
                            </li>
                        </ul>
                    }
                }

                <!-- Mobile Search Trigger -->
                @if (isAuthenticated && !isAdmin && isOnMenuPage)
                {
                    <div class="mobile-search d-md-none ms-3">
                        <button type="button" class="mobile-search-toggle" id="mobileSearchToggle">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Mobile Search Bar -->
        @if (isAuthenticated && !isAdmin && isOnMenuPage)
        {
            <div id="mobileSearchDropdown" class="mobile-search-dropdown d-md-none" style="display: none;">
                <div class="container-fluid py-3">
                    <div class="search-wrapper p-1">
                        <input type="text"
                               id="mobileHeaderSearchInput"
                               class="form-control search-input"
                               placeholder="Search menu items...">
                    </div>
                </div>
            </div>
        }
    </nav>
</header>